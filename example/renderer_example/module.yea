module renderer_example

import renderer u32 mesh_box() = 4294967295
import renderer u32 mesh_sphere(u32 segments) = 4294967295
import renderer u32 mesh_plane() = 4294967295
import renderer u32 mesh_cylinder(u32 segments) = 4294967295
import renderer u32 mesh_cone(u32 segments) = 4294967295
import renderer u32 mesh_torus(float thickness, u32 segments) = 4294967295
import renderer handle material_add(float3 albedo, float roughness, float metallic) = 4294967295
import renderer void material_emissive(handle m, float3 color, float luminance)
import renderer handle instance_add(u32 mesh, handle material) = 4294967295
import renderer void instance_place(handle i, float3 pos, float4 rotation, float3 scale)
import renderer void instance_shadow(handle i, bool cast)
import renderer void instance_remove(handle i)
import renderer handle light_add(u32 type) = 4294967295
import renderer void light_place(handle l, float3 pos, float3 dir)
import renderer void light_color(handle l, float3 color, float intensity)
import renderer void light_range(handle l, float range)
import renderer void light_size(handle l, float width, float height, float3 across)
import renderer bool light_image_begin(u32 width, u32 height) = false
import renderer void light_image_pixel(float3 rgb)
import renderer u32 light_image_end() = 4294967295
import renderer void light_image(handle l, u32 image)
import renderer void light_cone(handle l, float inner_deg, float outer_deg)
import renderer void light_shadow(handle l, bool cast)
import renderer void light_remove(handle l)
import renderer void camera(float3 eye, float3 target, float fov_deg)
import renderer void clear()
import renderer u32 scene_epoch() = 0
import renderer_models u64 api(u32 version) = 0
import renderer_probes handle probe_add(float3 pos, float3 box_min, float3 box_max) = 4294967295
import renderer_probes void probe_clear()
import renderer_probes u32 probe_count() = 0

export bool picture(bool on)

# The sample models' placements (renderer_models' handles), kept through reloads.
state Models
  u32 lantern
  u32 flightHelmet
  u32 waterBottle
  u32 boomBox
end
# Their sizes: Lantern's file is about 26 m tall (3.1 m here), BoomBox's 2 cm wide (0.8 m), the bottle 26 cm (1 m);
# the helmet is life size on its stand (0.72 m, 1 m here).
default lantern_scale 0.12
default flight_helmet_scale 1.4
default water_bottle_scale 4
default boom_box_scale 40

# Hold to look around.
action look MouseLeft

category Lights
# The moving lights: coloured points and sweeping spot lamps, spread over the types switched on (with both, every
# fifth a spot); the first shadowed_lights of them cast shadows.
setting int light_count 20 0 512
setting float light_speed 0.4 0 inf
setting int shadowed_lights 512 0 512
setting float point_intensity 6000 0 inf
setting float point_range 9 1 inf
setting float spot_intensity 40000 0 inf
# The area lights' surface brightness (cd/m2); the pendant disc's is three times it.
setting float area_luminance 6000 0 inf
category Light Types
# Off removes that type's lights (their cost too); the moving lights' count goes to the types left on.
setting bool sun true
setting bool points true
setting bool spots true
setting bool rects true
setting bool discs true
setting bool spheres true
setting bool tubes true
category Sun
# The sun's light above the atmosphere (lux in this scene's units); the physical sky dims and reddens it on the way down.
setting float sun_intensity 500 0 inf
setting color sun_color 1 0.97 0.94
setting float sun_elevation 22 -10 90
setting float sun_azimuth 35 0 360
category Camera
setting float fov 55 20 100
setting float look_sensitivity 1 0.1 inf
setting float move_speed 6 0.5 inf
# The camera held at its start view (field of view 55) and the lights and shapes held still, so GPU timings
# compare between versions.
setting bool benchmark_view false
# Where Benchmark View holds the camera: the start view (field of view 55), or a close-up of the gold or the
# mirror sphere (field of view 40), where reflections cover most of the screen.
setting choice benchmark_camera Start Start Gold_Closeup Mirror_Closeup
