module lighting_example

import lighting u32 mesh_box() = 4294967295
import lighting u32 mesh_sphere(u32 segments) = 4294967295
import lighting u32 mesh_plane() = 4294967295
import lighting u32 mesh_cylinder(u32 segments) = 4294967295
import lighting u32 mesh_cone(u32 segments) = 4294967295
import lighting u32 mesh_torus(float thickness, u32 segments) = 4294967295
import lighting handle material_add(float3 albedo, float roughness, float metallic) = 4294967295
import lighting void material_emissive(handle m, float3 color, float luminance)
import lighting handle instance_add(u32 mesh, handle material) = 4294967295
import lighting void instance_place(handle i, float3 pos, float4 rotation, float3 scale)
import lighting void instance_shadow(handle i, bool cast)
import lighting void instance_remove(handle i)
import lighting u32 instance_count() = 0
import lighting handle light_add(u32 type) = 4294967295
import lighting void light_place(handle l, float3 pos, float3 dir)
import lighting void light_color(handle l, float3 color, float intensity)
import lighting void light_range(handle l, float range)
import lighting void light_cone(handle l, float inner_deg, float outer_deg)
import lighting void light_shadow(handle l, bool cast)
import lighting void light_remove(handle l)
import lighting void camera(float3 eye, float3 target, float fov_deg)
import lighting void clear()
import lighting_probes handle probe_add(float3 pos, float3 box_min, float3 box_max) = 4294967295
import lighting_probes void probe_clear()

export bool picture(bool on)

# Hold to look around.
action look MouseLeft

category Lights
setting int light_count 64 0 512
setting float light_intensity 300 0 5000
setting float light_range 6 1 20
setting float light_speed 0.4 0 3
setting int shadowed_points 4 0 16
setting int spot_count 4 0 16
setting float spot_intensity 4000 0 40000
category Sun
setting float sun_intensity 4000 0 120000
setting color sun_color 1 0.82 0.65
setting float sun_elevation 22 2 90
setting float sun_azimuth 35 0 360
category Camera
setting float fov 55 20 100
setting float look_sensitivity 1 0.1 5
setting float move_speed 6 0.5 40
