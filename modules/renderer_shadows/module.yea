module renderer_shadows

# Called by renderer (the core) each frame with the address of its RenderFrame (frame.h).
export bool shadows_prepare(u64 frame)
export void shadows_render(u64 frame)
# Whether point and spot lights get shadow maps this frame (light shadows on, a budget above 0), as decided
# by the last shadows_prepare: the core marks shadow-casting lights for renderer_rt with it.
export bool light_shadows_on()
# The core's mesh versions (renderer's Mesh and MeshLod rows): casters draw the simplest within half a texel.
import table renderer Mesh
import table renderer MeshLod

category Sun Shadows
setting bool enabled true
setting int cascades 4 1 4
setting float shadow_distance 60 5 inf
player shadow_distance
setting float cascade_split 0.75 0 1
setting int sun_resolution 2048 512 4096
player sun_resolution
setting float softness 1.5 0 inf
setting int filter_taps 16 4 32
setting bool pcss false
player pcss
setting float sun_size 0.5 0.05 5
setting float normal_bias 0.5 0 inf
setting float slope_bias 2 0 inf
# Tilts each filter tap's depth test along the surface (sun and lights): fewer speckles and dark rings
# on sloped and curved surfaces, with soft shadows most.
setting bool receiver_plane true
setting bool show_cascades false
category Light Shadows
setting bool light_shadows true
player light_shadows
setting int shadowed_lights 64 0 64
# The largest the lights' shadow atlas may grow to: it starts at 4096 (or this, if smaller) and doubles once its
# lights want more detail than fits, on cards with 6 GB or more (8192 takes 256 MB).
setting int local_atlas_resolution 8192 1024 8192
setting int updates_per_frame 8 1 32
setting int max_tile_resolution 1024 128 2048
# Light shadows sharp where an object meets what it stands on, softer further away, as from a light
# with this radius (metres).
setting bool contact_hardening true
setting float light_size 0.06 0 inf
setting bool show_atlas false
