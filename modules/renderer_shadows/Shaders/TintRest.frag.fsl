// A view's last layer's rest (renderer_shadows.cpp renderTints): every glass surface past the one its layer pass kept,
// what it lets through multiplied into the scratch colour and one added to its count (the pipeline's blend). Its own file,
// not a define in Shaders.list: FSL reads one output signature for a file however it is included.
#include "TintShade.h.fsl"

ROOT_SIGNATURE(DefaultRootSignature)
float4 PS_MAIN(VSOutput In)
{
    INIT_MAIN;
    float  z = 1.0;
    float3 T = float3(1.0, 1.0, 1.0);
    if (!tintSurface(In, true, z, T))
        discard;
    RETURN(float4(T, 1.0));
}
