// Shadow casters: an instance-rate stream of (instance | view << 20), never SV_InstanceID. MASKED: alpha-tested casters,
// with uv0 for ShadowMasked.frag.
#include "ShadowCommon.h.fsl"

STRUCT(VSInput)
{
    DATA(float3, Position, POSITION);
    DATA(uint, Entry, TEXCOORD1);
#ifdef MASKED
    DATA(float2, Uv, TEXCOORD0);
    DATA(float4, Color, COLOR); // the vertex colour (its alpha is read)
#endif
};

STRUCT(VSOutput)
{
    DATA(float4, Position, SV_Position);
#ifdef MASKED
    DATA(float2, Uv, TEXCOORD0);
    DATA(FLAT(uint), Material, TEXCOORD1);
    DATA(float, Alpha, TEXCOORD2);
#endif
};

ROOT_SIGNATURE(DefaultRootSignature)
VSOutput VS_MAIN(VSInput In)
{
    INIT_MAIN;
    VSOutput Out;
    InstanceData inst = gInstances[In.Entry & 0xFFFFFu];
    ShadowView   v = gViews[In.Entry >> 20];
    float4 p = float4(In.Position, 1.0);
    float4 w = float4(dot(inst.row0, p), dot(inst.row1, p), dot(inst.row2, p), 1.0);
    Out.Position = float4(dot(v.row0, w), dot(v.row1, w), dot(v.row2, w), dot(v.row3, w));
#ifdef MASKED
    Out.Uv = In.Uv;
    Out.Material = inst.misc.x;
    Out.Alpha = In.Color.a;
#endif
    RETURN(Out);
}
