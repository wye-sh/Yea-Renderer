// The layer just drawn, from the scratch square into its square of the tint maps. A count pass (extra.x > 0, nothing
// written) keeps only the texels whose surface count (alpha) passes extra.x: an occlusion query counts them.
#include "TintCommon.h.fsl"

STRUCT(VSOutput)
{
    DATA(float4, Position, SV_Position);
    DATA(FLAT(uint), Pass, TEXCOORD0);
};

STRUCT(PSOutput)
{
    DATA(float, Depth, SV_Target0);
    DATA(float4, Color, SV_Target1);
};

ROOT_SIGNATURE(DefaultRootSignature)
PSOutput PS_MAIN(VSOutput In)
{
    INIT_MAIN;
    PSOutput Out;
    TintPass pass = gPasses[In.Pass];
    int2     p = int2(In.Position.xy) - int2(int(pass.info2.x & 0xFFFFu), int(pass.info2.x >> 16)) +
               int2(int(pass.info.w & 0xFFFFu), int(pass.info.w >> 16));
    Out.Depth = LoadTex2D(gScratchZ, NO_SAMPLER, p, 0).r;
    Out.Color = LoadTex2D(gScratchColor, NO_SAMPLER, p, 0);
    if (pass.extra.x > 0.0 && Out.Color.a <= pass.extra.x)
        discard;
    RETURN(Out);
}
