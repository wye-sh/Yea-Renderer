// The core's rows the shadow and glass tint passes read: instances, views, material maps.
#ifndef SHADOW_TYPES_H
#define SHADOW_TYPES_H
STRUCT(InstanceData)
{
    DATA(float4, row0, None);
    DATA(float4, row1, None);
    DATA(float4, row2, None);
    DATA(uint4, misc, None);
};

STRUCT(ShadowView)
{
    DATA(float4, row0, None);
    DATA(float4, row1, None);
    DATA(float4, row2, None);
    DATA(float4, row3, None);
    DATA(float4, rect, None);
    DATA(float4, info, None);
    DATA(float4, inv0, None);
    DATA(float4, inv1, None);
    DATA(float4, inv2, None);
};

// The core's MaterialMapData (renderer's Shaders/Common.h.fsl): base colour slot + 1 in maps.x, its factor's alpha in
// baseFactor.a, the cutoff in misc.x, misc.y 1 when the maps were given (vertex alpha counts).
STRUCT(MaterialMapData)
{
    DATA(uint4, maps, None);
    DATA(float4, baseFactor, None);
    DATA(float4, factors, None);
    DATA(float4, misc, None);
};
// The core's MaterialData (renderer's Shaders/Common.h.fsl): the glass tint pass's look.
STRUCT(MaterialData)
{
    DATA(float4, albedoRough, None);
    DATA(float4, params, None); // x metallic, y f0 (dielectric)
    DATA(float4, emissive, None);
};

// A glass tint pass (renderer_shadows.cpp TintPassCpu): one view's layer, drawn into the scratch maps then copied into the
// tint maps, or one of its counts. Square origins are texels, x | y << 16.
STRUCT(TintPass)
{
    DATA(float4, light, None); // xyz: the light rays' direction (w 0) or the light's position (w 1)
    DATA(uint4, info, None);   // x the shadow view, y flags, z the previous layer's square, w the view's scratch square
    DATA(uint4, info2, None);  // x this layer's square in the tint maps
    DATA(float4, extra, None); // x a count pass: only texels holding more surfaces than this pass
};
#define TINT_PEEL  1u // glass at or nearer than the previous layer is peeled away
#define TINT_LOCAL 2u // the view is a light's (its opaque depth in gLocalAtlas, else gSunAtlas)
#define TINT_REST  4u // the last layer's rest pass (TintRest.frag.fsl)

#define MAX_TEXTURES 1024
#endif
