// Alpha-tested casters: cut out where the base colour's alpha (times its factor, and the vertex alpha when the material's
// maps were given) is under the material's cutoff, as the camera's passes cut them.
#include "ShadowCommon.h.fsl"

STRUCT(VSOutput)
{
    DATA(float4, Position, SV_Position);
    DATA(float2, Uv, TEXCOORD0);
    DATA(FLAT(uint), Material, TEXCOORD1);
    DATA(float, Alpha, TEXCOORD2);
};

ROOT_SIGNATURE(DefaultRootSignature)
void PS_MAIN(VSOutput In)
{
    INIT_MAIN;
    MaterialMapData mm = gMaterialMaps[In.Material];
    float           a = mm.baseFactor.a * (mm.misc.y > 0.5 ? In.Alpha : 1.0);
    float2          dx = ddx(In.Uv);
    float2          dy = ddy(In.Uv);
    if (mm.maps.x != 0u)
    {
        float4 c = float4(1.0, 1.0, 1.0, 1.0);
        uint   texSlot = mm.maps.x - 1u;
        BeginNonUniformResourceIndex(texSlot, MAX_TEXTURES);
            c = SampleGradTex2D(gTextures[texSlot], gSamplerAnisotropic, In.Uv, dx, dy);
        EndNonUniformResourceIndex();
        a *= c.a;
    }
    clip(a - mm.misc.x);
    RETURN();
}
