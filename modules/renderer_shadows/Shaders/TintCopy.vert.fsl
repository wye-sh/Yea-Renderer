// The tint maps' copy and count passes: a triangle over the square (a vertex buffer of its own), and an instance-rate
// stream of (pass << 20).
#include "TintCommon.h.fsl"

STRUCT(VSInput)
{
    DATA(float2, Position, POSITION);
    DATA(uint, Entry, TEXCOORD1);
};

STRUCT(VSOutput)
{
    DATA(float4, Position, SV_Position);
    DATA(FLAT(uint), Pass, TEXCOORD0);
};

ROOT_SIGNATURE(DefaultRootSignature)
VSOutput VS_MAIN(VSInput In)
{
    INIT_MAIN;
    VSOutput Out;
    Out.Position = float4(In.Position, 0.5, 1.0);
    Out.Pass = (In.Entry >> 20) & 0x7FFu;
    RETURN(Out);
}
