// The reflections' own temporal accumulation, before the forward pass reads them: each pixel's history is
// found where the reflected image was last frame (reprojecting the reflection's virtual image, P plus the
// hit distance along the view ray, for smooth surfaces; the surface itself for rough ones), dropped where that
// surface wasn't there last frame (its depth), clipped to this frame's neighbourhood spread (mean +- 1.25
// deviations, YCoCg) and blended in a compressed space (c / (1 + max(c)), so a bright sample counts no more
// than a white one), with more history the rougher, noisier and stiller the surface. At half resolution the
// spread comes from the traced samples themselves (3 x 3 of them, 6 x 6 pixels): upsampled neighbours share
// samples, and their spread is too narrow to hold the history. TAA then anti-aliases the frame as before.
#include "RtData.h.fsl"
#include "Temporal.srt.h"

#define CLIP_WIDTH 1.25

float3 compressColor(float3 c) { return c / (1.0 + max(c.r, max(c.g, c.b))); }
float3 expandColor(float3 c) { return c / max(1.0 - max(c.r, max(c.g, c.b)), 1e-4); }
float3 toYCoCg(float3 c) { return float3(dot(c, float3(0.25, 0.5, 0.25)), dot(c, float3(0.5, 0.0, -0.5)), dot(c, float3(-0.25, 0.5, -0.25))); }
float3 fromYCoCg(float3 c) { return float3(c.x + c.y - c.z, c.x + c.z, c.x - c.y - c.z); }

float3 clipToBox(float3 h, float3 lo, float3 hi)
{
    float3 centre = 0.5 * (lo + hi);
    float3 extent = 0.5 * (hi - lo) + float3(1e-5, 1e-5, 1e-5);
    float3 v = h - centre;
    float3 a = abs(v / extent);
    float  m = max(a.x, max(a.y, a.z));
    return m > 1.0 ? centre + v / m : h;
}

float4 clipOf(float4 rows[4], float3 W)
{
    float4 w = float4(W, 1.0);
    return float4(dot(rows[0], w), dot(rows[1], w), dot(rows[2], w), dot(rows[3], w));
}

float2 uvOf(float4 c) { return c.xy / c.w * float2(0.5, -0.5) + 0.5; }
bool   inScreen(float2 uv) { return uv.x > 0.0 && uv.y > 0.0 && uv.x < 1.0 && uv.y < 1.0; }

ROOT_SIGNATURE(ComputeRootSignature)
NUM_THREADS(8, 8, 1)
void CS_MAIN(SV_DispatchThreadID(uint3) id)
{
    INIT_MAIN;
    int2 size = int2(gRt.screen.xy);
    int2 p = int2(id.xy);
    if (p.x >= size.x || p.y >= size.y)
        RETURN();
    float4 cur = LoadTex2D(gCurrent, NO_SAMPLER, p, 0);
    float  d = LoadTex2D(gDepth, NO_SAMPLER, p, 0).r;
    if (cur.a <= 0.0 || d <= 0.0)
    {
        Write2D(gOut, p, float4(0.0, 0.0, 0.0, 0.0));
        Write2D(gOutZ, p, 0.0);
        RETURN();
    }
    float  exposure = max(gExposure[1], 1e-8);
    float4 surface = LoadTex2D(gSurface, NO_SAMPLER, p, 0);
    float  rough = surface.x;

    // The neighbourhood's spread (traced pixels only), and its brightest neighbour.
    float3 c = toYCoCg(compressColor(cur.rgb * exposure));
    float3 m1 = c;
    float3 m2 = c * c;
    float  n = 1.0;
    float  brightest = 0.0;
    bool   fromHalf = gRt.temporal.w > 0.5 && rough >= gRt.params.z;
    int2   halfSize = (size + int2(1, 1)) / 2;
    int2   centre = fromHalf ? clamp(p >> 1, int2(0, 0), halfSize - int2(1, 1)) : p;
    int2   last = fromHalf ? halfSize - int2(1, 1) : size - int2(1, 1);
    for (int y = -1; y <= 1; ++y)
    {
        for (int x = -1; x <= 1; ++x)
        {
            if (x == 0 && y == 0 && !fromHalf)
                continue;
            int2   q = clamp(centre + int2(x, y), int2(0, 0), last);
            float4 v = fromHalf ? LoadTex2D(gHalfIn, NO_SAMPLER, q, 0) : LoadTex2D(gCurrent, NO_SAMPLER, q, 0);
            if (v.a <= 0.0)
                continue;
            float3 s = toYCoCg(compressColor(v.rgb * exposure));
            m1 += s;
            m2 += s * s;
            n += 1.0;
            brightest = max(brightest, s.x);
        }
    }
    // A jittered sample brighter than all its neighbours is a stray: held to the brightest of them.
    if (rough > 0.1 && n > 4.0 && c.x > brightest)
        c *= brightest / max(c.x, 1e-6);
    float3 mean = m1 / n;
    float3 width = sqrt(max(m2 / n - mean * mean, float3(0.0, 0.0, 0.0))) * CLIP_WIDTH;

    // This pixel's world position (undoing the jitter it was drawn with), and where it and its reflection were.
    float  z = gRt.forward.w / d;
    float2 u = float2(p) + 0.5 - gRt.screen.zw;
    float2 ndc = float2(u.x / gRt.screen.x * 2.0 - 1.0, 1.0 - u.y / gRt.screen.y * 2.0);
    float3 P = gRt.camPos.xyz + gRt.right.xyz * (ndc.x * z / gRt.right.w) + gRt.up.xyz * (ndc.y * z / gRt.up.w) + gRt.forward.xyz * z;
    float3 toP = normalize(P - gRt.camPos.xyz);
    float4 pcS = clipOf(gRt.prevViewProj, P);
    float4 pcV = clipOf(gRt.prevViewProj, P + toP * min(cur.a, 1000.0));
    float  mirrorish = saturate(1.0 - rough / max(gRt.camPos.w * 0.5, 1e-3));
    float2 uvS = uvOf(pcS);
    float2 uvPrev = pcV.w > gRt.forward.w ? lerp(uvS, uvOf(pcV), mirrorish) : uvS;

    // More history the rougher (noisier) the surface; little on mirrors, which are exact, and on what moves.
    float frames = 1.0 + (gRt.temporal.x - 1.0) * saturate(rough * 8.0);
    float2 uvNow = (float2(p) + 0.5) / gRt.screen.xy;
    float2 moved = (LoadTex2D(gMotion, NO_SAMPLER, p, 0).xy - (uvNow - uvS)) * gRt.screen.xy;
    if (dot(moved, moved) > 0.25)
        frames = min(frames, 4.0);

    float3 result = c;
    bool   valid = gRt.temporal.y > 0.5 && pcS.w > gRt.forward.w && inScreen(uvS) && inScreen(uvPrev);
    if (valid)
    {
        // Was this surface there last frame? Its depth then against the depth stored there.
        int2  qs = clamp(int2(uvS * gRt.screen.xy), int2(0, 0), size - int2(1, 1));
        float zPrev = LoadTex2D(gHistoryZ, NO_SAMPLER, qs, 0).r;
        valid = abs(zPrev - pcS.w) < 0.04 * pcS.w + 0.02;
    }
    if (valid && frames > 1.0)
    {
        // Bilinear, over the history texels that hold reflections only.
        float2 pos = uvPrev * gRt.screen.xy - 0.5;
        int2   base = int2(floor(pos));
        float2 f = pos - float2(base);
        float4 sum = float4(0.0, 0.0, 0.0, 0.0);
        for (uint i = 0u; i < 4u; ++i)
        {
            int2   dq = int2(int(i & 1u), int(i >> 1u));
            int2   q = clamp(base + dq, int2(0, 0), size - int2(1, 1));
            float4 h = LoadTex2D(gHistory, NO_SAMPLER, q, 0);
            float  w = (dq.x == 1 ? f.x : 1.0 - f.x) * (dq.y == 1 ? f.y : 1.0 - f.y);
            if (h.a > 0.0)
                sum += float4(compressColor(h.rgb * exposure), 1.0) * w;
        }
        if (sum.w > 0.05)
        {
            float3 history = clipToBox(toYCoCg(sum.rgb / sum.w), mean - width, mean + width);
            result = lerp(history, c, 1.0 / frames);
        }
    }
    Write2D(gOut, p, float4(max(expandColor(fromYCoCg(result)), float3(0.0, 0.0, 0.0)) / exposure, cur.a));
    Write2D(gOutZ, p, z);
    RETURN();
}
