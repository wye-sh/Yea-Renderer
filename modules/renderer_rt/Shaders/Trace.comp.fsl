// Ray-traced reflections: per pixel below the roughness limit, the reflected ray (one microfacet normal per
// pixel and frame from the GGX distribution of visible normals, Dupuy & Benyoub 2023, driven by a
// low-discrepancy sequence; Temporal.comp.fsl averages them into the lobe) traced with an inline ray query
// against the scene's acceleration structure. What it hits gets its colour from last frame's anti-aliased
// image where the hit is visible on screen (fully lit, with every shadow), verified against the depth there,
// so a hidden or off-screen hit is never mistaken for what stands in front of it; elsewhere it is lit at the
// hit: the sun (with a shadow ray), local lights, the sky's light, emission. A miss sees the sky.
#include "fsl_ext.h"

#include "RtData.h.fsl"

STRUCT(InstanceData)
{
    DATA(float4, row0, None);
    DATA(float4, row1, None);
    DATA(float4, row2, None);
    DATA(uint4, misc, None); // x material
};

STRUCT(MaterialData)
{
    DATA(float4, albedoRough, None);
    DATA(float4, params, None);  // x metallic, y f0 (dielectric), z reflections on
    DATA(float4, emissive, None);
};

STRUCT(MaterialMapData) // the core's (renderer's Shaders/Common.h.fsl): base colour slot + 1 in maps.x, its factor's
{                       // alpha in baseFactor.a, misc.x the alpha cutoff, misc.y 1 when the maps were given
    DATA(uint4, maps, None);
    DATA(float4, baseFactor, None);
    DATA(float4, factors, None);
    DATA(float4, misc, None);
};
#define MAX_TEXTURES 1024

STRUCT(LightData)
{
    DATA(float4, pos, None);     // xyz, w range
    DATA(float4, color, None);   // rgb candela, w type (1 point, 2 spot)
    DATA(float4, dir, None);     // xyz spot direction, w spot scale
    DATA(float4, params, None);  // x spot offset, y first shadow view (-1: no map), z 1/range^2, w 1: casts shadows in
                                 // the scene (it may still have no map: outside the view or over the budget)
    DATA(float4, sphere, None);
};

STRUCT(ShadowView)
{
    DATA(float4, row0, None);
    DATA(float4, row1, None);
    DATA(float4, row2, None);
    DATA(float4, row3, None);
    DATA(float4, rect, None); // tile: u, v, width, height
    DATA(float4, info, None); // x texel world size at distance 1, yzw where a point light's cube was drawn
    DATA(float4, inv0, None);
    DATA(float4, inv1, None);
    DATA(float4, inv2, None);
};

#include "Decal.h.fsl" // a copy of the core's: DecalData here, decalsAt below
#include "Trace.srt.h"
#include "Shadow.h.fsl"
#include "Cutout.h.fsl"
#include "Hit.h.fsl"
#define GI_IRRADIANCE gGiIrradiance
#define GI_DISTANCE   gGiDistance
#define GI_PROBES     gGiProbes
#define GI_SAMPLER    gSamplerBilinearClamp
#include "GiSample.h.fsl"

#define PI 3.14159265
#define RT_MISS 60000.0
#define RT_FAR 1000.0 // the hit distance the history keeps for the sky (it averages them)
#define FLAG_SCREEN 1u
#define FLAG_DEBUG 4u
#define FLAG_MAPS 8u // the frame has material maps (gMaterialMaps, gTextures bound): hits read them
#define FLAG_GLASS 16u // see-through instances are in the top-level structure (Hit.h.fsl): rays look for their layers
#define FLAG_REFRACT 32u // glass refracts (frame refractOn): reflection rays bend through material_refraction's layers
#define GLASS_LAYERS 4u // glass layers a reflection ray shades and bends through, front to back; past them it goes on
                        // straight, multiplied by the T of every layer it passes (raster's every layer multiplies)
// Instance masks (renderer_rt.cpp): 1 seen in reflections, 2 casts shadows (glass too), 4 opaque and casts (what GI
// probe rays hit), 8 glass (every see-through instance: what GI probe rays pass through, tinted).
#define MASK_REFLECTED 1u
#define MASK_CASTS 2u
#define MASK_GI 4u
#define MASK_GI_GLASS 8u
// How a hit's local lights are shadowed (shadowMode.y). The sun always takes a ray.
#define SHADOWS_SCENE 0u // as the scene: from the light's shadow map where it has one, else a ray
#define SHADOWS_RAYS 1u  // a ray for every light (the scene's ray-traced mode, or the comparison knob)
#define SHADOWS_OFF 2u   // none
#define MAX_HIT_LIGHTS 64u
#define MAX_SHADOW_RAYS 8u
// Triangles only: no procedural primitives to test for. Opacity comes from the instances (Cutout.h.fsl).
// A GI probe ray's hit: rays for at most this many lights that cast in the scene but have no map (outside the view, or
// over the budget; unshadowed they would leak light through walls into the probes), the sun's ray aside.
#define GI_SHADOW_RAYS 2u
// Every instance is opaque triangles: no procedural primitives to test for (only Direct3D 12 has the flag).
#if defined(RAY_FLAG_SKIP_AABB)
#define RT_RAY_FLAGS RAY_FLAG_SKIP_AABB
#else
#define RT_RAY_FLAGS RAY_FLAG_NONE
#endif

float noise2(float2 p) { return frac(52.9829189 * frac(dot(p, float2(0.06711056, 0.00583715)))); }

// Pixel p's n-th sample: a hash of its position (so neighbours' samples are unrelated: interleaved gradient noise
// lined them up, and what the history hadn't averaged out showed as diagonal streaks) plus the R2 sequence's n-th
// point, n counting the frames the pixel is traced (so its samples, consecutive points, cover the lobe evenly and
// never repeat). Every fourth point of R2 steps by only 0.02 in x: a half-resolution pixel, traced every fourth
// frame, once took those and saw a third of its lobe, repeating every 64 frames, and its history settled into a
// fixed grain.
uint pcgHash(uint v)
{
    uint s = v * 747796405u + 2891336453u;
    uint w = ((s >> ((s >> 28u) + 4u)) ^ s) * 277803737u;
    return (w >> 22u) ^ w;
}

// R2's n-th point, exact for any n: the fractions in 32-bit fixed point, where the products' wrap is the fraction.
float2 r2(uint n)
{
    uint2 f = uint2(n * 3242174889u, n * 2447445414u);
    return float2(f >> uint2(8u, 8u)) * (1.0 / 16777216.0);
}

float2 sample2(int2 p, uint n)
{
    uint   h = pcgHash(uint(p.x) + pcgHash(uint(p.y)));
    float2 offset = float2(float(h & 0xFFFFu), float(h >> 16u)) * (1.0 / 65536.0);
    return frac(offset + r2(n));
}

// A GGX visible normal (tangent space, z the normal) for view direction v and roughness alpha: spherical caps.
float3 sampleVndf(float3 v, float alpha, float2 u)
{
    float3 vh = normalize(float3(alpha * v.x, alpha * v.y, v.z));
    float  phi = 2.0 * PI * u.x;
    float  z = (1.0 - u.y) * (1.0 + vh.z) - vh.z;
    float  s = sqrt(saturate(1.0 - z * z));
    float3 h = float3(s * cos(phi), s * sin(phi), z) + vh;
    return normalize(float3(alpha * h.x, alpha * h.y, max(h.z, 1e-6)));
}

float luminance(float3 c) { return dot(c, float3(0.2126, 0.7152, 0.0722)); }

// Caps a sample's brightness: a ray now and then finding a light or a bright spot would otherwise flash.
float3 clampSample(float3 c)
{
    float l = luminance(c) * gExposure[1];
    return l > gRt.temporal.z ? c * (gRt.temporal.z / l) : c;
}

// renderer_sky's reflection image (octahedral, y up) at a roughness: its GGX-prefiltered mips.
float3 skyImage(float3 d, float rough)
{
    float2 p = d.xz / (abs(d.x) + abs(d.y) + abs(d.z));
    if (d.y < 0.0)
        p = (float2(1.0, 1.0) - abs(p.yx)) * float2(p.x >= 0.0 ? 1.0 : -1.0, p.y >= 0.0 ? 1.0 : -1.0);
    return SampleLvlTex2D(gSkyEnv, gSkySampler, p * 0.5 + 0.5, rough * (gRt.sky.y - 1.0)).rgb;
}

float3 skyRadiance(float3 d)
{
    if (gRt.sky.x > 0.5)
        return skyImage(d, 0.0);
    if (d.y >= 0.0)
        return lerp(gRt.skyHorizon.rgb, gRt.skyZenith.rgb, sqrt(saturate(d.y)));
    return lerp(gRt.skyHorizon.rgb, gRt.skyGround.rgb, saturate(-d.y * 3.0));
}

float3 skyIrradiance(float3 N)
{
    if (gRt.sky.x > 0.5)
    {
        // renderer_sky's cosine-convolved SH (its basis and order, as the core's skyIrradiance).
        float3 c = gSkySh[0].rgb * 0.282095 + (gSkySh[1].rgb * N.y + gSkySh[2].rgb * N.z + gSkySh[3].rgb * N.x) * 0.488603 +
                   (gSkySh[4].rgb * (N.x * N.y) + gSkySh[5].rgb * (N.y * N.z) + gSkySh[7].rgb * (N.x * N.z)) * 1.092548 +
                   gSkySh[6].rgb * (0.315392 * (3.0 * N.z * N.z - 1.0)) + gSkySh[8].rgb * (0.546274 * (N.x * N.x - N.y * N.y));
        return max(c, float3(0.0, 0.0, 0.0));
    }
    float3 up = lerp(gRt.skyHorizon.rgb, gRt.skyZenith.rgb, 0.6);
    float3 down = lerp(gRt.skyHorizon.rgb, gRt.skyGround.rgb, 0.85);
    return lerp(down, up, N.y * 0.5 + 0.5);
}


// GGX with height-correlated Smith visibility and Schlick's Fresnel, as the core's forward pass.
float3 brdfLight(float3 N, float3 V, float3 L, float3 diffuse, float3 f0, float a2, float3 E)
{
    float NoL = saturate(dot(N, L));
    if (NoL <= 0.0)
        return float3(0.0, 0.0, 0.0);
    float3 H = normalize(V + L);
    float  NoH = saturate(dot(N, H));
    float  NoV = max(dot(N, V), 1e-3);
    float  VoH = saturate(dot(V, H));
    float  d = (NoH * a2 - NoH) * NoH + 1.0;
    float  D = a2 / (PI * d * d);
    float  gv = NoL * sqrt(NoV * NoV * (1.0 - a2) + a2);
    float  gl = NoV * sqrt(NoL * NoL * (1.0 - a2) + a2);
    float  Vis = 0.5 / max(gv + gl, 1e-5);
    float3 F = f0 + (float3(1.0, 1.0, 1.0) - f0) * pow(1.0 - VoH, 5.0);
    return (diffuse * (1.0 / PI) + D * Vis * F) * E * NoL;
}

// What reaches P from a light along L, up to tMax (one any-hit ray): 0 where something opaque is in the way, else the
// product of the glass layers it passes (white without), for reflections' and GI probe rays' hits alike, as direct
// light arrives on screen.
float3 lightVisible(float3 P, float3 L, float tMax)
{
    if (gRt.shadowMode.y == SHADOWS_OFF)
        return float3(1.0, 1.0, 1.0);
    RayDesc shadowRay;
    shadowRay.Origin = P;
    shadowRay.Direction = L;
    shadowRay.TMin = 0.0;
    shadowRay.TMax = tMax;
    float3 through = float3(1.0, 1.0, 1.0);
    RayQueryAnyHit(gScene, RAY_TRAVERSAL_FLAG_DEFAULT, RT_RAY_FLAGS, shadowRay, MASK_CASTS, occluded) // casters only
    RayQueryBeginForEachCandidate(occluded)
    {
        uint   ci = RayQueryCandidateInstanceID(occluded);
        uint   cp = RayQueryCandidatePrimitiveIndex(occluded);
        float2 cb = RayQueryCandidateBarycentrics(occluded);
        if (isGlass(ci))
            through *= cutAway(ci, cp, cb) ? float3(1.0, 1.0, 1.0) : glassThrough(ci, cp, cb, L);
        else if (!cutAway(ci, cp, cb))
            RayQueryCommitCandidate(occluded);
        RayQueryProceed(occluded);
    }
    RayQueryEndForEachCandidate(occluded)
    return RayQueryIsHit(occluded) ? float3(0.0, 0.0, 0.0) : through;
}

// The hit lit where it is: emission, the sun (shadowed by a ray), local lights (those in view nearest first, then
// the rest; shadowed by their maps or rays, shadowMode.y, at most maxRays rays) and the light around: the sky's, or
// where renderer_gi's probes hold it, their bounced light (diffuse). rot turns the maps' filter. probe: a GI probe
// ray's hit, which takes no specular from the surroundings (diffuse probes; the sky's would leak indoors).
// coverage: a glass layer's (its diffuse light and glow scale by it, as the core's see-through pass), else 1.
float3 shadeHit(float3 P, float3 N, float3 V, MaterialData m, float occlusion, float2 rot, uint maxRays, bool probe, float coverage)
{
    float  metallic = saturate(m.params.x);
    float3 albedo = m.albedoRough.rgb;
    float3 diffuse = albedo * (1.0 - metallic) * coverage;
    float3 f0 = lerp(float3(m.params.y, m.params.y, m.params.y), albedo, metallic);
    float  rough = clamp(m.albedoRough.a, 0.03, 1.0);
    float  a2 = rough * rough;
    a2 *= a2;
    float3 color = m.emissive.rgb * coverage;
    float3 offset = P + N * 0.01;
    if (gRt.sunDir.w > 0.5)
    {
        float3 L = gRt.sunDir.xyz;
        if (dot(N, L) > 0.0)
            color += brdfLight(N, V, L, diffuse, f0, a2, gRt.sunColor.rgb * lightVisible(offset, L, 1000.0));
    }
    uint  lights = min(gRt.counts.x, MAX_HIT_LIGHTS);
    uint  rays = 0u;
    float exposure = gExposure[1];
    for (uint i = 0u; i < lights; ++i)
    {
        LightData l = gLights[i];
        float3 toLight = l.pos.xyz - P;
        float  d2 = dot(toLight, toLight);
        if (d2 >= l.pos.w * l.pos.w)
            continue;
        float  invDist = rsqrt(max(d2, 1e-8));
        float3 L = toLight * invDist;
        float  f = d2 * l.params.z;
        float  window = saturate(1.0 - f * f);
        float  atten = window * window / max(d2, 1e-4);
        if (l.color.w > 1.5)
        {
            float cone = saturate(dot(-L, l.dir.xyz) * l.dir.w + l.params.x);
            atten *= cone * cone;
        }
        float NoL = dot(N, L);
        if (atten <= 0.0 || NoL <= 0.0)
            continue;
        float3 lit = brdfLight(N, V, L, diffuse, f0, a2, l.color.rgb * atten);
        // A shadow only where the light could be seen (as the forward pass skips its shadow lookups). As the
        // scene: the light's map where it has one; a ray where it casts in the scene but has no map (outside the
        // view or over the budget: unshadowed it would be wrong); none where it doesn't cast. Rays: one for
        // every light. At most MAX_SHADOW_RAYS rays per hit.
        if (gRt.shadowMode.y != SHADOWS_OFF && max(lit.r, max(lit.g, lit.b)) * exposure >= 1.0 / 4096.0)
        {
            bool rayAll = gRt.shadowMode.y == SHADOWS_RAYS;
            if (!rayAll && l.params.y >= 0.0 && gRt.shadowMode.w != 0u)
                lit *= localShadow(l, P, N, d2 * invDist, NoL, rot);
            else if ((rayAll || l.params.w > 0.5) && rays < maxRays)
            {
                lit *= lightVisible(offset, L, max(d2 * invDist - 0.05, 0.0));
                rays += 1u;
            }
        }
        color += lit;
    }
    float  ambient = gRt.sunColor.w;
    float3 R = reflect(-V, N);
    float3 skySeen = probe ? float3(0.0, 0.0, 0.0) : (gRt.sky.x > 0.5 ? skyImage(R, rough) : lerp(skyRadiance(R), skyIrradiance(R), rough));
    if (occlusion < 1.0)
    {
        // The occlusion map, as the forward pass takes it without renderer_ao: Jimenez 2016's multi-bounce fit on the
        // diffuse ambient, Lagarde 2014's specular occlusion on the reflected sky.
        float3 ao = float3(occlusion, occlusion, occlusion);
        ao = max(ao, ((ao * (2.0404 * albedo - 0.3324) + (-4.7951 * albedo + 0.6417)) * ao + (2.7552 * albedo + 0.6903)) * ao);
        diffuse *= ao;
        float NoV = max(dot(N, V), 1e-3);
        skySeen *= saturate(pow(max(NoV + occlusion, 1e-4), exp2(-16.0 * rough - 1.0)) - 1.0 + occlusion);
    }
    if (gRt.giCounts.w == 0u)
        color += (diffuse * skyIrradiance(N) + f0 * skySeen) * ambient;
    else
    {
        // The probes already hold the sky's light (scaled by ambient where their rays missed): no ambient scale.
        float  inside;
        float3 bounce = giIrradiance(P, N, -V, gRt.giGrid[0], gRt.giGrid[1], gRt.giGrid[2], gRt.giGrid[3], inside);
        color += diffuse * lerp(skyIrradiance(N) * ambient, bounce, inside) + f0 * skySeen * ambient;
    }
    return color;
}

float4 clipOf(float4 rows[4], float3 W)
{
    float4 w = float4(W, 1.0);
    return float4(dot(rows[0], w), dot(rows[1], w), dot(rows[2], w), dot(rows[3], w));
}

// A hit that still has to be lit where it is (what the screen doesn't show): its position and distance, normal
// (towards the ray), the ray's direction and how much of it the screen shows, that screen colour, its material.
float ggxD(float NoH, float a2)
{
    float d = (NoH * a2 - NoH) * NoH + 1.0;
    return a2 / (PI * d * d);
}

float smithG1(float NoV, float a2) { return 2.0 * NoV / (NoV + sqrt(a2 + (1.0 - a2) * NoV * NoV)); }

// renderer_fog's height fog along a reflected ray (the core's applyHeightFog in Lighting.h.fsl: exact optical depth, the
// sun unshadowed and the sky's mean light scattered in), over length t from O along unit d.
float fogHeightIntegral(float h, float rho, float k)
{
    if (h <= 0.0 || k < 1e-5)
        return rho * h;
    return rho * (1.0 - exp(-k * h)) / k;
}

float3 applyHeightFog(float3 color, float3 O, float3 d, float t)
{
    float4 m = gRt.fogMedium;
    if (m.x <= 0.0)
        return color;
    float  h0 = O.y - m.z;
    float  depth;
    if (abs(d.y) < 1e-4)
        depth = m.x * exp(-m.y * max(h0, 0.0)) * t;
    else
        depth = (fogHeightIntegral(h0 + d.y * t, m.x, m.y) - fogHeightIntegral(h0, m.x, m.y)) / d.y;
    float  T = exp(-max(depth, 0.0));
    float3 sky = gRt.sky.x > 0.5 ? max(gSkySh[0].rgb, float3(0.0, 0.0, 0.0)) * 0.282095
                                 : (gRt.skyHorizon.rgb * 0.5 + gRt.skyZenith.rgb * (2.0 / 3.0) + gRt.skyGround.rgb * (5.0 / 6.0)) * 0.5;
    float3 L = sky * gRt.sunColor.w;
    if (gRt.sunDir.w > 0.0)
    {
        float g = m.w, c = dot(d, gRt.sunDir.xyz);
        float q = max(1.0 + g * g - 2.0 * g * c, 1e-4);
        L += gRt.sunColor.rgb * ((1.0 - g * g) / (4.0 * PI * q * sqrt(q)));
    }
    return color * T + gRt.fogAlbedo.rgb * L * (1.0 - T);
}

float3 vertexPosition(uint v) { return asfloat(uint3(gPositions[v * 3u], gPositions[v * 3u + 1u], gPositions[v * 3u + 2u])); }

// A decal's map (slot: gTextures' index + 1) with its uv's change across the footprint, as the forward pass samples it.
float4 decalMap(uint slot, float2 uv, float2 dx, float2 dy)
{
    float4 c = float4(1.0, 1.0, 1.0, 1.0);
    if ((gRt.counts.z & FLAG_MAPS) == 0u)
        return c;
    uint texSlot = slot - 1u;
    BeginNonUniformResourceIndex(texSlot, MAX_TEXTURES);
        c = SampleGradTex2D(gTextures[texSlot], gSamplerTrilinearWrap, uv, dx, dy);
    EndNonUniformResourceIndex();
    return c;
}

#define DECAL_DATA(k)                  gDecals[k]
#define DECAL_SAMPLE(slot, uv, dx, dy) decalMap(slot, uv, dx, dy)
#define DECAL_CELLS                    gDecalCells
#define DECAL_ITEMS                    gDecalItems
#include "Decal.h.fsl"

// The decals over a hit (never glass: raster paints none on see-through surfaces), painted into its material and
// shading normal N as the forward pass and the captures paint them (Decal.h.fsl decalsAt). P the hit, Ng its normal
// before the normal map (turned towards the ray R), width the ray cone's there: the footprint spans it across the ray
// and stretches along it by the angle, as a pixel's does on screen.
MaterialData hitDecals(float3 P, float3 Ng, float3 R, float width, MaterialData m, inout(float3) N)
{
    if (gRt.decals.x == 0u)
        return m;
    float3 along = R - Ng * dot(R, Ng);
    float  l = length(along);
    along = l > 1e-4 ? along / l : normalize(cross(Ng, abs(Ng.y) < 0.9 ? float3(0.0, 1.0, 0.0) : float3(1.0, 0.0, 0.0)));
    float3 dPdx = along * (width / max(abs(dot(Ng, R)), 0.05));
    float3 dPdy = cross(Ng, along) * width;
    float3 albedo = m.albedoRough.rgb, emissive = m.emissive.rgb;
    float  rough = m.albedoRough.a, metal = m.params.x;
    decalsAt(gRt.decals.x, gRt.decalGrid[0], gRt.decalGrid[1], P, Ng, dPdx, dPdy, albedo, rough, metal, emissive, N);
    m.albedoRough = float4(albedo, rough);
    m.params.x = metal;
    m.emissive.rgb = emissive;
    return m;
}

// The material a hit shows (top-level instance index, triangle, barycentrics): its flat values, or with the core's
// texture maps (Hit.h.fsl hitLook) where it has them. The maps' mip comes from the ray cone (Akenine-Moller et al.
// 2021): `width` the cone's width at the hit (m), R the ray's direction; the triangle's uv and world areas turn it into
// texels. N: the hit's normal (turned towards the ray), replaced by the normal map's; occlusion: the occlusion map's (1:
// none); alpha: the base colour's alpha with the maps (1 without: see-through coverage is then material_blend's alone).
MaterialData hitMaterialAlpha(uint index, uint prim, float2 bary, float width, float3 R, inout(float3) N, out(float) occlusion,
                              out(float) alpha)
{
    uint4        inst = gRtInstances[index];
    InstanceData row = gInstances[inst.x];
    MaterialData m = gMaterials[row.misc.x];
    occlusion = 1.0;
    alpha = 1.0;
    if ((gRt.counts.z & FLAG_MAPS) == 0u)
        return m;
    MaterialMapData mm = gMaterialMaps[row.misc.x];
    if (mm.misc.y <= 0.5)
        return m;
    uint   v0 = gIndices[inst.y + prim * 3u] + inst.z;
    uint   v1 = gIndices[inst.y + prim * 3u + 1u] + inst.z;
    uint   v2 = gIndices[inst.y + prim * 3u + 2u] + inst.z;
    float2 t0 = vertexUv(v0), t1 = vertexUv(v1), t2 = vertexUv(v2);
    float3 a = row.row0.xyz, c = row.row1.xyz, d = row.row2.xyz;
    float3 e1 = vertexPosition(v1) - vertexPosition(v0), e2 = vertexPosition(v2) - vertexPosition(v0);
    e1 = float3(dot(a, e1), dot(c, e1), dot(d, e1));
    e2 = float3(dot(a, e2), dot(c, e2), dot(d, e2));
    float worldArea = length(cross(e1, e2));
    float2 u1 = t1 - t0, u2 = t2 - t0;
    float uvArea = abs(u1.x * u2.y - u2.x * u1.y);
    float lod = 0.5 * log2(max(uvArea, 1e-20) / max(worldArea, 1e-20)) + log2(max(width, 1e-6) / max(abs(dot(N, R)), 0.05)) + gRt.params.w;
    return hitLook(index, prim, bary, lod, R, N, occlusion, alpha);
}

MaterialData hitMaterial(uint index, uint prim, float2 bary, float width, float3 R, inout(float3) N, out(float) occlusion)
{
    float alpha;
    return hitMaterialAlpha(index, prim, bary, width, R, N, occlusion, alpha);
}

STRUCT(Hit)
{
    DATA(float4, result, None); // the finished sample (rgb, a distance; 0: not traced, RT_MISS: the sky); a < 0: light it
    DATA(float4, pos, None);    // xyz the hit, w its distance
    DATA(float4, normal, None); // xyz
    DATA(float4, ray, None);    // xyz the ray's direction, w the screen's share
    DATA(float4, screen, None); // rgb the screen's colour
    DATA(uint, material, None);
    DATA(uint4, tri, None);     // the hit's top-level instance, triangle and barycentrics (as uints)
    DATA(float, cone, None);    // the ray cone's width there (m)
    DATA(float, invPdf, None);  // 1 / the probability the ray was cast with (GGX visible normals), for its reuse
    // The glass layers in front of what the ray saw (FLAG_GLASS), shaded as it met them: what it shows is
    // glassOwn.rgb + glassThrough.rgb x what is behind (their light and fog, and the product of their T and the fog).
    DATA(float4, glassOwn, None);     // w the layers (0: none)
    DATA(float4, glassThrough, None); // w the path before the last segment (m): pos.w and result.a go on from it
    DATA(float4, first, None);        // xyz the ray as cast (what the half-resolution reuse reads), before any glass bent it
    DATA(uint, others, None);         // followRay: layers met of another instance than its `self`
    DATA(float, spread, None);        // and the spreads (rad) of the layers it bent through
};

// Where a ray that meets refracting glass (material_refraction refr, at P with shading normal N, coming along I)
// leaves it, and which way, as the core's see-through pass bends the view (Forward.frag refractedScene): a thin pane
// (shape 0) `thickness` thick shifts it, on as it came; a solid one is a ball that thick, refracted in and out of it,
// reflecting inside past the critical angle.
void refractThrough(float3 P, float3 N, float3 I, float4 refr, out(float3) E, out(float3) D)
{
    float  ior = max(refr.x, 1.0);
    float3 T = refract(I, N, 1.0 / ior);
    if (dot(T, T) < 1e-6)
        T = I;
    if (refr.z < 0.5)
    {
        E = P + T * (refr.y / max(dot(T, -N), 0.2));
        D = I;
    }
    else
    {
        E = P + T * (refr.y * max(dot(T, -N), 0.0));
        float3 N2 = normalize(E - (P - N * (refr.y * 0.5)));
        D = refract(T, -N2, ior);
        if (dot(D, D) < 1e-6)
            D = reflect(T, -N2);
    }
}

// The ray cone along pixel p's reflected ray (Akenine-Moller et al. 2021), its width t along it c.x + t c.y: a pixel wide at
// the surface (view depth z, normal N), spreading by the pixel's angle, twice the surface's own bend across a pixel (the
// normal's change to the neighbours on the same surface) and the lobe's width (alpha) for a rough reflection, so distant
// and curved reflections pick blurrier mips instead of shimmering.
float2 coneOf(int2 p, float z, float3 N, float alpha)
{
    int2  size = int2(gRt.screen.xy);
    float pixelAngle = 2.0 / (gRt.up.w * gRt.screen.y);
    float bend = 0.0;
    for (uint k = 0u; k < 2u; ++k)
    {
        int2  q = clamp(p + int2(k == 0u ? 1 : 0, k == 1u ? 1 : 0), int2(0, 0), size - int2(1, 1));
        float dq = LoadTex2D(gDepth, NO_SAMPLER, q, 0).r;
        if (dq > 0.0 && abs(gRt.forward.w / dq - z) < 0.05 * z)
            bend = max(bend, length(normalize(LoadTex2D(gSurface, NO_SAMPLER, q, 0).yzw) - N));
    }
    return float2(z * pixelAngle, pixelAngle + 2.0 * bend + alpha);
}

Hit noHit()
{
    Hit o;
    o.result = float4(0.0, 0.0, 0.0, 0.0);
    o.pos = float4(0.0, 0.0, 0.0, 0.0);
    o.normal = float4(0.0, 0.0, 0.0, 0.0);
    o.ray = float4(0.0, 0.0, 0.0, 0.0);
    o.screen = float4(0.0, 0.0, 0.0, 0.0);
    o.material = 0u;
    o.tri = uint4(0u, 0u, 0u, 0u);
    o.cone = 0.0;
    o.invPdf = 0.0;
    o.glassOwn = float4(0.0, 0.0, 0.0, 0.0);
    o.glassThrough = float4(1.0, 1.0, 1.0, 0.0);
    o.first = float4(0.0, 0.0, 0.0, 0.0);
    o.others = 0u;
    o.spread = 0.0;
    return o;
}

// Follows `ray` (for pixel p: fp its noise's pixel, seq its sequence) to what it meets. Glass is never committed: the
// nearest layer that counts (Hit.h.fsl) is shaded where the ray meets it, and the ray goes on from it (bent through
// refracting glass, Forward.frag's way), up to GLASS_LAYERS in all with the `layers` already met; past them the rest of
// the glass only multiplies. The path so far: `travelled` metres, the cone's width cone.x + t cone.y at t along it (coneOf),
// rough refracting layers' spreads spreadSum (rad) and spreadAt (each times where it was met). screen: a hit visible on
// screen now and last frame takes the screen's colour. What the screen shows, the sky and untraced pixels come back
// finished; a hit to light where it is comes back with result.a < 0 (lightHit); others counts the layers met of another
// top-level instance than `self`; jitter: rough layers send it over their spread (else straight on, bent).
Hit followRay(RayDesc ray, int2 p, uint seq, int2 fp, float2 cone, uint layers, float travelled, float spreadSum, float spreadAt,
              bool screen, uint self, bool jitter)
{
    Hit    o = noHit();
    int2   size = int2(gRt.screen.xy);
    bool   debug = (gRt.counts.z & FLAG_DEBUG) != 0u;
    float3 R = ray.Direction;
    uint   met = layers;
    float3 own = float3(0.0, 0.0, 0.0), through = float3(1.0, 1.0, 1.0);
    bool   isHit = false;
    float  t = 0.0;
    uint   index = 0u, prim = 0u;
    float2 bary = float2(0.0, 0.0);
    for (uint seg = 0u; seg <= GLASS_LAYERS; ++seg)
    {
        float  glassT = ray.TMax;
        uint4  glassTri = uint4(0u, 0u, 0u, 0u);
        bool   lookForGlass = layers < GLASS_LAYERS;
        RayQueryClosestHit(gScene, RAY_TRAVERSAL_FLAG_DEFAULT, RT_RAY_FLAGS, ray, MASK_REFLECTED, hit)
        RayQueryBeginForEachCandidate(hit)
        {
            uint   ci = RayQueryCandidateInstanceID(hit);
            uint   cp = RayQueryCandidatePrimitiveIndex(hit);
            float2 cb = RayQueryCandidateBarycentrics(hit);
            if (isGlass(ci))
            {
                float ct = RayQueryCandidateRayT(hit);
                uint  material;
                if (lookForGlass && ct < glassT && !cutAway(ci, cp, cb) &&
                    glassCounts(ci, (gRtInstances[ci].w & RT_INST_MATERIAL) - 1u, dot(hitNormal(ci, cp, cb, material), ray.Direction) < 0.0))
                {
                    glassT = ct;
                    glassTri = uint4(ci, cp, asuint(cb));
                }
            }
            else if (!cutAway(ci, cp, cb))
                RayQueryCommitCandidate(hit);
            RayQueryProceed(hit);
        }
        RayQueryEndForEachCandidate(hit)
        isHit = RayQueryIsHit(hit);
        t = isHit ? RayQueryRayT(hit) : ray.TMax;
        if (isHit)
        {
            index = RayQueryInstanceID(hit);
            prim = RayQueryPrimitiveIndex(hit);
            bary = RayQueryBarycentrics(hit);
        }
        if (glassT >= t)
            break;
        if (glassTri.x != self)
            o.others += 1u;
        // A layer, as the core's see-through pass draws one over what is behind: its own light (diffuse and glow by
        // its coverage, specular whole, no decals) plus its T times what is behind, each fogged over the way to it.
        float3 I = ray.Direction;
        float3 G = ray.Origin + I * glassT;
        float3 fog0 = applyHeightFog(float3(0.0, 0.0, 0.0), ray.Origin, I, glassT);
        float3 fogT = applyHeightFog(float3(1.0, 1.0, 1.0), ray.Origin, I, glassT) - fog0;
        own += through * fog0;
        through *= fogT;
        float2       gb = asfloat(glassTri.zw);
        uint         material;
        float3       Ng = hitNormal(glassTri.x, glassTri.y, gb, material);
        if (dot(Ng, I) > 0.0)
            Ng = -Ng; // the side the ray came from
        float        at = travelled + glassT;
        float        occlusion, alpha;
        MaterialData m = hitMaterialAlpha(glassTri.x, glassTri.y, gb, cone.x + at * cone.y + spreadSum * at - spreadAt, I, Ng,
                                          occlusion, alpha);
        float        coverage = saturate(gMaterialMaps[material].misc.z * alpha);
        float        phi = noise2(float2(fp) + float(gRt.counts.y % 64u) * 5.588238) * 2.0 * PI;
        own += through * shadeHit(G, Ng, -I, m, occlusion, float2(cos(phi), sin(phi)), MAX_SHADOW_RAYS, false, coverage);
        through *= glassTransmit(m, material, coverage, max(dot(Ng, -I), 1e-3));
        layers += 1u;
        // On from it: straight, or bent through it (and over the rough one's spread, which the history averages).
        float4 refr = gRefraction[material * 2u];
        float3 E = G;
        float3 D = I;
        if ((gRt.counts.z & FLAG_REFRACT) != 0u && refr.w > 0.5)
        {
            refractThrough(G, Ng, I, refr, E, D);
            float a = m.albedoRough.a * m.albedoRough.a;
            float spread = 2.0 * a * (1.0 - 1.0 / max(refr.x, 1.0));
            o.spread += spread;
            if (jitter && spread > 1e-5)
            {
                float2 u2 = sample2(p + int2(37 * int(layers), 91), seq);
                float3 axis = abs(D.y) < 0.9 ? float3(0.0, 1.0, 0.0) : float3(1.0, 0.0, 0.0);
                float3 tx = normalize(cross(axis, D));
                float3 ty = cross(D, tx);
                float  r = 0.5 * spread * sqrt(u2.x);
                float  ph = 2.0 * PI * u2.y;
                D = normalize(D + (tx * cos(ph) + ty * sin(ph)) * tan(r));
            }
            spreadSum += spread;
            spreadAt += spread * at;
        }
        float inside = length(E - G);
        travelled = at + inside;
        // Bent: from just short of where it leaves (a thin pane's far face is met again there, as raster draws it).
        // Straight: from just past the layer.
        ray.Origin = inside > 0.0 ? E - D * min(5e-4, 0.25 * inside) : G + D * (2e-4 + 1e-5 * at);
        ray.Direction = D;
        ray.TMax = max(gRt.params.x - travelled, 1e-3);
    }
    if (layers >= GLASS_LAYERS)
    {
        // Past the layers it shades: the rest of the glass on the way only multiplies (a second ray only glass
        // answers, up to the hit; any order: a product).
        RayDesc glassRay = ray;
        glassRay.TMax = t;
        RayQueryAnyHit(gScene, RAY_TRAVERSAL_FLAG_DEFAULT, RT_RAY_FLAGS, glassRay, MASK_GI_GLASS, deeper)
        RayQueryBeginForEachCandidate(deeper)
        {
            uint   ci = RayQueryCandidateInstanceID(deeper);
            uint   cp = RayQueryCandidatePrimitiveIndex(deeper);
            float2 cb = RayQueryCandidateBarycentrics(deeper);
            if (!cutAway(ci, cp, cb))
            {
                float3 g = glassThrough(ci, cp, cb, ray.Direction);
                through *= g;
                if (ci != self && min(g.r, min(g.g, g.b)) < 1.0)
                    o.others += 1u;
            }
            RayQueryProceed(deeper);
        }
        RayQueryEndForEachCandidate(deeper)
    }
    float3 R0 = R;
    R = ray.Direction; // what the ray met came along the last segment
    o.ray = float4(R0, 0.0); // kept for the half-resolution rays' reuse
    if (layers > met)
    {
        o.glassOwn = float4(debug ? float3(1.0, 0.0, 1.0) : own, float(layers - met));
        o.glassThrough = float4(debug ? float3(0.0, 0.0, 0.0) : through, travelled);
    }
    else
        o.glassThrough.w = travelled;
    if (!isHit)
    {
        float3 sky = applyHeightFog(skyRadiance(R) * gRt.sunColor.w, ray.Origin, R, gRt.fogAlbedo.w);
        o.result = float4(debug ? float3(0.5, 0.5, 0.5) : clampSample(sky), RT_MISS);
        o.pos = float4(ray.Origin, ray.TMax); // where the last segment set out from, and how far it looked
        o.normal = float4(R, 0.0);
        return o;
    }
    float3 Hp = ray.Origin + R * t;
    // How much of the hit to take from the screen: visible there now (its depth matches) and last frame.
    float  screenWeight = 0.0;
    float3 screenColor = float3(0.0, 0.0, 0.0);
    if (screen)
    {
        float4 c = clipOf(gRt.viewProj, Hp);
        float4 pc = clipOf(gRt.prevViewProj, Hp);
        if (c.w > gRt.forward.w && pc.w > gRt.forward.w)
        {
            float2 uv = c.xy / c.w * float2(0.5, -0.5) + 0.5;
            float2 uvPrev = pc.xy / pc.w * float2(0.5, -0.5) + 0.5;
            float2 edge = min(min(uv, 1.0 - uv), min(uvPrev, 1.0 - uvPrev));
            float  inside = saturate(min(edge.x, edge.y) / gRt.params.y);
            if (inside > 0.0)
            {
                int2  q = clamp(int2(uv * gRt.screen.xy), int2(0, 0), size - int2(1, 1));
                float seen = gRt.forward.w / max(LoadTex2D(gDepth, NO_SAMPLER, q, 0).r, 1e-7);
                if (abs(seen - c.w) < 0.02 * c.w + 0.03)
                {
                    screenWeight = inside;
                    screenColor = SampleLvlTex2D(gPrevious, gSamplerBilinearClamp, uvPrev, 0.0).rgb;
                }
            }
        }
    }
    if (screenWeight >= 1.0)
    {
        o.result = float4(clampSample(debug ? float3(0.0, 1.0, 0.0) : screenColor), max(travelled + t, 1e-3));
        return o;
    }
    uint   material;
    float3 Nh = hitNormal(index, prim, bary, material);
    if (dot(Nh, R) > 0.0)
        Nh = -Nh; // the side the ray came from
    o.result = float4(0.0, 0.0, 0.0, -1.0);
    o.pos = float4(Hp, t);
    o.normal = float4(Nh, 0.0);
    o.ray = float4(R, screenWeight);
    o.screen = float4(screenColor, 0.0);
    o.material = material;
    o.tri = uint4(index, prim, asuint(bary));
    o.cone = cone.x + (travelled + t) * cone.y + spreadSum * (travelled + t) - spreadAt;
    return o;
}

// Traces pixel p's reflected ray (surface and d: its surface and depth); its result as followRay's.
Hit traceRay(int2 p, float4 surface, float d, uint seq, int2 fp)
{
    float rough = surface.x;
    if (d <= 0.0 || rough >= gRt.camPos.w)
        return noHit();

    // The pixel's world position, from depth (reversed-Z, infinite far), undoing the TAA jitter it was drawn with.
    float  z = gRt.forward.w / d;
    float2 u = float2(p) + 0.5 - gRt.screen.zw;
    float2 ndc = float2(u.x / gRt.screen.x * 2.0 - 1.0, 1.0 - u.y / gRt.screen.y * 2.0);
    float3 P = gRt.camPos.xyz + gRt.right.xyz * (ndc.x * z / gRt.right.w) + gRt.up.xyz * (ndc.y * z / gRt.up.w) + gRt.forward.xyz * z;
    float3 N = normalize(surface.yzw);
    float3 V = normalize(gRt.camPos.xyz - P);

    // The reflected ray, about one visible microfacet normal; a mirror stays a mirror.
    float  alpha = rough * rough;
    float3 R = reflect(-V, N);
    float  invPdf = 0.0;
    if (alpha > 1e-3)
    {
        float3 axis = abs(N.y) < 0.9 ? float3(0.0, 1.0, 0.0) : float3(1.0, 0.0, 0.0);
        float3 tx = normalize(cross(axis, N));
        float3 ty = cross(N, tx);
        float3 v = float3(dot(V, tx), dot(V, ty), max(dot(V, N), 1e-4));
        float3 h = sampleVndf(v, alpha, sample2(p, seq));
        float3 Rj = reflect(-V, tx * h.x + ty * h.y + N * h.z);
        if (dot(Rj, N) > 0.0)
            R = Rj;
        // G1(V) D(H) / (4 N.V), as reconstruct weighs the ray by (1 / it, as a half can't hold it at grazing angles).
        float a2 = alpha * alpha;
        float pdf = smithG1(v.z, a2) * ggxD(saturate(dot(N, normalize(V + R))), a2) / (4.0 * v.z);
        invPdf = pdf > 0.0 ? 1.0 / pdf : 0.0;
    }

    RayDesc ray;
    ray.Origin = P + N * (0.001 * z + 0.004); // off the surface, more further away where depth is coarser
    ray.Direction = R;
    ray.TMin = 0.0;
    ray.TMax = gRt.params.x;
    Hit o = followRay(ray, p, seq, fp, coneOf(p, z, N, alpha), 0u, 0.0, 0.0, 0.0, (gRt.counts.z & FLAG_SCREEN) != 0u, 0xFFFFFFFFu, true);
    o.first = float4(R, 0.0);
    o.invPdf = invPdf;
    return o;
}

// A hit traceRay left to light (for pixel p): lit where it is, blended with what the screen shows of it.
float4 lightHit(Hit h, int2 p)
{
    float4 pos = h.pos;
    float4 ray = h.ray;
    float3 screen = h.screen.rgb;
    // The maps' filter turned per pixel and frame, as the core's (TAA averages it).
    float        phi = noise2(float2(p) + float(gRt.counts.y % 64u) * 5.588238) * 2.0 * PI;
    float3       N = h.normal.xyz;
    float        occlusion;
    MaterialData m = hitMaterial(h.tri.x, h.tri.y, asfloat(h.tri.zw), h.cone, ray.xyz, N, occlusion);
    m = hitDecals(pos.xyz, h.normal.xyz, ray.xyz, h.cone, m, N);
    float3       lit = shadeHit(pos.xyz, N, -ray.xyz, m, occlusion, float2(cos(phi), sin(phi)), MAX_SHADOW_RAYS, false, 1.0);
    // The fog between the reflecting surface and the hit (what the screen shows of it already holds the camera's).
    lit = applyHeightFog(lit, pos.xyz - ray.xyz * pos.w, ray.xyz, pos.w);
    float3 color = lerp(lit, screen, ray.w);
    if ((gRt.counts.z & FLAG_DEBUG) != 0u)
        color = float3(0.0, ray.w, 1.0 - ray.w);
    return float4(clampSample(color), max(h.glassThrough.w + pos.w, 1e-3));
}

// A sample (what the ray saw behind) with the glass layers in front of it (traceRay shaded them).
float4 overGlass(Hit h, float4 behind)
{
    if (h.glassOwn.w <= 0.0)
        return behind;
    return float4(clampSample(h.glassOwn.rgb + behind.rgb * h.glassThrough.rgb), behind.a);
}

// What pixel p's reflected ray sees: rgb, a its distance (0: not traced, RT_MISS: the sky).
float4 tracePixel(int2 p, float4 surface, float d)
{
    Hit h = traceRay(p, surface, d, gRt.counts.y, p);
    float4 behind = h.result.a >= 0.0 ? h.result : lightHit(h, p);
    return overGlass(h, behind);
}

// Half resolution: each 2 x 2 block traces one pixel, a different one each frame (TAA gathers them).
int2 blockOffset()
{
    uint k = gRt.counts.y % 4u;
    return int2(k == 1u || k == 2u ? 1 : 0, k == 1u || k == 3u ? 1 : 0);
}

#if defined(TRACE_PASS)
// The trace, one thread per 2 x 2 block of pixels, so a quarter of the threads trace at half resolution with
// none idle: its pixels smoother than the full-resolution threshold (params.z; every glossy pixel with
// half_resolution off) into gOutFull, then with half_resolution on the block's pixel for this frame (unless it is
// one of those) into gOutHalf. A pixel that reflects marks its 8 x 8 tile in gTiles (cleared by last frame's
// resolve), so the resolve skips the others.
// It runs in five rounds (the block's four pixels at full resolution, then its half-resolution one), each
// tracing one pixel per thread and lighting its hit where it is. (Gathering the hits to light per group and
// lighting them one per thread, Renderer 2.2.6 to 2.2.9, was no faster on an RTX 2080 and slower in the start view.)
ROOT_SIGNATURE(ComputeRootSignature)
NUM_THREADS(8, 8, 1)
void CS_MAIN(SV_DispatchThreadID(uint3) id)
{
    INIT_MAIN;
    int2 size = int2(gRt.screen.xy);
    int2 b = int2(id.xy);
    bool inside = b.x < (size.x + 1) / 2 && b.y < (size.y + 1) / 2;
    bool reflects = false;
    for (uint k = 0u; k < 5u; ++k)
    {
        // This round's pixel: one of the block's four at full resolution, or its half-resolution one.
        bool   isHalf = k == 4u;
        int2   p = isHalf ? min(b * 2 + blockOffset(), size - int2(1, 1)) : b * 2 + int2(int(k & 1u), int(k >> 1u));
        float4 surface = float4(1.0, 0.0, 0.0, 0.0);
        if (inside && p.x < size.x && p.y < size.y)
            surface = LoadTex2D(gSurface, NO_SAMPLER, p, 0);
        bool glossy = surface.x < gRt.camPos.w;
        reflects = reflects || (glossy && !isHalf);
        bool trace = glossy && (isHalf ? gRt.temporal.w > 0.5 && surface.x >= gRt.params.z : surface.x < gRt.params.z);
        if (trace)
        {
            // A half-resolution pixel is traced every fourth frame: its own samples are consecutive.
            Hit h = traceRay(p, surface, LoadTex2D(gDepth, NO_SAMPLER, p, 0).r, isHalf ? gRt.counts.y >> 2u : gRt.counts.y, isHalf ? b : p);
            // The maps' filter is turned by where the sample is written (the half-size texel at half resolution).
            if (h.result.a < 0.0)
                h.result = lightHit(h, isHalf ? b : p);
            h.result = overGlass(h, h.result);
            if (isHalf)
            {
                Write2D(gOutHalf, b, h.result);
                Write2D(gOutHalfRay, b, float4(h.first.xyz, h.invPdf));
            }
            else
                Write2D(gOutFull, p, h.result);
        }
        else if (isHalf && inside && gRt.temporal.w > 0.5)
            Write2D(gOutHalf, b, float4(0.0, 0.0, 0.0, 0.0));
    }
    if (reflects)
        gTiles[gRt.tiles.z + (b.y >> 2) * gRt.tiles.x + (b.x >> 2)] = 1u;
    RETURN();
}
#endif

#if defined(TRACE_RECONSTRUCT)
// Pixel p's world position from its depth d, as it was drawn (with the TAA jitter), as traceRay finds it.
float3 worldAt(int2 p, float d)
{
    float  z = gRt.forward.w / d;
    float2 u = float2(p) + 0.5 - gRt.screen.zw;
    float2 ndc = float2(u.x / gRt.screen.x * 2.0 - 1.0, 1.0 - u.y / gRt.screen.y * 2.0);
    return gRt.camPos.xyz + gRt.right.xyz * (ndc.x * z / gRt.right.w) + gRt.up.xyz * (ndc.y * z / gRt.up.w) + gRt.forward.xyz * z;
}

// A full-resolution pixel's reflection from the half-resolution rays around it (Stachowiak, "Stochastic
// Screen-Space Reflections", 2015): every ray of the 3 x 3 nearest is reused, turned towards what it found as seen
// from this pixel, and weighted by this pixel's own GGX lobe over the probability the ray was cast with (its
// visible-normal sample at its own pixel). So each pixel gets nine rays a frame where it had one in four, and the
// weights follow its own lobe, which keeps the reflection as sharp as its roughness: a ray outside the lobe counts
// for nothing. Rays from across an edge or crease (depth, normal) are left out, and each is also weighted by its
// inverse brightness (Karis 2014), so one bright ray can't spread. Pixels no ray fits are traced here.
float4 reconstruct(int2 p, float4 surface, float d)
{
    int2   size = int2(gRt.screen.xy);
    int2   o = blockOffset();
    int2   halfSize = (size + int2(1, 1)) / 2;
    int2   c = clamp((p - o + int2(1, 1)) >> 1, int2(0, 0), halfSize - int2(1, 1)); // the nearest ray
    float  zp = gRt.forward.w / d;
    float3 Pp = worldAt(p, d);
    float3 Np = normalize(surface.yzw);
    float3 Vp = normalize(gRt.camPos.xyz - Pp);
    float  NoVp = max(dot(Np, Vp), 1e-4);
    float  ap = surface.x * surface.x;
    float  a2p = ap * ap;
    float  exposure = gExposure[1];
    float4 sum = float4(0.0, 0.0, 0.0, 0.0);
    float  wsum = 0.0;
    float  match = 0.0; // the edge weights alone: whether any ray fits
    for (int j = -1; j <= 1; ++j)
    {
        for (int i = -1; i <= 1; ++i)
        {
            int2   q = c + int2(i, j);
            if (q.x < 0 || q.y < 0 || q.x >= halfSize.x || q.y >= halfSize.y)
                continue;
            float4 v = LoadTex2D(gHalfIn, NO_SAMPLER, q, 0);
            if (v.a <= 0.0)
                continue;
            int2   s = min(q * 2 + o, size - int2(1, 1));
            float  ds = LoadTex2D(gDepth, NO_SAMPLER, s, 0).r;
            float4 ss = LoadTex2D(gSurface, NO_SAMPLER, s, 0);
            float  zs = gRt.forward.w / max(ds, 1e-7);
            float3 Ns = normalize(ss.yzw);
            float  edge = saturate(1.0 - abs(zs - zp) / (0.02 * zp + 0.02)) * pow(saturate(dot(Ns, Np)), 32.0);
            match += edge;
            if (edge <= 0.0)
                continue;
            // The ray, and 1 / the probability it was cast with (the trace's).
            float4 Ls = LoadTex2D(gHalfRayIn, NO_SAMPLER, q, 0);
            float3 Ps = worldAt(s, ds);
            // Towards what it found, from here (the sky: the same direction).
            float3 L = Ls.xyz;
            if (v.a < RT_MISS * 0.5)
                L = normalize(Ps + Ns * (0.001 * zs + 0.004) + Ls.xyz * v.a - Pp);
            float NoL = dot(Np, L);
            if (NoL <= 0.0 || Ls.w <= 0.0)
                continue;
            // This pixel's lobe: D(H) times the height-correlated Smith visibility times N.L (Fresnel cancels out).
            float  NoH = saturate(dot(Np, normalize(Vp + L)));
            float  gv = NoL * sqrt(NoVp * NoVp * (1.0 - a2p) + a2p);
            float  gl = NoVp * sqrt(NoL * NoL * (1.0 - a2p) + a2p);
            float  lobe = ggxD(NoH, a2p) * (0.5 / max(gv + gl, 1e-5)) * NoL;
            float  w = edge * lobe * Ls.w / (1.0 + luminance(v.rgb) * exposure);
            sum += v * w;
            wsum += w;
        }
    }
    if (match < 0.02 || wsum <= 0.0)
        return tracePixel(p, surface, d);
    return sum / wsum;
}

// The reconstruction, one full-size pass between the trace and the resolve: each glossy pixel traced at half
// resolution gets its reflection from the rays around it, written beside the full-resolution traces (gOutFull),
// so the resolve reads every pixel's from one texture. Tiles with nothing to reflect return at once.
ROOT_SIGNATURE(ComputeRootSignature)
NUM_THREADS(8, 8, 1)
void CS_MAIN(SV_DispatchThreadID(uint3) id, SV_GroupID(uint3) gid)
{
    INIT_MAIN;
    int2 size = int2(gRt.screen.xy);
    int2 p = int2(id.xy);
    if (p.x >= size.x || p.y >= size.y || gTiles[gRt.tiles.z + gid.y * gRt.tiles.x + gid.x] == 0u)
        RETURN();
    float4 surface = LoadTex2D(gSurface, NO_SAMPLER, p, 0);
    if (surface.x >= gRt.camPos.w || surface.x < gRt.params.z)
        RETURN(); // not glossy, or traced at full resolution
    float d = LoadTex2D(gDepth, NO_SAMPLER, p, 0).r;
    if (d > 0.0)
        Write2D(gOutFull, p, reconstruct(p, surface, d));
    RETURN();
}
#endif

float3 compressColor(float3 c) { return c / (1.0 + max(c.r, max(c.g, c.b))); }
float3 expandColor(float3 c) { return c / max(1.0 - max(c.r, max(c.g, c.b)), 1e-4); }
float3 toYCoCg(float3 c) { return float3(dot(c, float3(0.25, 0.5, 0.25)), dot(c, float3(0.5, 0.0, -0.5)), dot(c, float3(-0.25, 0.5, -0.25))); }
float3 fromYCoCg(float3 c) { return float3(c.x + c.y - c.z, c.x + c.z, c.x - c.y - c.z); }

// h clipped towards the box's centre; m says how far outside it was, in the box's half-widths (over 1: clipped).
float3 clipToBox(float3 h, float3 lo, float3 hi, out float m)
{
    float3 centre = 0.5 * (lo + hi);
    float3 extent = 0.5 * (hi - lo) + float3(1e-5, 1e-5, 1e-5);
    float3 v = h - centre;
    float3 a = abs(v / extent);
    m = max(a.x, max(a.y, a.z));
    return m > 1.0 ? centre + v / m : h;
}

#if defined(TRACE_RESOLVE) || defined(TRACE_FILTER)
// This frame's reflection at pixel q (surface and d: its surface and depth): traced at full resolution by the
// trace pass, reconstructed from the half-resolution rays, or nothing.
float4 currentAt(int2 q, float4 surface, float d)
{
    if (d <= 0.0 || surface.x >= gRt.camPos.w)
        return float4(0.0, 0.0, 0.0, 0.0);
    return LoadTex2D(gFullIn, NO_SAMPLER, q, 0);
}

// The reflections' temporal accumulation, in the same pass: each pixel's history is found where the reflected
// image was last frame (reprojecting the reflection's virtual image, P plus the hit distance along the view
// ray, for smooth surfaces; the surface itself for rough ones), dropped where that surface wasn't there last
// frame (its depth), clipped to this frame's neighbourhood spread (mean +- 1.25 deviations, YCoCg) and blended
// in a compressed space (c / (1 + max(c)), so a bright sample counts no more than a white one) at 1 / samples, the
// samples the pixel's history holds: up to more the rougher, noisier and stiller the surface. At half resolution the
// spread comes from the traced rays themselves (5 x 5 of them, 10 x 10 pixels): reconstructed neighbours share rays,
// and their spread is too narrow to hold the history (a box that also widened to a still pixel's own spread over
// time held it, but let a switched-off light linger for tens of frames). TAA then anti-aliases the frame as before.
#define CLIP_WIDTH 1.25
// Samples a still pixel's history may hold, whatever its roughness: enough that a still view settles completely
// (mirrors too: their jittered samples differ across the pixel). Anything that moves at all (0.01 pixel), or that
// the clip finds changed, keeps history_frames (less on mirrors).
#define STILL_SAMPLES 128.0
// How far outside the clip box (in its half-widths) a still pixel's history must lie to count as changed: noise
// alone pokes just past the box now and then, and dropping the history for it showed as flicker.
#define STILL_SNAP 1.5
// A still glossy pixel's history counts as changed only when it lies out that far on STILL_STRIKES frames running,
// or past STILL_SNAP_NOW on one (see resolve).
#define STILL_SNAP_NOW 4.0
#define STILL_STRIKES 3.0

float2 uvOf(float4 c) { return c.xy / c.w * float2(0.5, -0.5) + 0.5; }
bool   inScreen(float2 uv) { return uv.x > 0.0 && uv.y > 0.0 && uv.x < 1.0 && uv.y < 1.0; }

void resolve(int2 p)
{
    int2   size = int2(gRt.screen.xy);
    float4 surface = LoadTex2D(gSurface, NO_SAMPLER, p, 0);
    float  d = surface.x < gRt.camPos.w ? LoadTex2D(gDepth, NO_SAMPLER, p, 0).r : 0.0;
    float4 cur = currentAt(p, surface, d);
    if (cur.a <= 0.0 || d <= 0.0)
    {
        // Nothing reflected here: no depth is kept either, as the history's alpha says so.
        Write2D(gOut, p, float4(0.0, 0.0, 0.0, 0.0));
        return;
    }
    float exposure = max(gExposure[1], 1e-8);
    float rough = surface.x;

    // The neighbourhood's spread (traced pixels only), and its brightest neighbour.
    float3 c = toYCoCg(compressColor(cur.rgb * exposure));
    float3 m1 = c;
    float3 m2 = c * c;
    float  n = 1.0;
    float  brightest = 0.0;
    bool   fromHalf = gRt.temporal.w > 0.5 && rough >= gRt.params.z;
    int2   halfSize = (size + int2(1, 1)) / 2;
    int2   centre = fromHalf ? clamp(p >> 1, int2(0, 0), halfSize - int2(1, 1)) : p;
    int2   last = fromHalf ? halfSize - int2(1, 1) : size - int2(1, 1);
    int    reach = fromHalf ? 2 : 1;
    for (int y = -reach; y <= reach; ++y)
    {
        for (int x = -reach; x <= reach; ++x)
        {
            if (x == 0 && y == 0 && !fromHalf)
                continue;
            int2   q = clamp(centre + int2(x, y), int2(0, 0), last);
            float4 v = float4(0.0, 0.0, 0.0, 0.0);
            if (fromHalf)
                v = LoadTex2D(gHalfIn, NO_SAMPLER, q, 0);
            else
            {
                float4 sq = LoadTex2D(gSurface, NO_SAMPLER, q, 0);
                if (sq.x < gRt.camPos.w)
                    v = currentAt(q, sq, LoadTex2D(gDepth, NO_SAMPLER, q, 0).r);
            }
            if (v.a <= 0.0)
                continue;
            float3 s = toYCoCg(compressColor(v.rgb * exposure));
            m1 += s;
            m2 += s * s;
            n += 1.0;
            brightest = max(brightest, s.x);
        }
    }
    float3 mean = m1 / n;
    float3 width = sqrt(max(m2 / n - mean * mean, float3(0.0, 0.0, 0.0))) * CLIP_WIDTH;

    // Where this pixel and its reflection were last frame, from the pixel's centre: the accumulated reflection is
    // the pixel's own (as TAA's history is), and this frame's jittered sample is one sample of it. So a still view
    // reads its history in place, not shifted by the jitter (which blurred it a little more every frame and, past
    // half a pixel, read as motion and cut the history short).
    float  z = gRt.forward.w / d;
    float2 u = float2(p) + 0.5;
    float2 ndc = float2(u.x / gRt.screen.x * 2.0 - 1.0, 1.0 - u.y / gRt.screen.y * 2.0);
    float3 P = gRt.camPos.xyz + gRt.right.xyz * (ndc.x * z / gRt.right.w) + gRt.up.xyz * (ndc.y * z / gRt.up.w) + gRt.forward.xyz * z;
    float3 toP = normalize(P - gRt.camPos.xyz);
    float4 pcS = clipOf(gRt.prevViewProj, P);
    float4 pcV = clipOf(gRt.prevViewProj, P + toP * min(cur.a, 1000.0));
    float  mirrorish = saturate(1.0 - rough / max(gRt.camPos.w * 0.5, 1e-3));
    float2 uvS = uvOf(pcS);
    float2 uvPrev = pcV.w > gRt.forward.w ? lerp(uvS, uvOf(pcV), mirrorish) : uvS;

    // More history the rougher (noisier) the surface; little on mirrors, which are exact, and on what moves. Where
    // neither the surface nor its reflection moved, up to STILL_SAMPLES, so a still view settles.
    float  frames = 1.0 + (gRt.temporal.x - 1.0) * saturate(rough * 8.0);
    float  stillFrames = STILL_SAMPLES;
    float2 uvNow = (float2(p) + 0.5) / gRt.screen.xy;
    float2 moved = (LoadTex2D(gMotion, NO_SAMPLER, p, 0).xy - (uvNow - uvS)) * gRt.screen.xy;
    float2 shift = (uvPrev - uvNow) * gRt.screen.xy;
    bool   still = dot(moved, moved) < 1e-4 && dot(shift, shift) < 1e-4;
    if (dot(moved, moved) > 0.25)
        frames = min(frames, 4.0);
    // A jittered sample brighter than all its neighbours is a stray: held to the brightest of them where the pixel
    // moves, so it doesn't sparkle. Not where it is still: its long history averages strays out, and holding every
    // bright sample down settled it darker than the true reflection.
    if (!still && rough > 0.1 && n > 4.0 && c.x > brightest)
        c *= brightest / max(c.x, 1e-6);

    float3 result = c;
    float  hitDist = min(cur.a, RT_FAR);
    float  samples = 1.0;
    float  samplesPrev = 0.0;
    bool   valid = gRt.temporal.y > 0.5 && pcS.w > gRt.forward.w && inScreen(uvS) && inScreen(uvPrev);
    if (valid)
    {
        // Was this surface there last frame? Its depth then against the depth kept there (none where the
        // history holds nothing).
        int2  qs = clamp(int2(uvS * gRt.screen.xy), int2(0, 0), size - int2(1, 1));
        float2 zn = LoadTex2D(gHistory, NO_SAMPLER, qs, 0).a > 0.0 ? LoadTex2D(gHistoryZ, NO_SAMPLER, qs, 0).xy : float2(0.0, 0.0);
        valid = abs(zn.x - pcS.w) < 0.04 * pcS.w + 0.02;
        samplesPrev = zn.y;
    }
    // A still glossy pixel whose history lay out of the box keeps its strikes in quarters of its sample count.
    // A quarter of 3 marks a pixel that moved (for the filter): no strikes.
    float strikesPrev = round(frac(samplesPrev) * 4.0);
    strikesPrev = strikesPrev > 2.5 ? 0.0 : strikesPrev;
    samplesPrev = floor(samplesPrev);
    float strikes = 0.0;
    if (valid && max(frames, still ? stillFrames : 1.0) > 1.0)
    {
        // Bilinear, over the history texels that hold reflections only.
        float2 pos = uvPrev * gRt.screen.xy - 0.5;
        int2   base = int2(floor(pos));
        float2 f = pos - float2(base);
        float4 sum = float4(0.0, 0.0, 0.0, 0.0);
        float  histDist = 0.0;
        for (uint i = 0u; i < 4u; ++i)
        {
            int2   dq = int2(int(i & 1u), int(i >> 1u));
            int2   q = clamp(base + dq, int2(0, 0), size - int2(1, 1));
            float4 h = LoadTex2D(gHistory, NO_SAMPLER, q, 0);
            float  w = (dq.x == 1 ? f.x : 1.0 - f.x) * (dq.y == 1 ? f.y : 1.0 - f.y);
            if (h.a > 0.0)
            {
                sum += float4(compressColor(h.rgb * exposure), 1.0) * w;
                histDist += h.a * w;
            }
        }
        if (sum.w > 0.05)
        {
            float  outside;
            float3 history = clipToBox(toYCoCg(sum.rgb / sum.w), mean - width, mean + width, outside);
            // A still glossy pixel's history is changed only when it lies out of the box on STILL_STRIKES frames
            // running, or far out on one: noise alone puts it out of one frame's box now and then, and each time it
            // fell back to a short history, left with a fresh error that stayed (grain). Until then it is kept whole:
            // clipped to each frame's noisy box, it was pulled towards that frame's noise, and the pulls settled
            // into a fixed error per pixel too. A switched-off light is far out at once: it clears in a frame.
            // Mirrors and anything that moves are clipped and reset as before.
            bool   patient = still && rough > 0.1;
            bool   clipped = outside > STILL_SNAP && (!patient || strikesPrev + 1.0 >= STILL_STRIKES || outside > STILL_SNAP_NOW);
            strikes = patient && outside > STILL_SNAP && !clipped ? strikesPrev + 1.0 : 0.0;
            if (patient && !clipped)
                history = toYCoCg(sum.rgb / sum.w);
            // As many samples as the history holds plus this one, up to the cap: after a disocclusion the
            // history fills in evenly (1/2, 1/3, ...) instead of leaning on its first sample. A history the clip
            // found changed (a light moved) goes back to history_frames at once, so nothing trails.
            float cap = still && !clipped ? stillFrames : frames;
            samples = min(min(samplesPrev, cap - 1.0) + 1.0, cap);
            result = lerp(history, c, 1.0 / samples);
            hitDist = lerp(histDist / sum.w, hitDist, 1.0 / samples);
        }
    }
    // Alpha: the hit distance, averaged as the colour is (the filter sizes its footprint by it).
    Write2D(gOut, p, float4(max(expandColor(fromYCoCg(result)), float3(0.0, 0.0, 0.0)) / exposure, max(hitDist, 1e-3)));
    // Samples, plus strikes in quarters (3: it moved, for the filter).
    Write2D(gOutZ, p, float2(z, samples + (still ? strikes : 3.0) * 0.25));
}

#if defined(TRACE_FILTER)
// Pixel q's position at depth d (as the resolve's).
float3 positionAt(int2 q, float d)
{
    float  z = gRt.forward.w / d;
    float2 u = float2(q) + 0.5;
    float2 ndc = float2(u.x / gRt.screen.x * 2.0 - 1.0, 1.0 - u.y / gRt.screen.y * 2.0);
    return gRt.camPos.xyz + gRt.right.xyz * (ndc.x * z / gRt.right.w) + gRt.up.xyz * (ndc.y * z / gRt.up.w) + gRt.forward.xyz * z;
}

// The filter, one full-size pass after the resolve: this frame's accumulated reflections (gHistory) averaged over
// each glossy pixel's gloss footprint into gOut, which the forward pass reads. The history keeps them unfiltered,
// so nothing is filtered twice and nothing trails. A still pixel's history settles on the average of its own
// rays, and where they fall either side of a bright edge in what is reflected (the horizon, a light) it settled a
// little off, differently in each pixel: a frozen grain. Its neighbours, settled on rays of their own, average it
// out. The footprint is the lobe's spread at the hit seen from the eye (hit distance x lobe width / (eye to surface +
// hit distance)), so a reflection stays as sharp as it is towards where it touches what it reflects, capped at
// denoise.y pixels (the grain is a pixel or a half-resolution block wide; more only blurred highlights). Neighbours
// count by a fixed Gaussian (so the filter adds no flicker of its own), only where they share the pixel's plane,
// its normal within half the lobe, its roughness and hit distance: edges on screen and in the reflection stay.
// Mirror-like pixels (below full_below, traced at full resolution) are copied. Where the pixel moved (the resolve
// marks it in gHistoryZ), its history is a few frames and its reflection mottles over a few pixels: there the cap
// is denoise.w (moving_blur), with more taps, wider normals and no hit-distance stop. Still pixels are filtered as
// before, bit for bit.
ROOT_SIGNATURE(ComputeRootSignature)
NUM_THREADS(8, 8, 1)
void CS_MAIN(SV_DispatchThreadID(uint3) id, SV_GroupID(uint3) gid)
{
    INIT_MAIN;
    int2 size = int2(gRt.screen.xy);
    int2 p = int2(id.xy);
    if (p.x >= size.x || p.y >= size.y)
        RETURN();
    if (gTiles[gRt.tiles.z + gid.y * gRt.tiles.x + gid.x] == 0u)
    {
        Write2D(gOut, p, float4(0.0, 0.0, 0.0, 0.0)); // nothing traced in this tile
        RETURN();
    }
    float4 centre = LoadTex2D(gHistory, NO_SAMPLER, p, 0);
    float4 surface = LoadTex2D(gSurface, NO_SAMPLER, p, 0);
    float  rough = surface.x;
    float  d = LoadTex2D(gDepth, NO_SAMPLER, p, 0).r;
    if (centre.a <= 0.0 || d <= 0.0 || rough <= gRt.denoise.z)
    {
        Write2D(gOut, p, centre);
        RETURN();
    }
    float  alpha = rough * rough;
    float3 P = positionAt(p, d);
    float  eye = length(P - gRt.camPos.xyz);
    float  pixelAngle = 2.0 / (gRt.up.w * gRt.screen.y);
    bool   moved = round(frac(LoadTex2D(gHistoryZ, NO_SAMPLER, p, 0).y) * 4.0) > 2.5;
    float  radius = min(gRt.denoise.x * centre.a * alpha / ((eye + centre.a) * pixelAngle), moved ? max(gRt.denoise.w, gRt.denoise.y) : gRt.denoise.y);
    if (radius < 0.5)
    {
        Write2D(gOut, p, centre);
        RETURN();
    }
    float3 N = normalize(surface.yzw);
    float  exposure = max(gExposure[1], 1e-8);
    int    reach = radius < 1.5 ? 1 : (radius < 3.0 ? 2 : 3);
    float  stride = radius / float(reach);
    float  sigma2 = 0.5 * radius * radius;
    float  planeTol = 0.01 * eye + 0.005;
    float  lobe = max(alpha, 0.02);
    float  normalTol = 0.125 * lobe * lobe; // a normal turned by half the lobe turns the reflection by all of it
    // Where it moved, the normals it takes widen with the radius (as ReBLUR's do on a short history): on a curved
    // surface the narrow ones left the filter a pixel wide however far it could reach.
    float  widen = moved ? max(radius / gRt.denoise.y, 1.0) : 1.0;
    normalTol *= widen * widen;
    float  roughTol = 0.15 * rough + 0.01;
    float4 sum = float4(compressColor(centre.rgb * exposure), 1.0);
    for (int y = -reach; y <= reach; ++y)
    {
        for (int x = -reach; x <= reach; ++x)
        {
            if (x == 0 && y == 0)
                continue;
            float2 o = float2(float(x), float(y)) * stride;
            int2   q = clamp(p + int2(round(o)), int2(0, 0), size - int2(1, 1));
            float4 h = LoadTex2D(gHistory, NO_SAMPLER, q, 0);
            float  dq = LoadTex2D(gDepth, NO_SAMPLER, q, 0).r;
            if (h.a <= 0.0 || dq <= 0.0)
                continue;
            float4 sq = LoadTex2D(gSurface, NO_SAMPLER, q, 0);
            float  plane = abs(dot(N, positionAt(q, dq) - P));
            float  bend = 1.0 - dot(N, normalize(sq.yzw));
            // Where it moved, hit distances are a few frames' and noisy: told apart by them, neighbours were taken at
            // random and the filter added grain of its own.
            float  far = moved ? 0.0 : abs(h.a - centre.a) / (0.25 * min(h.a, centre.a) + 0.05 * eye);
            float  w = exp(-dot(o, o) / sigma2 - plane / planeTol - bend / normalTol - abs(sq.x - rough) / roughTol - far);
            sum += float4(compressColor(h.rgb * exposure), 1.0) * w;
        }
    }
    Write2D(gOut, p, float4(expandColor(sum.rgb / sum.w) / exposure, centre.a));
    RETURN();
}
#else
// The resolve, one full-size pass: this frame's reflection per pixel (the full-resolution trace, or the one
// reconstructed from the half-resolution rays) accumulated with last frame's into gOut. A tile with nothing to
// reflect writes zeros only when the texture doesn't hold zeros there already (gTiles), so most of a frame without
// glossy surfaces costs two reads per tile. Flags are read and written in different places, so no thread waits for another.
ROOT_SIGNATURE(ComputeRootSignature)
NUM_THREADS(8, 8, 1)
void CS_MAIN(SV_DispatchThreadID(uint3) id, SV_GroupID(uint3) gid, SV_GroupIndex(uint) gi)
{
    INIT_MAIN;
    int2 size = int2(gRt.screen.xy);
    int2 p = int2(id.xy);
    uint tile = gid.y * gRt.tiles.x + gid.x;
    bool traced = gTiles[gRt.tiles.z + tile] != 0u;
    bool zero = gTiles[gRt.zero.x + tile] != 0u && gRt.zero.z == 0u;
    if (gi == 0u)
    {
        gTiles[gRt.zero.y + tile] = traced ? 0u : 1u;
        gTiles[gRt.tiles.w + tile] = 0u; // next frame's trace marks it afresh
    }
    if (p.x >= size.x || p.y >= size.y || (!traced && zero))
        RETURN();
    if (traced)
        resolve(p);
    else
        Write2D(gOut, p, float4(0.0, 0.0, 0.0, 0.0));
    RETURN();
}
#endif
#endif

#if defined(PROBE_PASS)
// TEMPORARY (probe_rays): the shadow rays ray-traced shadows would cast from each pixel on screen, traced and thrown
// away to measure them: the sun's (towards a point on its disc), then local lights' (towards a point on the light,
// only where it reaches and faces the surface), probe.x in all. The result is kept only behind a write that never
// happens, so the rays can't be optimised out.
ROOT_SIGNATURE(ComputeRootSignature)
NUM_THREADS(8, 8, 1)
void CS_MAIN(SV_DispatchThreadID(uint3) id)
{
    INIT_MAIN;
    int2 p = int2(id.xy);
    int2 size = int2(gRt.screen.xy);
    if (p.x >= size.x || p.y >= size.y)
        RETURN();
    float d = LoadTex2D(gDepth, NO_SAMPLER, p, 0).r;
    if (d <= 0.0)
        RETURN();
    float4 surface = LoadTex2D(gSurface, NO_SAMPLER, p, 0);
    float  z = gRt.forward.w / d;
    float2 u = float2(p) + 0.5 - gRt.screen.zw;
    float2 ndc = float2(u.x / gRt.screen.x * 2.0 - 1.0, 1.0 - u.y / gRt.screen.y * 2.0);
    float3 P = gRt.camPos.xyz + gRt.right.xyz * (ndc.x * z / gRt.right.w) + gRt.up.xyz * (ndc.y * z / gRt.up.w) + gRt.forward.xyz * z;
    float3 N = normalize(surface.yzw);
    float3 origin = P + N * (0.001 * z + 0.004);
    float2 xi = sample2(p, gRt.counts.y);
    float  phi = xi.x * 2.0 * PI;
    float2 disc = sqrt(xi.y) * float2(cos(phi), sin(phi));
    uint   budget = gRt.probe.x;
    uint   hits = 0u;
    if (budget > 0u && gRt.sunDir.w > 0.5 && dot(N, gRt.sunDir.xyz) > 0.0)
    {
        float3 L = gRt.sunDir.xyz;
        float3 axis = abs(L.y) < 0.9 ? float3(0.0, 1.0, 0.0) : float3(1.0, 0.0, 0.0);
        float3 tx = normalize(cross(axis, L));
        float3 ty = cross(L, tx);
        RayDesc ray;
        ray.Origin = origin;
        ray.Direction = normalize(L + (tx * disc.x + ty * disc.y) * 0.0047); // the sun's angular radius
        ray.TMin = 0.0;
        ray.TMax = 1000.0;
        RayQueryAnyHit(gScene, RAY_TRAVERSAL_FLAG_DEFAULT, RT_RAY_FLAGS, ray, 2u, sunHit)
        RayQueryBeginForEachCandidate(sunHit)
        {
            if (!cutAway(RayQueryCandidateInstanceID(sunHit), RayQueryCandidatePrimitiveIndex(sunHit), RayQueryCandidateBarycentrics(sunHit)))
                RayQueryCommitCandidate(sunHit);
            RayQueryProceed(sunHit);
        }
        RayQueryEndForEachCandidate(sunHit)
        hits += RayQueryIsHit(sunHit) ? 1u : 0u;
    }
    uint  lights = min(budget > 0u ? budget - 1u : 0u, gRt.counts.x);
    float radius = max(gRt.shadow.w, 0.06);
    for (uint i = 0u; i < lights; ++i)
    {
        LightData l = gLights[i];
        float3 toLight = l.pos.xyz - P;
        float  d2 = dot(toLight, toLight);
        if (d2 >= l.pos.w * l.pos.w || dot(N, toLight) <= 0.0)
            continue;
        float3 target = l.pos.xyz + float3(disc.x, disc.y, xi.x - 0.5) * radius;
        float3 toTarget = target - origin;
        float  dist = length(toTarget);
        RayDesc ray;
        ray.Origin = origin;
        ray.Direction = toTarget / max(dist, 1e-4);
        ray.TMin = 0.0;
        ray.TMax = max(dist - radius, 0.0);
        RayQueryAnyHit(gScene, RAY_TRAVERSAL_FLAG_DEFAULT, RT_RAY_FLAGS, ray, 2u, probeHit)
        RayQueryBeginForEachCandidate(probeHit)
        {
            if (!cutAway(RayQueryCandidateInstanceID(probeHit), RayQueryCandidatePrimitiveIndex(probeHit), RayQueryCandidateBarycentrics(probeHit)))
                RayQueryCommitCandidate(probeHit);
            RayQueryProceed(probeHit);
        }
        RayQueryEndForEachCandidate(probeHit)
        hits += RayQueryIsHit(probeHit) ? 1u : 0u;
    }
    if (hits == gRt.counts.w + 100000u) // never: at most 9 hits
        Write2D(gOutHalf, int2(0, 0), float4(0.0, 0.0, 0.0, 0.0));
    RETURN();
}
#endif

#if defined(GI_PASS)
// renderer_gi's probe rays (giCounts.x probes, giCounts.y rays each; a thread a ray, probe-major): ray k of probe i from
// the probe's place along this frame's turned spherical Fibonacci direction k, against everything that casts a shadow
// (MASK_GI, opaque casters; lights' own emitters and markers don't, so the probes don't count a light twice), through
// every see-through instance between (MASK_GI_GLASS: what each layer lets through, as glassThrough, multiplies the
// light, as renderer_gi's raster captures draw them: a multiplicative layer, no light of its own). A hit is lit where it is
// as reflections' are (emission, the sun's ray, local lights through their maps, rays for at most GI_SHADOW_RAYS lights
// without one, the probes' own bounced light from last frame), then fogged over its distance; a hit on a back face
// writes no light and its distance negated (the probe is inside something), unless the surface is two-sided: then it is
// lit from that side, as renderer_gi's raster captures draw it; a miss the sky, fogged over the fog's range,
// and GI_MISS. Probes not traced this frame (giProbeTraced) leave their rays unwritten.
ROOT_SIGNATURE(ComputeRootSignature)
NUM_THREADS(64, 1, 1)
void CS_MAIN(SV_GroupID(uint3) gid, SV_GroupThreadID(uint3) tid)
{
    INIT_MAIN;
    uint rays = gRt.giCounts.y;
    uint index = (gid.y * gRt.giCounts.z + gid.x) * 64u + tid.x;
    uint probe = index / max(rays, 1u);
    if (probe >= gRt.giCounts.x)
        RETURN();
    uint   k = index - probe * rays;
    float4 data = gGiProbes[probe];
    if (!giProbeTraced(probe, data.w, gRt.giGrid[0]))
        RETURN();
    RayDesc ray;
    ray.Origin = giProbePosition(probe, data.xyz, gRt.giGrid[0], gRt.giGrid[1], gRt.giGrid[2]);
    ray.Direction = giRayDirection(k, rays, gRt.giRot[0], gRt.giRot[1], gRt.giRot[2]);
    ray.TMin = 0.0;
    ray.TMax = RT_FAR;
    RayQueryClosestHit(gScene, RAY_TRAVERSAL_FLAG_DEFAULT, RT_RAY_FLAGS, ray, MASK_GI, hit)
    RayQueryBeginForEachCandidate(hit)
    {
        if (!cutAway(RayQueryCandidateInstanceID(hit), RayQueryCandidatePrimitiveIndex(hit), RayQueryCandidateBarycentrics(hit)))
            RayQueryCommitCandidate(hit);
        RayQueryProceed(hit);
    }
    RayQueryEndForEachCandidate(hit)
    float4 result;
    if (!RayQueryIsHit(hit))
        result = float4(applyHeightFog(skyRadiance(ray.Direction) * gRt.sunColor.w, ray.Origin, ray.Direction, gRt.fogAlbedo.w), GI_MISS);
    else
    {
        float  t = RayQueryRayT(hit);
        uint   material;
        float3 N = hitNormal(RayQueryInstanceID(hit), RayQueryPrimitiveIndex(hit), RayQueryBarycentrics(hit), material);
        bool   back = dot(N, ray.Direction) > 0.0;
        if (back && (gRtInstances[RayQueryInstanceID(hit)].w & RT_INST_TWO_SIDED) == 0u)
            result = float4(0.0, 0.0, 0.0, -t);
        else
        {
            if (back)
                N = -N;
            float3 P = ray.Origin + ray.Direction * t;
            float  phi = float(pcgHash(index ^ (gRt.counts.y * 2654435761u)) & 0xFFFFu) * (2.0 * PI / 65536.0);
            // A probe ray's cone: its share of the sphere, sqrt(4 pi / rays) radians wide.
            float        occlusion;
            float        cone = t * sqrt(4.0 * PI / float(max(rays, 1u)));
            float3       Ng = N;
            MaterialData m = hitMaterial(RayQueryInstanceID(hit), RayQueryPrimitiveIndex(hit), RayQueryBarycentrics(hit), cone,
                                         ray.Direction, N, occlusion);
            m = hitDecals(P, Ng, ray.Direction, cone, m, N);
            float3 lit = shadeHit(P, N, -ray.Direction, m, occlusion, float2(cos(phi), sin(phi)), GI_SHADOW_RAYS, true, 1.0);
            result = float4(clampSample(applyHeightFog(lit, ray.Origin, ray.Direction, t)), t);
        }
    }
    // Glass between the probe and what its ray met (or the sky): the product of its layers, from a second ray that
    // only glass answers, up to the hit (any order: a product).
    if ((gRt.counts.z & FLAG_GLASS) != 0u && result.a > 0.0)
    {
        RayDesc glassRay = ray;
        glassRay.TMax = result.a == GI_MISS ? RT_FAR : result.a;
        float3 through = float3(1.0, 1.0, 1.0);
        RayQueryAnyHit(gScene, RAY_TRAVERSAL_FLAG_DEFAULT, RT_RAY_FLAGS, glassRay, MASK_GI_GLASS, layers)
        RayQueryBeginForEachCandidate(layers)
        {
            uint   ci = RayQueryCandidateInstanceID(layers);
            uint   cp = RayQueryCandidatePrimitiveIndex(layers);
            float2 cb = RayQueryCandidateBarycentrics(layers);
            if (!cutAway(ci, cp, cb))
                through *= glassThrough(ci, cp, cb, ray.Direction);
            RayQueryProceed(layers);
        }
        RayQueryEndForEachCandidate(layers)
        result.rgb *= through;
    }
    gGiRayOut[index] = result;
    RETURN();
}
#endif

#if defined(REFRACT_PASS)
// Glass that bends lets through how many layers of other glass the straight view to world point W (or along direction W,
// `sky`) crosses beyond view depth z (as the see-through pass draws them, before `self`): what the chain holds there.
uint glassBehind(float3 W, bool sky, float z, uint self)
{
    RayDesc ray;
    ray.Origin = gRt.camPos.xyz;
    ray.Direction = sky ? W : normalize(W - gRt.camPos.xyz);
    ray.TMin = 0.0;
    ray.TMax = sky ? gRt.params.x : max(length(W - gRt.camPos.xyz) - 1e-3, 0.0);
    float zPerT = dot(ray.Direction, gRt.forward.xyz);
    uint  count = 0u;
    RayQueryAnyHit(gScene, RAY_TRAVERSAL_FLAG_DEFAULT, RT_RAY_FLAGS, ray, MASK_GI_GLASS, straight)
    RayQueryBeginForEachCandidate(straight)
    {
        uint   ci = RayQueryCandidateInstanceID(straight);
        uint   cp = RayQueryCandidatePrimitiveIndex(straight);
        float2 cb = RayQueryCandidateBarycentrics(straight);
        if (ci != self && RayQueryCandidateRayT(straight) * zPerT > z && !cutAway(ci, cp, cb))
        {
            float3 g = glassThrough(ci, cp, cb, ray.Direction);
            if (min(g.r, min(g.g, g.b)) < 1.0)
                count += 1u;
        }
        RayQueryProceed(straight);
    }
    RayQueryEndForEachCandidate(straight)
    return count;
}

// On-screen refraction (frame rtRefraction, rtRefractLanding), a thread a pixel of the see-through instances' screen
// rectangle (refract.xy to refract.zw). The camera's ray through the pixel's centre (this frame's jittered projection, as
// the forward pass draws it) to the nearest glass layer that refracts and counts (Hit.h.fsl glassCounts) in front of the
// opaque depth; bent into and out of it as Forward.frag's refractedScene bends the view (refractThrough), then followed
// through the scene, deeper glass shaded (followRay). rgb what it brings back, as the chain would hold it there: fogged
// from the camera to the layer and on along the bent path; a the layer's view depth (0: none). Where what the bent ray
// meets is on screen, is what the depth shows there, and the straight view to it crosses as many other layers of glass
// as the bent path did, the landing says to read the chain there (it holds steam), with refractedScene's mip for the
// spread. Rough glass elsewhere takes one ray over its spread a frame, accumulated (CS_MAIN below).
STRUCT(Refracted)
{
    DATA(float4, color, None); // rgb this frame's sample, a the layer's view depth (0: no refracting layer)
    DATA(float4, land, None);  // rtRefractLanding's
    DATA(float4, prev, None);  // xyz where the layer's point was last frame, w 1 when known
    DATA(float, jittered, None); // 1: over the spreads (what the history accumulates)
    DATA(float, footprint, None); // how much the layer's view depth changes across the pixel (m)
};

Refracted refractAt(int2 p)
{
    Refracted o;
    o.color = float4(0.0, 0.0, 0.0, 0.0);
    o.land = float4(0.0, 0.0, 0.0, 0.0);
    o.prev = float4(0.0, 0.0, 0.0, 0.0);
    o.jittered = 0.0;
    o.footprint = 0.0;
    float2 u = float2(p) + 0.5 - gRt.screen.zw;
    float2 ndc = float2(u.x / gRt.screen.x * 2.0 - 1.0, 1.0 - u.y / gRt.screen.y * 2.0);
    float3 I = normalize(gRt.right.xyz * (ndc.x / gRt.right.w) + gRt.up.xyz * (ndc.y / gRt.up.w) + gRt.forward.xyz);
    float  zPerT = dot(I, gRt.forward.xyz);
    float  d = LoadTex2D(gDepth, NO_SAMPLER, p, 0).r;
    RayDesc view;
    view.Origin = gRt.camPos.xyz;
    view.Direction = I;
    view.TMin = gRt.forward.w / zPerT;
    view.TMax = d > 0.0 ? gRt.forward.w / d / zPerT : gRt.params.x + gRt.forward.w / zPerT;
    float glassT = view.TMax;
    uint4 tri = uint4(0xFFFFFFFFu, 0u, 0u, 0u);
    RayQueryClosestHit(gScene, RAY_TRAVERSAL_FLAG_DEFAULT, RT_RAY_FLAGS, view, MASK_GI_GLASS, toGlass)
    RayQueryBeginForEachCandidate(toGlass)
    {
        uint   ci = RayQueryCandidateInstanceID(toGlass);
        uint   cp = RayQueryCandidatePrimitiveIndex(toGlass);
        float2 cb = RayQueryCandidateBarycentrics(toGlass);
        float  ct = RayQueryCandidateRayT(toGlass);
        uint   material = (gRtInstances[ci].w & RT_INST_MATERIAL) - 1u;
        uint   mat;
        if (ct < glassT && gRefraction[material * 2u].w > 0.5 && !cutAway(ci, cp, cb) &&
            glassCounts(ci, material, dot(hitNormal(ci, cp, cb, mat), I) < 0.0))
        {
            glassT = ct;
            tri = uint4(ci, cp, asuint(cb));
        }
        RayQueryProceed(toGlass);
    }
    RayQueryEndForEachCandidate(toGlass)
    if (tri.x == 0xFFFFFFFFu)
        return o;

    // The layer, its shading normal (after its maps) towards the camera.
    float3       G = gRt.camPos.xyz + I * glassT;
    float        zG = glassT * zPerT;
    float2       gb = asfloat(tri.zw);
    uint         material;
    float3       N = hitNormal(tri.x, tri.y, gb, material);
    if (dot(N, I) > 0.0)
        N = -N;
    float        pixelAngle = 2.0 / (gRt.up.w * gRt.screen.y);
    float        occlusion, alpha;
    MaterialData m = hitMaterialAlpha(tri.x, tri.y, gb, zG * pixelAngle, I, N, occlusion, alpha);
    float4       refr = gRefraction[material * 2u];
    float3       E, D;
    refractThrough(G, N, I, refr, E, D);
    float  ior = max(refr.x, 1.0);
    float  a = m.albedoRough.a * m.albedoRough.a;
    float  spread = 2.0 * a * (1.0 - 1.0 / ior);
    float  inside = length(E - G);
    float2 cone = float2(0.0, pixelAngle); // a pixel's footprint, on from the camera
    float  travelled = glassT + inside;
    RayDesc ray;
    ray.Origin = inside > 0.0 ? E - D * min(5e-4, 0.25 * inside) : G + D * (2e-4 + 1e-5 * glassT);
    ray.Direction = D;
    ray.TMin = 0.0;
    ray.TMax = max(gRt.params.x - travelled, 1e-3);
    uint seq = gRt.counts.y;
    Hit  h = followRay(ray, p, seq, p, cone, 1u, travelled, spread, spread * glassT, false, tri.x, false);

    // Where it lands on screen (this frame's jittered pixels), if what it meets is what the depth shows there.
    float4 land = float4(0.0, 0.0, 0.0, 0.0);
    bool   sky = h.result.a == RT_MISS;
    float3 Hp = sky ? D : h.pos.xyz;
    float4 c = sky ? float4(dot(gRt.viewProj[0].xyz, D), dot(gRt.viewProj[1].xyz, D), dot(gRt.viewProj[2].xyz, D), dot(gRt.viewProj[3].xyz, D))
                   : clipOf(gRt.viewProj, Hp);
    if (c.w > (sky ? 1e-4 : gRt.forward.w))
    {
        float2 q = (c.xy / c.w * float2(0.5, -0.5) + 0.5) * gRt.screen.xy + gRt.screen.zw;
        if (q.x >= 0.0 && q.y >= 0.0 && q.x < gRt.screen.x && q.y < gRt.screen.y)
        {
            float dq = LoadTex2D(gDepth, NO_SAMPLER, int2(q), 0).r;
            bool  seen = sky ? dq <= 0.0 : dq > 0.0 && abs(gRt.forward.w / dq - c.w) < 0.02 * c.w + 0.03;
            if (seen && glassBehind(Hp, sky, zG, tri.x) == h.others)
            {
                // refractedScene's mip: the spread over the way behind, at the landing's depth (the sky's: its angle).
                float behind = sky ? 1.0 / max(dot(gRt.forward.xyz, D), 0.1) : length(Hp - E) / max(c.w, gRt.forward.w);
                float px = spread * behind * 0.5 * gRt.screen.y * gRt.up.w;
                land = float4(q - (float2(p) + 0.5), log2(max(px, 1.0)), 1.0);
            }
        }
    }

    // What it brings back: through rough glass (this layer or deeper) off the screen's landing, over their spreads, one
    // ray a frame, accumulated.
    float n = 0.0;
    if (land.w < 0.5 && spread + h.spread > 1e-5)
    {
        float2 u2 = sample2(p + int2(37, 91), seq);
        float3 axis = abs(D.y) < 0.9 ? float3(0.0, 1.0, 0.0) : float3(1.0, 0.0, 0.0);
        float3 tx = normalize(cross(axis, D));
        float3 ty = cross(D, tx);
        float  r = 0.5 * spread * sqrt(u2.x);
        float  ph = 2.0 * PI * u2.y;
        ray.Direction = normalize(D + (tx * cos(ph) + ty * sin(ph)) * tan(r));
        h = followRay(ray, p, seq, p, cone, 1u, travelled, spread, spread * glassT, false, tri.x, true);
        n = 1.0;
    }
    float4 behind = h.result.a >= 0.0 ? h.result : lightHit(h, p);
    o.color = float4(applyHeightFog(overGlass(h, behind).rgb, gRt.camPos.xyz, I, glassT), zG);
    o.land = land;
    o.jittered = n;
    // Where it was last frame (gRtInstances' last-frame rows, all zero where it has none), and how fast the layer's
    // depth changes across the pixel there (grazing glass: a pixel's jitter moves it far).
    uint   rows = uint(gRt.refractTemporal.z) + tri.x * 3u;
    float4 r0 = asfloat(gRtInstances[rows]);
    float4 r1 = asfloat(gRtInstances[rows + 1u]);
    float4 r2 = asfloat(gRtInstances[rows + 2u]);
    if (dot(abs(r0), float4(1.0, 1.0, 1.0, 1.0)) > 0.0)
        o.prev = float4(dot(r0, float4(G, 1.0)), dot(r1, float4(G, 1.0)), dot(r2, float4(G, 1.0)), 1.0);
    float cosI = max(abs(dot(N, I)), 0.05);
    o.footprint = zG * pixelAngle * sqrt(max(1.0 - cosI * cosI, 0.0)) / cosI;
    return o;
}

// The samples' colour in the group (compressed YCoCg, exposed; w 1 where the pixel has a refracting layer): the
// neighbourhood the history is clipped to.
GroupShared(float4, gsRefract[64]);
#define REFRACT_CLIP 1.25 // the box: the neighbourhood's mean +- this many standard deviations, as the reflections'

ROOT_SIGNATURE(ComputeRootSignature)
NUM_THREADS(8, 8, 1)
void CS_MAIN(SV_DispatchThreadID(uint3) id, SV_GroupThreadID(uint3) tid)
{
    INIT_MAIN;
    int2      size = int2(gRt.screen.xy);
    int2      p = int2(id.xy) + int2(gRt.refract.xy);
    bool      inRect = p.x < int(gRt.refract.z) && p.y < int(gRt.refract.w);
    Refracted r;
    r.color = float4(0.0, 0.0, 0.0, 0.0);
    r.land = float4(0.0, 0.0, 0.0, 0.0);
    r.prev = float4(0.0, 0.0, 0.0, 0.0);
    r.jittered = 0.0;
    r.footprint = 0.0;
    if (inRect)
        r = refractAt(p);
    float exposure = max(gExposure[1], 1e-8);
    bool  has = r.color.a > 0.0;
    gsRefract[tid.y * 8u + tid.x] = has ? float4(toYCoCg(compressColor(max(r.color.rgb, float3(0.0, 0.0, 0.0)) * exposure)), 1.0)
                                        : float4(0.0, 0.0, 0.0, 0.0);
    GroupMemoryBarrier();
    if (!inRect)
        RETURN();

    // Last frame's, where this layer's point was then (followed on moving glass), if it was this layer there: its depth
    // within the pixel's footprint. Clipped to this frame's neighbourhood, so it gives way where what is behind changed.
    float  hn = 0.0;
    float3 hist = float3(0.0, 0.0, 0.0);
    bool   have = false;
    if (has && gRt.refractTemporal.x > 0.5 && r.prev.w > 0.5)
    {
        float4 pc = clipOf(gRt.prevViewProj, r.prev.xyz);
        if (pc.w > gRt.forward.w)
        {
            float2 qf = (pc.xy / pc.w * float2(0.5, -0.5) + 0.5) * gRt.screen.xy;
            int2   q = int2(floor(qf));
            if (q.x >= 0 && q.y >= 0 && q.x < size.x && q.y < size.y)
            {
                float4 h = LoadTex2D(gRefractHistory, NO_SAMPLER, q, 0);
                hn = LoadTex2D(gRefractHistoryN, NO_SAMPLER, q, 0).r;
                have = hn > 0.0 && abs(h.a - pc.w) < 0.01 * pc.w + 0.01 + r.footprint;
                hist = h.rgb;
            }
        }
    }
    if (have)
    {
        float3 m1 = float3(0.0, 0.0, 0.0), m2 = float3(0.0, 0.0, 0.0);
        float  k = 0.0;
        for (int dy = -1; dy <= 1; ++dy)
            for (int dx = -1; dx <= 1; ++dx)
            {
                int2 g = int2(tid.xy) + int2(dx, dy);
                if (g.x >= 0 && g.y >= 0 && g.x < 8 && g.y < 8)
                {
                    float4 c = gsRefract[uint(g.y) * 8u + uint(g.x)];
                    m1 += c.xyz * c.w;
                    m2 += c.xyz * c.xyz * c.w;
                    k += c.w;
                }
            }
        m1 /= k;
        float3 sigma = sqrt(max(m2 / k - m1 * m1, float3(0.0, 0.0, 0.0)));
        float  outside;
        float3 hc = clipToBox(toYCoCg(compressColor(max(hist, float3(0.0, 0.0, 0.0)) * exposure)), m1 - sigma * REFRACT_CLIP,
                              m1 + sigma * REFRACT_CLIP, outside);
        hist = expandColor(fromYCoCg(hc)) / exposure;
    }
    float3 rgb = r.color.rgb;
    float  n = 0.0;
    if (r.jittered > 0.5)
    {
        // Over the spreads: one more sample of it.
        n = have ? min(hn + 1.0, gRt.refractTemporal.y) : 1.0;
        rgb = have ? lerp(hist, rgb, 1.0 / n) : rgb;
    }
    else if (have && r.land.w > 0.5)
    {
        // The screen's landing this frame (the core reads the chain, not rgb): kept, for when the landing leaves it again.
        n = hn;
        rgb = hist;
    }
    float4 land = r.land;
    if ((gRt.counts.z & FLAG_DEBUG) != 0u && has)
    {
        // show_hits: green where the landing was on screen, blue where it was found by rays.
        rgb = land.w > 0.5 ? float3(0.0, 1.0, 0.0) : float3(0.0, 0.0, 1.0);
        land.w = 0.0;
    }
    Write2D(gOutRefract, p, float4(rgb, r.color.a));
    Write2D(gOutRefractLand, p, land);
    Write2D(gOutRefractN, p, n);
    RETURN();
}
#endif
