// Ray-traced reflections: per pixel below the roughness limit, the reflected ray (one microfacet normal per
// pixel and frame from the GGX distribution of visible normals, Dupuy & Benyoub 2023, driven by a
// low-discrepancy sequence; Temporal.comp.fsl averages them into the lobe) traced with an inline ray query
// against the scene's acceleration structure. What it hits gets its colour from last frame's anti-aliased
// image where the hit is visible on screen (fully lit, with every shadow), verified against the depth there,
// so a hidden or off-screen hit is never mistaken for what stands in front of it; elsewhere it is lit at the
// hit: the sun (with a shadow ray), local lights, the sky's light, emission. A miss sees the sky.
#include "fsl_ext.h"

#include "RtData.h.fsl"

STRUCT(InstanceData)
{
    DATA(float4, row0, None);
    DATA(float4, row1, None);
    DATA(float4, row2, None);
    DATA(uint4, misc, None); // x material
};

STRUCT(MaterialData)
{
    DATA(float4, albedoRough, None);
    DATA(float4, params, None);  // x metallic, y f0 (dielectric), z reflections on
    DATA(float4, emissive, None);
};

STRUCT(LightData)
{
    DATA(float4, pos, None);     // xyz, w range
    DATA(float4, color, None);   // rgb candela, w type (1 point, 2 spot)
    DATA(float4, dir, None);     // xyz spot direction, w spot scale
    DATA(float4, params, None);  // x spot offset, y first shadow view (-1: no map), z 1/range^2, w 1: casts shadows in
                                 // the scene (it may still have no map: outside the view or over the budget)
    DATA(float4, sphere, None);
};

STRUCT(ShadowView)
{
    DATA(float4, row0, None);
    DATA(float4, row1, None);
    DATA(float4, row2, None);
    DATA(float4, row3, None);
    DATA(float4, rect, None); // tile: u, v, width, height
    DATA(float4, info, None); // x texel world size at distance 1, yzw where a point light's cube was drawn
    DATA(float4, inv0, None);
    DATA(float4, inv1, None);
    DATA(float4, inv2, None);
};

#include "Trace.srt.h"
#include "Shadow.h.fsl"

#define PI 3.14159265
#define RT_MISS 60000.0
#define FLAG_SCREEN 1u
#define FLAG_DEBUG 4u
// How a hit's local lights are shadowed (shadowMode.y). The sun always takes a ray.
#define SHADOWS_SCENE 0u // as the scene: from the light's shadow map where it has one, else a ray
#define SHADOWS_RAYS 1u  // a ray for every light (the scene's ray-traced mode, or the comparison knob)
#define SHADOWS_OFF 2u   // none
#define MAX_HIT_LIGHTS 64u
#define MAX_SHADOW_RAYS 8u
// Every instance is opaque triangles: no procedural primitives to test for (only Direct3D 12 has the flag).
#if defined(RAY_FLAG_SKIP_AABB)
#define RT_RAY_FLAGS (RAY_FLAG_FORCE_OPAQUE | RAY_FLAG_SKIP_AABB)
#else
#define RT_RAY_FLAGS RAY_FLAG_FORCE_OPAQUE
#endif

float noise2(float2 p) { return frac(52.9829189 * frac(dot(p, float2(0.06711056, 0.00583715)))); }

// Pixel p's sample for this frame: interleaved gradient noise across the screen (so neighbours differ), stepped
// through the R2 sequence over frames (so a pixel's samples cover the lobe evenly, not at random).
float2 sample2(int2 p)
{
    float2 offset = float2(noise2(float2(p)), noise2(float2(p.yx) + 17.0));
    return frac(offset + float(gRt.counts.y) * float2(0.7548776662, 0.5698402910));
}

// A GGX visible normal (tangent space, z the normal) for view direction v and roughness alpha: spherical caps.
float3 sampleVndf(float3 v, float alpha, float2 u)
{
    float3 vh = normalize(float3(alpha * v.x, alpha * v.y, v.z));
    float  phi = 2.0 * PI * u.x;
    float  z = (1.0 - u.y) * (1.0 + vh.z) - vh.z;
    float  s = sqrt(saturate(1.0 - z * z));
    float3 h = float3(s * cos(phi), s * sin(phi), z) + vh;
    return normalize(float3(alpha * h.x, alpha * h.y, max(h.z, 1e-6)));
}

float luminance(float3 c) { return dot(c, float3(0.2126, 0.7152, 0.0722)); }

// Caps a sample's brightness: a ray now and then finding a light or a bright spot would otherwise flash.
float3 clampSample(float3 c)
{
    float l = luminance(c) * gExposure[1];
    return l > gRt.temporal.z ? c * (gRt.temporal.z / l) : c;
}

float3 skyRadiance(float3 d)
{
    if (d.y >= 0.0)
        return lerp(gRt.skyHorizon.rgb, gRt.skyZenith.rgb, sqrt(saturate(d.y)));
    return lerp(gRt.skyHorizon.rgb, gRt.skyGround.rgb, saturate(-d.y * 3.0));
}

float3 skyIrradiance(float3 N)
{
    float3 up = lerp(gRt.skyHorizon.rgb, gRt.skyZenith.rgb, 0.6);
    float3 down = lerp(gRt.skyHorizon.rgb, gRt.skyGround.rgb, 0.85);
    return lerp(down, up, N.y * 0.5 + 0.5);
}

float3 vertexNormal(uint v)
{
    return float3(asfloat(gVertices[v * 6u + 3u]), asfloat(gVertices[v * 6u + 4u]), asfloat(gVertices[v * 6u + 5u]));
}

// GGX with height-correlated Smith visibility and Schlick's Fresnel, as the core's forward pass.
float3 brdfLight(float3 N, float3 V, float3 L, float3 diffuse, float3 f0, float a2, float3 E)
{
    float NoL = saturate(dot(N, L));
    if (NoL <= 0.0)
        return float3(0.0, 0.0, 0.0);
    float3 H = normalize(V + L);
    float  NoH = saturate(dot(N, H));
    float  NoV = max(dot(N, V), 1e-3);
    float  VoH = saturate(dot(V, H));
    float  d = (NoH * a2 - NoH) * NoH + 1.0;
    float  D = a2 / (PI * d * d);
    float  gv = NoL * sqrt(NoV * NoV * (1.0 - a2) + a2);
    float  gl = NoV * sqrt(NoL * NoL * (1.0 - a2) + a2);
    float  Vis = 0.5 / max(gv + gl, 1e-5);
    float3 F = f0 + (float3(1.0, 1.0, 1.0) - f0) * pow(1.0 - VoH, 5.0);
    return (diffuse * (1.0 / PI) + D * Vis * F) * E * NoL;
}

// Whether anything is between P and a light along L, up to tMax (one any-hit ray).
float lightVisible(float3 P, float3 L, float tMax)
{
    if (gRt.shadowMode.y == SHADOWS_OFF)
        return 1.0;
    RayDesc shadowRay;
    shadowRay.Origin = P;
    shadowRay.Direction = L;
    shadowRay.TMin = 0.0;
    shadowRay.TMax = tMax;
    RayQueryAnyHit(gScene, RAY_TRAVERSAL_FLAG_DEFAULT, RT_RAY_FLAGS, shadowRay, 2u, occluded) // casters only
    return RayQueryIsHit(occluded) ? 0.0 : 1.0;
}

// The hit lit where it is: emission, the sun (shadowed by a ray), local lights (those in view nearest first, then
// the rest; shadowed by their maps or rays, shadowMode.y) and the sky's light. rot turns the maps' filter.
float3 shadeHit(float3 P, float3 N, float3 V, MaterialData m, float2 rot)
{
    float  metallic = saturate(m.params.x);
    float3 albedo = m.albedoRough.rgb;
    float3 diffuse = albedo * (1.0 - metallic);
    float3 f0 = lerp(float3(m.params.y, m.params.y, m.params.y), albedo, metallic);
    float  rough = clamp(m.albedoRough.a, 0.03, 1.0);
    float  a2 = rough * rough;
    a2 *= a2;
    float3 color = m.emissive.rgb;
    float3 offset = P + N * 0.01;
    if (gRt.sunDir.w > 0.5)
    {
        float3 L = gRt.sunDir.xyz;
        if (dot(N, L) > 0.0)
            color += brdfLight(N, V, L, diffuse, f0, a2, gRt.sunColor.rgb * lightVisible(offset, L, 1000.0));
    }
    uint  lights = min(gRt.counts.x, MAX_HIT_LIGHTS);
    uint  rays = 0u;
    float exposure = gExposure[1];
    for (uint i = 0u; i < lights; ++i)
    {
        LightData l = gLights[i];
        float3 toLight = l.pos.xyz - P;
        float  d2 = dot(toLight, toLight);
        if (d2 >= l.pos.w * l.pos.w)
            continue;
        float  invDist = rsqrt(max(d2, 1e-8));
        float3 L = toLight * invDist;
        float  f = d2 * l.params.z;
        float  window = saturate(1.0 - f * f);
        float  atten = window * window / max(d2, 1e-4);
        if (l.color.w > 1.5)
        {
            float cone = saturate(dot(-L, l.dir.xyz) * l.dir.w + l.params.x);
            atten *= cone * cone;
        }
        float NoL = dot(N, L);
        if (atten <= 0.0 || NoL <= 0.0)
            continue;
        float3 lit = brdfLight(N, V, L, diffuse, f0, a2, l.color.rgb * atten);
        // A shadow only where the light could be seen (as the forward pass skips its shadow lookups). As the
        // scene: the light's map where it has one; a ray where it casts in the scene but has no map (outside the
        // view or over the budget: unshadowed it would be wrong); none where it doesn't cast. Rays: one for
        // every light. At most MAX_SHADOW_RAYS rays per hit.
        if (gRt.shadowMode.y != SHADOWS_OFF && max(lit.r, max(lit.g, lit.b)) * exposure >= 1.0 / 4096.0)
        {
            bool rayAll = gRt.shadowMode.y == SHADOWS_RAYS;
            if (!rayAll && l.params.y >= 0.0 && gRt.shadowMode.w != 0u)
                lit *= localShadow(l, P, N, d2 * invDist, NoL, rot);
            else if ((rayAll || l.params.w > 0.5) && rays < MAX_SHADOW_RAYS)
            {
                lit *= lightVisible(offset, L, max(d2 * invDist - 0.05, 0.0));
                rays += 1u;
            }
        }
        color += lit;
    }
    float  ambient = gRt.sunColor.w;
    float3 R = reflect(-V, N);
    color += (diffuse * skyIrradiance(N) + f0 * lerp(skyRadiance(R), skyIrradiance(R), rough)) * ambient;
    return color;
}

float4 clipOf(float4 rows[4], float3 W)
{
    float4 w = float4(W, 1.0);
    return float4(dot(rows[0], w), dot(rows[1], w), dot(rows[2], w), dot(rows[3], w));
}

// A hit that still has to be lit where it is (what the screen doesn't show): its position and distance, normal
// (towards the ray), the ray's direction and how much of it the screen shows, that screen colour, its material.
STRUCT(Hit)
{
    DATA(float4, result, None); // the finished sample (rgb, a distance; 0: not traced, RT_MISS: the sky); a < 0: light it
    DATA(float4, pos, None);    // xyz the hit, w its distance
    DATA(float4, normal, None); // xyz
    DATA(float4, ray, None);    // xyz the ray's direction, w the screen's share
    DATA(float4, screen, None); // rgb the screen's colour
    DATA(uint, material, None);
};

// Traces pixel p's reflected ray (surface and d: its surface and depth). What the screen shows, the sky and
// untraced pixels come back finished; a hit to light where it is comes back with result.a < 0 (lightHit).
Hit traceRay(int2 p, float4 surface, float d)
{
    Hit o;
    o.result = float4(0.0, 0.0, 0.0, 0.0);
    o.pos = float4(0.0, 0.0, 0.0, 0.0);
    o.normal = float4(0.0, 0.0, 0.0, 0.0);
    o.ray = float4(0.0, 0.0, 0.0, 0.0);
    o.screen = float4(0.0, 0.0, 0.0, 0.0);
    o.material = 0u;
    int2   size = int2(gRt.screen.xy);
    float  rough = surface.x;
    if (d <= 0.0 || rough >= gRt.camPos.w)
        return o;

    // The pixel's world position, from depth (reversed-Z, infinite far), undoing the TAA jitter it was drawn with.
    float  z = gRt.forward.w / d;
    float2 u = float2(p) + 0.5 - gRt.screen.zw;
    float2 ndc = float2(u.x / gRt.screen.x * 2.0 - 1.0, 1.0 - u.y / gRt.screen.y * 2.0);
    float3 P = gRt.camPos.xyz + gRt.right.xyz * (ndc.x * z / gRt.right.w) + gRt.up.xyz * (ndc.y * z / gRt.up.w) + gRt.forward.xyz * z;
    float3 N = normalize(surface.yzw);
    float3 V = normalize(gRt.camPos.xyz - P);

    // The reflected ray, about one visible microfacet normal; a mirror stays a mirror.
    float  alpha = rough * rough;
    float3 R = reflect(-V, N);
    if (alpha > 1e-3)
    {
        float3 axis = abs(N.y) < 0.9 ? float3(0.0, 1.0, 0.0) : float3(1.0, 0.0, 0.0);
        float3 tx = normalize(cross(axis, N));
        float3 ty = cross(N, tx);
        float3 v = float3(dot(V, tx), dot(V, ty), max(dot(V, N), 1e-4));
        float3 h = sampleVndf(v, alpha, sample2(p));
        float3 Rj = reflect(-V, tx * h.x + ty * h.y + N * h.z);
        if (dot(Rj, N) > 0.0)
            R = Rj;
    }

    RayDesc ray;
    ray.Origin = P + N * (0.001 * z + 0.004); // off the surface, more further away where depth is coarser
    ray.Direction = R;
    ray.TMin = 0.0;
    ray.TMax = gRt.params.x;
    RayQueryClosestHit(gScene, RAY_TRAVERSAL_FLAG_DEFAULT, RT_RAY_FLAGS, ray, 1u, hit)
    bool debug = (gRt.counts.z & FLAG_DEBUG) != 0u;
    if (!RayQueryIsHit(hit))
    {
        float3 sky = skyRadiance(R) * gRt.sunColor.w;
        o.result = float4(debug ? float3(0.5, 0.5, 0.5) : clampSample(sky), RT_MISS);
        return o;
    }
    float  t = RayQueryRayT(hit);
    uint   index = RayQueryInstanceID(hit);
    uint   prim = RayQueryPrimitiveIndex(hit);
    float2 bary = RayQueryBarycentrics(hit);
    float3 Hp = ray.Origin + R * t;
    // How much of the hit to take from the screen: visible there now (its depth matches) and last frame.
    float  screenWeight = 0.0;
    float3 screenColor = float3(0.0, 0.0, 0.0);
    if ((gRt.counts.z & FLAG_SCREEN) != 0u)
    {
        float4 c = clipOf(gRt.viewProj, Hp);
        float4 pc = clipOf(gRt.prevViewProj, Hp);
        if (c.w > gRt.forward.w && pc.w > gRt.forward.w)
        {
            float2 uv = c.xy / c.w * float2(0.5, -0.5) + 0.5;
            float2 uvPrev = pc.xy / pc.w * float2(0.5, -0.5) + 0.5;
            float2 edge = min(min(uv, 1.0 - uv), min(uvPrev, 1.0 - uvPrev));
            float  inside = saturate(min(edge.x, edge.y) / gRt.params.y);
            if (inside > 0.0)
            {
                int2  q = clamp(int2(uv * gRt.screen.xy), int2(0, 0), size - int2(1, 1));
                float seen = gRt.forward.w / max(LoadTex2D(gDepth, NO_SAMPLER, q, 0).r, 1e-7);
                if (abs(seen - c.w) < 0.02 * c.w + 0.03)
                {
                    screenWeight = inside;
                    screenColor = SampleLvlTex2D(gPrevious, gSamplerBilinearClamp, uvPrev, 0.0).rgb;
                }
            }
        }
    }
    if (screenWeight >= 1.0)
    {
        o.result = float4(clampSample(debug ? float3(0.0, 1.0, 0.0) : screenColor), max(t, 1e-3));
        return o;
    }
    uint4        inst = gRtInstances[index]; // x instance row, y first index, z first vertex
    InstanceData row = gInstances[inst.x];
    uint         i0 = gIndices[inst.y + prim * 3u] + inst.z;
    uint         i1 = gIndices[inst.y + prim * 3u + 1u] + inst.z;
    uint         i2 = gIndices[inst.y + prim * 3u + 2u] + inst.z;
    float3       n = vertexNormal(i0) * (1.0 - bary.x - bary.y) + vertexNormal(i1) * bary.x + vertexNormal(i2) * bary.y;
    // Object to world through the cofactor matrix (right for non-uniform scale), as the forward pass.
    float3 c0 = cross(row.row1.xyz, row.row2.xyz);
    float3 c1 = cross(row.row2.xyz, row.row0.xyz);
    float3 c2 = cross(row.row0.xyz, row.row1.xyz);
    float3 Nh = normalize(float3(dot(c0, n), dot(c1, n), dot(c2, n)));
    if (dot(Nh, R) > 0.0)
        Nh = -Nh; // the side the ray came from
    o.result = float4(0.0, 0.0, 0.0, -1.0);
    o.pos = float4(Hp, t);
    o.normal = float4(Nh, 0.0);
    o.ray = float4(R, screenWeight);
    o.screen = float4(screenColor, 0.0);
    o.material = row.misc.x;
    return o;
}

// A hit traceRay left to light (for pixel p): lit where it is, blended with what the screen shows of it.
float4 lightHit(float4 pos, float4 normal, float4 ray, float3 screen, uint material, int2 p)
{
    // The maps' filter turned per pixel and frame, as the core's (TAA averages it).
    float  phi = noise2(float2(p) + float(gRt.counts.y) * 5.588238) * 2.0 * PI;
    float3 lit = shadeHit(pos.xyz, normal.xyz, -ray.xyz, gMaterials[material], float2(cos(phi), sin(phi)));
    float3 color = lerp(lit, screen, ray.w);
    if ((gRt.counts.z & FLAG_DEBUG) != 0u)
        color = float3(0.0, ray.w, 1.0 - ray.w);
    return float4(clampSample(color), max(pos.w, 1e-3));
}

// What pixel p's reflected ray sees: rgb, a its distance (0: not traced, RT_MISS: the sky).
float4 tracePixel(int2 p, float4 surface, float d)
{
    Hit h = traceRay(p, surface, d);
    if (h.result.a >= 0.0)
        return h.result;
    return lightHit(h.pos, h.normal, h.ray, h.screen.rgb, h.material, p);
}

// Half resolution: each 2 x 2 block traces one pixel, a different one each frame (TAA gathers them).
int2 blockOffset()
{
    uint k = gRt.counts.y % 4u;
    return int2(k == 1u || k == 2u ? 1 : 0, k == 1u || k == 3u ? 1 : 0);
}

#if defined(TRACE_PASS)
// The trace, one thread per 2 x 2 block of pixels, so a quarter of the threads trace at half resolution with
// none idle: its pixels smoother than the full-resolution threshold (params.z; every glossy pixel with
// half_resolution off) into gOutFull, then with half_resolution on the block's pixel for this frame (unless it is
// one of those) into gOutHalf. A pixel that reflects marks its 8 x 8 tile in gTiles (cleared by last frame's
// resolve), so the resolve skips the others.
// It runs in five rounds (the block's four pixels at full resolution, then its half-resolution one). Each
// round traces one pixel per thread, and the hits to light where they are (shadow rays and the lights' loop,
// most of the cost where the reflection shows what is off screen) go into a list the whole group then lights,
// one hit per thread: lit inline, a thread with such a hit kept its whole warp waiting while the others had
// none. Two lists alternate, so one barrier a round keeps a list from being refilled while it is read.
#define GROUP_THREADS 64u
GroupShared(float4, gsPos[2 * GROUP_THREADS]);
GroupShared(float4, gsNormal[2 * GROUP_THREADS]);
GroupShared(float4, gsRay[2 * GROUP_THREADS]);
GroupShared(float4, gsScreen[2 * GROUP_THREADS]);
GroupShared(uint2, gsWhere[2 * GROUP_THREADS]); // x the pixel (x | y << 15 | 1 << 30 for gOutHalf), y the material
GroupShared(uint, gsCount[5]);

ROOT_SIGNATURE(ComputeRootSignature)
NUM_THREADS(8, 8, 1)
void CS_MAIN(SV_DispatchThreadID(uint3) id, SV_GroupIndex(uint) gi)
{
    INIT_MAIN;
    int2 size = int2(gRt.screen.xy);
    int2 b = int2(id.xy);
    bool inside = b.x < (size.x + 1) / 2 && b.y < (size.y + 1) / 2;
    if (gi < 5u)
        gsCount[gi] = 0u;
    GroupMemoryBarrier();
    bool reflects = false;
    for (uint k = 0u; k < 5u; ++k)
    {
        // This round's pixel: one of the block's four at full resolution, or its half-resolution one.
        bool   isHalf = k == 4u;
        int2   p = isHalf ? min(b * 2 + blockOffset(), size - int2(1, 1)) : b * 2 + int2(int(k & 1u), int(k >> 1u));
        float4 surface = float4(1.0, 0.0, 0.0, 0.0);
        if (inside && p.x < size.x && p.y < size.y)
            surface = LoadTex2D(gSurface, NO_SAMPLER, p, 0);
        bool glossy = surface.x < gRt.camPos.w;
        reflects = reflects || (glossy && !isHalf);
        bool trace = glossy && (isHalf ? gRt.temporal.w > 0.5 && surface.x >= gRt.params.z : surface.x < gRt.params.z);
        uint list = (k & 1u) * GROUP_THREADS;
        if (trace)
        {
            Hit h = traceRay(p, surface, LoadTex2D(gDepth, NO_SAMPLER, p, 0).r);
            if (h.result.a >= 0.0)
            {
                if (isHalf)
                    Write2D(gOutHalf, b, h.result);
                else
                    Write2D(gOutFull, p, h.result);
            }
            else
            {
                uint at;
                AtomicAdd(gsCount[k], 1u, at);
                int2 q = isHalf ? b : p;
                gsPos[list + at] = h.pos;
                gsNormal[list + at] = h.normal;
                gsRay[list + at] = h.ray;
                gsScreen[list + at] = h.screen;
                gsWhere[list + at] = uint2(uint(q.x) | (uint(q.y) << 15u) | (isHalf ? 1u << 30u : 0u), h.material);
            }
        }
        else if (isHalf && inside && gRt.temporal.w > 0.5)
            Write2D(gOutHalf, b, float4(0.0, 0.0, 0.0, 0.0));
        GroupMemoryBarrier();
        if (gi < gsCount[k])
        {
            uint2  where = gsWhere[list + gi];
            int2   q = int2(int(where.x & 0x7FFFu), int((where.x >> 15u) & 0x7FFFu));
            float4 v = lightHit(gsPos[list + gi], gsNormal[list + gi], gsRay[list + gi], gsScreen[list + gi].rgb, where.y, q);
            if ((where.x >> 30u) != 0u)
                Write2D(gOutHalf, q, v);
            else
                Write2D(gOutFull, q, v);
        }
    }
    if (reflects)
        gTiles[gRt.tiles.z + (b.y >> 2) * gRt.tiles.x + (b.x >> 2)] = 1u;
    RETURN();
}
#endif

#if defined(TRACE_RESOLVE)
// A full-resolution pixel from the four nearest half-resolution samples, each weighted by how close it lies,
// by how well its depth and normal match this pixel's, so reflections don't bleed across edges or creases,
// and by its inverse brightness (Karis 2014), so one bright sample can't spread over its neighbours. Pixels no
// sample matches are traced here.
float4 upsample(int2 p, float4 surface, float d)
{
    int2   size = int2(gRt.screen.xy);
    int2   o = blockOffset();
    int2   halfSize = (size + int2(1, 1)) / 2;
    int2   base = (p - o) >> 1;
    float2 f = float2(p - o) * 0.5 - float2(base);
    float  zp = gRt.forward.w / d;
    float3 Np = normalize(surface.yzw);
    float  exposure = gExposure[1];
    float4 sum = float4(0.0, 0.0, 0.0, 0.0);
    float  wsum = 0.0;
    float  match = 0.0; // the weights before the brightness one: whether any sample fits
    for (uint i = 0u; i < 4u; ++i)
    {
        int2   dq = int2(int(i & 1u), int(i >> 1u));
        int2   q = clamp(base + dq, int2(0, 0), halfSize - int2(1, 1));
        float4 v = LoadTex2D(gHalfIn, NO_SAMPLER, q, 0);
        if (v.a <= 0.0)
            continue;
        int2   s = min(q * 2 + o, size - int2(1, 1));
        float  zs = gRt.forward.w / max(LoadTex2D(gDepth, NO_SAMPLER, s, 0).r, 1e-7);
        float3 Ns = normalize(LoadTex2D(gSurface, NO_SAMPLER, s, 0).yzw);
        float  bx = dq.x == 1 ? f.x : 1.0 - f.x;
        float  by = dq.y == 1 ? f.y : 1.0 - f.y;
        float  w = (bx * by + 0.05) * saturate(1.0 - abs(zs - zp) / (0.02 * zp + 0.02)) * pow(saturate(dot(Ns, Np)), 32.0);
        match += w;
        w /= 1.0 + luminance(v.rgb) * exposure;
        sum += v * w;
        wsum += w;
    }
    if (match < 0.02)
        return tracePixel(p, surface, d);
    return sum / wsum;
}

// This frame's reflection at pixel q (surface and d: its surface and depth): traced at full resolution by the
// trace pass, upsampled from the half-resolution samples, or nothing.
float4 currentAt(int2 q, float4 surface, float d)
{
    if (d <= 0.0 || surface.x >= gRt.camPos.w)
        return float4(0.0, 0.0, 0.0, 0.0);
    if (surface.x < gRt.params.z)
        return LoadTex2D(gFullIn, NO_SAMPLER, q, 0);
    return upsample(q, surface, d);
}

// The reflections' temporal accumulation, in the same pass: each pixel's history is found where the reflected
// image was last frame (reprojecting the reflection's virtual image, P plus the hit distance along the view
// ray, for smooth surfaces; the surface itself for rough ones), dropped where that surface wasn't there last
// frame (its depth), clipped to this frame's neighbourhood spread (mean +- 1.25 deviations, YCoCg) and blended
// in a compressed space (c / (1 + max(c)), so a bright sample counts no more than a white one), with more
// history the rougher, noisier and stiller the surface. At half resolution the spread comes from the traced
// samples themselves (3 x 3 of them, 6 x 6 pixels): upsampled neighbours share samples, and their spread is too
// narrow to hold the history. TAA then anti-aliases the frame as before.
#define CLIP_WIDTH 1.25

float3 compressColor(float3 c) { return c / (1.0 + max(c.r, max(c.g, c.b))); }
float3 expandColor(float3 c) { return c / max(1.0 - max(c.r, max(c.g, c.b)), 1e-4); }
float3 toYCoCg(float3 c) { return float3(dot(c, float3(0.25, 0.5, 0.25)), dot(c, float3(0.5, 0.0, -0.5)), dot(c, float3(-0.25, 0.5, -0.25))); }
float3 fromYCoCg(float3 c) { return float3(c.x + c.y - c.z, c.x + c.z, c.x - c.y - c.z); }

float3 clipToBox(float3 h, float3 lo, float3 hi)
{
    float3 centre = 0.5 * (lo + hi);
    float3 extent = 0.5 * (hi - lo) + float3(1e-5, 1e-5, 1e-5);
    float3 v = h - centre;
    float3 a = abs(v / extent);
    float  m = max(a.x, max(a.y, a.z));
    return m > 1.0 ? centre + v / m : h;
}

float2 uvOf(float4 c) { return c.xy / c.w * float2(0.5, -0.5) + 0.5; }
bool   inScreen(float2 uv) { return uv.x > 0.0 && uv.y > 0.0 && uv.x < 1.0 && uv.y < 1.0; }

void resolve(int2 p)
{
    int2   size = int2(gRt.screen.xy);
    float4 surface = LoadTex2D(gSurface, NO_SAMPLER, p, 0);
    float  d = surface.x < gRt.camPos.w ? LoadTex2D(gDepth, NO_SAMPLER, p, 0).r : 0.0;
    float4 cur = currentAt(p, surface, d);
    if (cur.a <= 0.0 || d <= 0.0)
    {
        // Nothing reflected here: no depth is kept either, as the history's alpha says so.
        Write2D(gOut, p, float4(0.0, 0.0, 0.0, 0.0));
        return;
    }
    float exposure = max(gExposure[1], 1e-8);
    float rough = surface.x;

    // The neighbourhood's spread (traced pixels only), and its brightest neighbour.
    float3 c = toYCoCg(compressColor(cur.rgb * exposure));
    float3 m1 = c;
    float3 m2 = c * c;
    float  n = 1.0;
    float  brightest = 0.0;
    bool   fromHalf = gRt.temporal.w > 0.5 && rough >= gRt.params.z;
    int2   halfSize = (size + int2(1, 1)) / 2;
    int2   centre = fromHalf ? clamp(p >> 1, int2(0, 0), halfSize - int2(1, 1)) : p;
    int2   last = fromHalf ? halfSize - int2(1, 1) : size - int2(1, 1);
    for (int y = -1; y <= 1; ++y)
    {
        for (int x = -1; x <= 1; ++x)
        {
            if (x == 0 && y == 0 && !fromHalf)
                continue;
            int2   q = clamp(centre + int2(x, y), int2(0, 0), last);
            float4 v = float4(0.0, 0.0, 0.0, 0.0);
            if (fromHalf)
                v = LoadTex2D(gHalfIn, NO_SAMPLER, q, 0);
            else
            {
                float4 sq = LoadTex2D(gSurface, NO_SAMPLER, q, 0);
                if (sq.x < gRt.camPos.w)
                    v = currentAt(q, sq, LoadTex2D(gDepth, NO_SAMPLER, q, 0).r);
            }
            if (v.a <= 0.0)
                continue;
            float3 s = toYCoCg(compressColor(v.rgb * exposure));
            m1 += s;
            m2 += s * s;
            n += 1.0;
            brightest = max(brightest, s.x);
        }
    }
    // A jittered sample brighter than all its neighbours is a stray: held to the brightest of them.
    if (rough > 0.1 && n > 4.0 && c.x > brightest)
        c *= brightest / max(c.x, 1e-6);
    float3 mean = m1 / n;
    float3 width = sqrt(max(m2 / n - mean * mean, float3(0.0, 0.0, 0.0))) * CLIP_WIDTH;

    // This pixel's world position (undoing the jitter it was drawn with), and where it and its reflection were.
    float  z = gRt.forward.w / d;
    float2 u = float2(p) + 0.5 - gRt.screen.zw;
    float2 ndc = float2(u.x / gRt.screen.x * 2.0 - 1.0, 1.0 - u.y / gRt.screen.y * 2.0);
    float3 P = gRt.camPos.xyz + gRt.right.xyz * (ndc.x * z / gRt.right.w) + gRt.up.xyz * (ndc.y * z / gRt.up.w) + gRt.forward.xyz * z;
    float3 toP = normalize(P - gRt.camPos.xyz);
    float4 pcS = clipOf(gRt.prevViewProj, P);
    float4 pcV = clipOf(gRt.prevViewProj, P + toP * min(cur.a, 1000.0));
    float  mirrorish = saturate(1.0 - rough / max(gRt.camPos.w * 0.5, 1e-3));
    float2 uvS = uvOf(pcS);
    float2 uvPrev = pcV.w > gRt.forward.w ? lerp(uvS, uvOf(pcV), mirrorish) : uvS;

    // More history the rougher (noisier) the surface; little on mirrors, which are exact, and on what moves.
    float  frames = 1.0 + (gRt.temporal.x - 1.0) * saturate(rough * 8.0);
    float2 uvNow = (float2(p) + 0.5) / gRt.screen.xy;
    float2 moved = (LoadTex2D(gMotion, NO_SAMPLER, p, 0).xy - (uvNow - uvS)) * gRt.screen.xy;
    if (dot(moved, moved) > 0.25)
        frames = min(frames, 4.0);

    float3 result = c;
    bool   valid = gRt.temporal.y > 0.5 && pcS.w > gRt.forward.w && inScreen(uvS) && inScreen(uvPrev);
    if (valid)
    {
        // Was this surface there last frame? Its depth then against the depth kept there (none where the
        // history holds nothing).
        int2  qs = clamp(int2(uvS * gRt.screen.xy), int2(0, 0), size - int2(1, 1));
        float zPrev = LoadTex2D(gHistory, NO_SAMPLER, qs, 0).a > 0.0 ? LoadTex2D(gHistoryZ, NO_SAMPLER, qs, 0).r : 0.0;
        valid = abs(zPrev - pcS.w) < 0.04 * pcS.w + 0.02;
    }
    if (valid && frames > 1.0)
    {
        // Bilinear, over the history texels that hold reflections only.
        float2 pos = uvPrev * gRt.screen.xy - 0.5;
        int2   base = int2(floor(pos));
        float2 f = pos - float2(base);
        float4 sum = float4(0.0, 0.0, 0.0, 0.0);
        for (uint i = 0u; i < 4u; ++i)
        {
            int2   dq = int2(int(i & 1u), int(i >> 1u));
            int2   q = clamp(base + dq, int2(0, 0), size - int2(1, 1));
            float4 h = LoadTex2D(gHistory, NO_SAMPLER, q, 0);
            float  w = (dq.x == 1 ? f.x : 1.0 - f.x) * (dq.y == 1 ? f.y : 1.0 - f.y);
            if (h.a > 0.0)
                sum += float4(compressColor(h.rgb * exposure), 1.0) * w;
        }
        if (sum.w > 0.05)
        {
            float3 history = clipToBox(toYCoCg(sum.rgb / sum.w), mean - width, mean + width);
            result = lerp(history, c, 1.0 / frames);
        }
    }
    Write2D(gOut, p, float4(max(expandColor(fromYCoCg(result)), float3(0.0, 0.0, 0.0)) / exposure, cur.a));
    Write2D(gOutZ, p, z);
}

// The resolve, one full-size pass: this frame's reflection per pixel (the full-resolution trace, or the upsampled
// half-resolution one) accumulated with last frame's into gOut. A tile with nothing to reflect writes zeros only
// when the texture doesn't hold zeros there already (gTiles), so most of a frame without glossy surfaces
// costs two reads per tile. Flags are read and written in different places, so no thread waits for another.
ROOT_SIGNATURE(ComputeRootSignature)
NUM_THREADS(8, 8, 1)
void CS_MAIN(SV_DispatchThreadID(uint3) id, SV_GroupID(uint3) gid, SV_GroupIndex(uint) gi)
{
    INIT_MAIN;
    int2 size = int2(gRt.screen.xy);
    int2 p = int2(id.xy);
    uint tile = gid.y * gRt.tiles.x + gid.x;
    bool traced = gTiles[gRt.tiles.z + tile] != 0u;
    bool zero = gTiles[gRt.zero.x + tile] != 0u && gRt.zero.z == 0u;
    if (gi == 0u)
    {
        gTiles[gRt.zero.y + tile] = traced ? 0u : 1u;
        gTiles[gRt.tiles.w + tile] = 0u; // next frame's trace marks it afresh
    }
    if (p.x >= size.x || p.y >= size.y || (!traced && zero))
        RETURN();
    if (traced)
        resolve(p);
    else
        Write2D(gOut, p, float4(0.0, 0.0, 0.0, 0.0));
    RETURN();
}
#endif
