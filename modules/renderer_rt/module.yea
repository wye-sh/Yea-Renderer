module renderer_rt

# Called by renderer (the core) each frame with the address of its RenderFrame (frame.h).
export bool rt_prepare(u64 frame)
export void rt_run(u64 frame)
# Called before shadows_prepare: picks the shadows it traces (rtShadows), which renderer_shadows then skips.
export bool rt_pick(u64 frame)

category Ray-Traced Reflections
# Reflections found by tracing rays through the scene, also of what is off screen or hidden. Only on GPUs
# with ray tracing (hidden elsewhere), with Anti-aliasing (TAA) on; elsewhere Screen Reflections and the probes show.
setting bool enabled true
needs enabled raytracing
player enabled
# Surfaces rougher than this keep the probes' blurred reflections; traced ones fade out towards it.
setting float max_roughness 0.5 0 1
# Rays for one pixel in four, filled in by matching depth and normal: about a quarter of the cost.
setting bool half_resolution true
player half_resolution
# Surfaces smoother than this are traced at every pixel even at half resolution, so mirrors stay sharp.
setting float full_below 0.15 0 1
# Where what a ray hits is visible on screen, its fully lit colour from there (with all shadows and
# lights); elsewhere it is lit at the hit.
setting bool screen_colors true
# How what a reflection shows is shadowed. Scene: as the scene shadows it (from each light's shadow map, a ray
# for lights without one and for the sun). Rays: a ray towards every light, to compare. Off: no shadows.
setting choice reflected_shadows Scene Scene Rays Off
# Frames of history blended into rough reflections, so they hold still (mirrors take little, moving things less).
setting int history_frames 12 1 inf
# How far (pixels) the filter may spread a glossy reflection on what moves, where its history is short and it
# would mottle: wider is softer. Still surfaces keep the narrow filter.
setting float moving_blur 5 0 inf
# The brightest a single ray's find may be (times white), so a stray ray onto a light can't sparkle.
setting float brightest 8 1 inf
# How far (metres) rays look for something to reflect.
setting float max_distance 100 1 inf
# Tints traced reflections: green where the hit was seen on screen, blue where it was lit at the hit,
# grey where the ray found the sky.
setting bool show_hits false
# Temporary, to measure ray-traced shadows' cost: shadow rays traced from every pixel on screen and thrown away
# (1 the sun's, each more one local light's). The picture doesn't change.
setting int probe_rays 0 0 9

category Ray-Traced Shadows
# Shadows found by tracing rays towards each light's real shape (the sun's disc, a lamp's sphere, an area
# light's panel, disc or tube): sharp where they touch, softer further away. Only on GPUs with ray tracing,
# with Anti-aliasing (TAA) on; elsewhere, and for lights not traced, shadow maps. On by default for the sun alone
# (traced_lights 0): measured on an RTX 2080 (test_renderer_rays), the sun costs 0.4 to 2 ms at 1440p native, net
# of the cascades it replaces, and each traced lamp 1 to 1.7 ms more.
setting bool shadows true
needs shadows raytracing
player shadows
# How many lights besides the sun get traced shadows (area lights first); the rest keep shadow maps.
setting int traced_lights 0 0 8

# Frame versions (6.1.0): the core calls this module only while frame_version() is its own; it refuses a core of
# another version (frame_version 0 from an older core's stub).
export u32 frame_version()
import renderer u32 frame_version() = 0
