module renderer_upscale

# Called by renderer (the core) each frame with the address of its RenderFrame (frame.h): upscale_prepare first of all
# (it may lower the frame's render size), upscale_run in TAA's resolve's place when it upscales.
export bool upscale_prepare(u64 frame)
export void upscale_run(u64 frame)

category Upscaling
# TAA: the Renderer's own anti-aliasing at full resolution. FSR: AMD's upscaler (FSR 4 on Radeon RX 6000 and later,
# FSR 3.1 elsewhere): the scene renders at the quality's resolution and FSR brings it back to the screen's. Options this
# machine can't run are hidden. (DLSS was a third option until 7.0.0: a value saved as it runs TAA.)
setting choice upscaler TAA TAA FSR
# AMD's DLLs are built with toolset 14.44 and can crash in std::mutex on an older Visual C++ runtime.
needs upscaler FSR msvc 14.40
# FSR's files are here (Windows: Direct3D 12 and AMD's two DLLs; Linux: compiled in): offered in load().
needs upscaler FSR offer
player upscaler
# The render resolution for FSR: Native (100%, FSR's own anti-aliasing), Quality (67%), Balanced (59%),
# Performance (50%), Ultra Performance (33%).
setting choice quality_mode Quality Native Quality Balanced Performance Ultra_Performance
player quality_mode

# Frame versions (6.1.0): the core calls this module only while frame_version() is its own; it refuses a core of
# another version (frame_version 0 from an older core's stub).
export u32 frame_version()
import renderer u32 frame_version() = 0
