// Diffuse-only shading for reflections: sky ambient, the sun (no shadow), the nearest local lights and
// emission. Metals stand in with their colour. Alpha 1 marks covered texels; the sky stays live in the
// forward pass, behind whatever a < 1 leaves.
#include "CaptureCommon.h.fsl"

STRUCT(VSOutput)
{
    DATA(float4, Position, SV_Position);
    DATA(float3, WorldPos, TEXCOORD0);
    DATA(float3, Normal, TEXCOORD1);
    DATA(FLAT(uint), Material, TEXCOORD2);
    DATA(FLAT(uint), View, TEXCOORD3);
    DATA(float2, Uv, TEXCOORD4);
    DATA(float4, Color, TEXCOORD5);
};

// The height fog between the probe and P (the core's applyHeightFog in Lighting.h.fsl: exact optical depth, the sun
// unshadowed and the sky's mean light scattered in).
float fogHeightIntegral(float h, float rho, float k)
{
    if (h <= 0.0 || k < 1e-5)
        return rho * h;
    return rho * (1.0 - exp(-k * h)) / k;
}

float3 applyHeightFog(float3 color, float3 O, float3 d, float t)
{
    float4 m = gCapture.fogMedium;
    float  h0 = O.y - m.z;
    float  depth;
    if (abs(d.y) < 1e-4)
        depth = m.x * exp(-m.y * max(h0, 0.0)) * t;
    else
        depth = (fogHeightIntegral(h0 + d.y * t, m.x, m.y) - fogHeightIntegral(h0, m.x, m.y)) / d.y;
    float  T = exp(-max(depth, 0.0));
    float3 sky = gCapture.counts.y != 0u ? max(gSkySh[0].rgb, float3(0.0, 0.0, 0.0)) * 0.282095
                                         : (gCapture.skyHorizon.rgb * 0.5 + gCapture.skyZenith.rgb * (2.0 / 3.0) + gCapture.skyGround.rgb * (5.0 / 6.0)) * 0.5;
    float3 L = sky * gCapture.skyGround.w;
    if (gCapture.sunDir.w > 0.0)
    {
        float g = m.w, c = dot(d, gCapture.sunDir.xyz);
        float q = max(1.0 + g * g - 2.0 * g * c, 1e-4);
        L += gCapture.sunColor.rgb * ((1.0 - g * g) / (4.0 * 3.14159265 * q * sqrt(q)));
    }
    return color * T + gCapture.fogAlbedo.rgb * L * (1.0 - T);
}

float4 sampleMap(uint slot, float2 uv, float2 dx, float2 dy)
{
    float4 c = float4(1.0, 1.0, 1.0, 1.0);
    uint   texSlot = slot - 1u;
    BeginNonUniformResourceIndex(texSlot, MAX_TEXTURES);
        c = SampleGradTex2D(gTextures[texSlot], gSamplerAnisotropic, uv, dx, dy);
    EndNonUniformResourceIndex();
    return c;
}

// Decals, painted as the forward pass paints them (the core's Decal.h.fsl).
#define DECAL_DATA(k)                  gDecals[k]
#define DECAL_SAMPLE(slot, uv, dx, dy) sampleMap(slot, uv, dx, dy)
#define DECAL_CELLS                    gDecalCells
#define DECAL_ITEMS                    gDecalItems
#include "Decal.h.fsl"

ROOT_SIGNATURE(DefaultRootSignature)
float4 PS_MAIN(VSOutput In)
{
    INIT_MAIN;
    MaterialData    m = gMaterials[In.Material];
    MaterialMapData mm = gMaterialMaps[In.Material];
    if (mm.misc.y > 0.5)
    {
        // The base colour and emissive maps (as the forward pass reads them); alpha-tested materials cut out.
        float2 dx = ddx(In.Uv);
        float2 dy = ddy(In.Uv);
        float4 base = mm.maps.x != 0u ? sampleMap(mm.maps.x, In.Uv, dx, dy) : float4(1.0, 1.0, 1.0, 1.0);
        if (mm.misc.x > 0.0)
            clip(base.a * mm.baseFactor.a * In.Color.a - mm.misc.x);
        if (mm.maps.x != 0u)
            m.albedoRough.rgb = mm.baseFactor.rgb * base.rgb;
        m.albedoRough.rgb *= In.Color.rgb;
        if (mm.maps.w != 0u)
            m.emissive.rgb *= sampleMap(mm.maps.w, In.Uv, dx, dy).rgb;
    }
    float3 P = In.WorldPos;
    float3 N = normalize(In.Normal);
    if (dot(N, gViews[In.View].eye.xyz - P) < 0.0)
        N = -N;
    if (gCapture.counts.z != 0u)
    {
        float  rough = m.albedoRough.a;
        float3 Nd = N;
        decalsAt(gCapture.counts.z, gCapture.decalGrid0, gCapture.decalGrid1, P, N, ddx(P), ddy(P), m.albedoRough.rgb, rough,
                 m.params.x, m.emissive.rgb, Nd);
        N = Nd; // diffuse-only here: their roughness has no say
    }
    float3 diffuse = m.albedoRough.rgb * (1.0 - 0.5 * saturate(m.params.x));
    float3 sky;
    if (gCapture.counts.y != 0u)
    {
        // renderer_sky's cosine-convolved SH (the core's skyIrradiance).
        sky = gSkySh[0].rgb * 0.282095 + (gSkySh[1].rgb * N.y + gSkySh[2].rgb * N.z + gSkySh[3].rgb * N.x) * 0.488603 +
              (gSkySh[4].rgb * (N.x * N.y) + gSkySh[5].rgb * (N.y * N.z) + gSkySh[7].rgb * (N.x * N.z)) * 1.092548 +
              gSkySh[6].rgb * (0.315392 * (3.0 * N.z * N.z - 1.0)) + gSkySh[8].rgb * (0.546274 * (N.x * N.x - N.y * N.y));
        sky = max(sky, float3(0.0, 0.0, 0.0));
    }
    else
    {
        float3 up = lerp(gCapture.skyHorizon.rgb, gCapture.skyZenith.rgb, 0.6);
        float3 down = lerp(gCapture.skyHorizon.rgb, gCapture.skyGround.rgb, 0.85);
        sky = lerp(down, up, N.y * 0.5 + 0.5);
    }
    float3 c = sky * gCapture.skyGround.w * diffuse;
    float3 light = gCapture.sunColor.rgb * saturate(dot(N, gCapture.sunDir.xyz)) * gCapture.sunDir.w;
    for (uint i = 0u; i < gCapture.counts.x; ++i)
    {
        LightData l = gLights[i];
        float3 toLight = l.pos.xyz - P;
        float  d2 = dot(toLight, toLight);
        float  window = saturate(1.0 - d2 * d2 * l.params.z * l.params.z);
        if (window <= 0.0)
            continue;
        float3 L = toLight * rsqrt(max(d2, 1e-8));
        float  e = window * window / max(d2, 1e-4);
        if (l.color.w > 1.5)
        {
            float cone = saturate(dot(-L, l.dir.xyz) * l.dir.w + l.params.x);
            e *= cone * cone;
        }
        light += l.color.rgb * (e * saturate(dot(N, L)));
    }
    c += diffuse * (1.0 / 3.14159265) * light + m.emissive.rgb;
    if (gCapture.fogMedium.x > 0.0)
    {
        float3 toP = P - gViews[In.View].eye.xyz;
        float  t = length(toP);
        c = applyHeightFog(c, gViews[In.View].eye.xyz, toP / max(t, 1e-6), t);
    }
    RETURN(float4(c, 1.0));
}
