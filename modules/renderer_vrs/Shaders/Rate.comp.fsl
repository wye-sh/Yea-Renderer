// One shading rate per tile (a thread group of 8 x 8, each thread tile/8 squared pixels), into gPre;
// Dilate.comp.fsl then makes the final image. From last frame's anti-aliased image, as seen (exposed,
// compressed, square-rooted): the RMS difference between horizontal and between vertical neighbours, which
// halving the rate along that axis would lose (Yang et al. 2019, content-adaptive shading). Moving things
// are covered by the depth tests below and Dilate's spreading. Below the threshold (raised by motion only if `motion` asks) that
// axis goes coarse. From this frame's depth, the prepass's: a depth edge or crease (the second difference
// of 1/z, zero across any plane) keeps the tile at full rate, and so does a curved surface (1/z off a plane
// across the tile), whose reflections and highlights change from pixel to pixel.
STRUCT(VrsData)
{
    DATA(uint4, size, None);    // xy screen, zw rate image
    DATA(uint4, info, None);    // x tile (px), y the GPU's rates (bits 1 << rate), z 4 x 4 allowed, w write the image
    DATA(float4, params, None); // x contrast threshold, y motion scale (per px/frame), z edge threshold,
                                // w curvature threshold (0: curved surfaces may go coarse)
    DATA(float4, params2, None); // x roughness below which a pixel's reflection keeps its tile at full rate (0: off),
                                 // yz 1 / size (the UPSCALED variants: last frame's image is the display's size)
};

#include "Rate.srt.h"

#define RATE_1X1 0u
#define RATE_1X2 1u
#define RATE_2X1 4u
#define RATE_2X2 5u
#define RATE_4X4 10u
#define FROM_CONTRAST 16u // gPre: full rate for its contrast; Dilate spreads it to the neighbours
#define CURVED 32u        // gPre: full rate as curved; Dilate fills a tile mostly surrounded by these (a flat facet)

// The tile and a one-pixel border, loaded once: luminance as seen a frame ago, and depth. Sized for the
// GPU's tile (TILE, a variant per size): group memory sized for larger tiles than used limits how many
// groups run at once, and this pass mostly waits on memory.
#define BORDER_MAX (TILE + 2u)
GroupShared(float, gsL[BORDER_MAX * BORDER_MAX]);
GroupShared(float, gsZ[BORDER_MAX * BORDER_MAX]);
GroupShared(float2, gsSum[64]); // h, v
GroupShared(float3, gsMax[64]); // edge, motion, glossiness (1 - roughness)

float seen(int2 p, float exposure)
{
#if defined(UPSCALED)
    // renderer_upscale renders smaller than last frame's image (display size): read it at this pixel's centre.
    float3 c = max(SampleLvlTex2D(gPrevious, gSamplerBilinearClamp, (float2(p) + 0.5) * gVrs.params2.yz, 0.0).rgb, float3(0.0, 0.0, 0.0)) * exposure;
#else
    float3 c = max(LoadTex2D(gPrevious, NO_SAMPLER, p, 0).rgb, float3(0.0, 0.0, 0.0)) * exposure;
#endif
    float  l = dot(c, float3(0.2126, 0.7152, 0.0722));
    return sqrt(l / (1.0 + l));
}

float curve(uint a, uint b, uint c) { return abs(gsZ[a] + gsZ[c] - 2.0 * gsZ[b]) / max(gsZ[b], 1e-7); }

ROOT_SIGNATURE(ComputeRootSignature)
NUM_THREADS(8, 8, 1)
void CS_MAIN(SV_GroupID(uint3) gid, SV_GroupThreadID(uint3) tid, SV_GroupIndex(uint) gi)
{
    INIT_MAIN;
    uint tile = min(gVrs.info.x, BORDER_MAX - 2u);
    uint per = max(tile / 8u, 1u);
    uint side = tile + 2u;
    int2 last = int2(gVrs.size.xy) - int2(1, 1);
    int2 origin = int2(gid.xy) * int(tile) - int2(1, 1);
    float exposure = gExposure[1];
    for (uint i = gi; i < side * side; i += 64u)
    {
        int2 q = clamp(origin + int2(int(i % side), int(i / side)), int2(0, 0), last);
        gsL[i] = seen(q, exposure);
        gsZ[i] = LoadTex2D(gDepth, NO_SAMPLER, q, 0).r; // reversed-Z, infinite far: near / z
    }
    GroupMemoryBarrier();

    float2 sum = float2(0.0, 0.0);
    float  edge = 0.0;
    uint2  at = tid.xy * per; // within the tile
    // Motion, only when it may coarsen: one read per thread (per x per pixels) is enough to judge it.
    float  motion = 0.0;
    if (gVrs.params.y > 0.0)
        motion = length(LoadTex2D(gMotion, NO_SAMPLER, min(int2(gid.xy) * int(tile) + int2(at), last), 0).rg * float2(gVrs.size.xy));
    for (uint y = 0u; y < per; ++y)
        for (uint x = 0u; x < per; ++x)
        {
            uint  k = (at.y + y + 1u) * side + (at.x + x + 1u);
            float dh = gsL[k + 1u] - gsL[k];
            float dv = gsL[k + side] - gsL[k];
            sum += float2(dh * dh, dv * dv);
            float d = gsZ[k];
            float ex = gsZ[k - 1u] + gsZ[k + 1u] - 2.0 * d;
            float ey = gsZ[k - side] + gsZ[k + side] - 2.0 * d;
            edge = max(edge, max(abs(ex), abs(ey)) / max(d, 1e-7));
        }
    // Glossy pixels, from the prepass: their reflections and highlights change from pixel to pixel.
    float shine = 0.0;
    if (gVrs.params2.x > 0.0)
        for (uint gy = 0u; gy < per; ++gy)
            for (uint gx = 0u; gx < per; ++gx)
            {
                int2 q = min(int2(gid.xy) * int(tile) + int2(at) + int2(int(gx), int(gy)), last);
                shine = max(shine, 1.0 - LoadTex2D(gGloss, NO_SAMPLER, q, 0).r);
            }
    gsSum[gi] = sum;
    gsMax[gi] = float3(edge, motion, shine);
    GroupMemoryBarrier();
    for (uint s = 32u; s > 0u; s >>= 1u)
    {
        if (gi < s)
        {
            gsSum[gi] += gsSum[gi + s];
            gsMax[gi] = max(gsMax[gi], gsMax[gi + s]);
        }
        GroupMemoryBarrier();
    }
    if (gi != 0u)
        RETURN();
    sum = gsSum[0];
    edge = gsMax[0].x;
    motion = gsMax[0].y;
    bool glossy = gsMax[0].z > 1.0 - gVrs.params2.x;
    // Curvature: 1/z on a 3 x 3 grid across the tile, against the plane through it.
    float curved = 0.0;
    if (gVrs.params.w > 0.0)
    {
        uint a = 1u;
        uint b = 1u + (tile - 1u) / 2u;
        uint c = 1u + 2u * ((tile - 1u) / 2u);
        for (uint j = 0u; j < 3u; ++j)
        {
            uint o = j == 0u ? a : (j == 1u ? b : c);
            curved = max(curved, curve(o * side + a, o * side + b, o * side + c)); // along a row
            curved = max(curved, curve(a * side + o, b * side + o, c * side + o)); // down a column
        }
        curved = max(curved, curve(a * side + a, b * side + b, c * side + c));
        curved = max(curved, curve(a * side + c, b * side + b, c * side + a));
    }
    float n = float(64u * per * per);
    float eh = sqrt(sum.x / n);
    float ev = sqrt(sum.y / n);
    float t = gVrs.params.x * (1.0 + motion * gVrs.params.y);
    uint  rate = RATE_1X1;
    if (glossy)
        rate = RATE_1X1;
    else if (edge < gVrs.params.z && gVrs.params.w > 0.0 && curved >= gVrs.params.w)
        rate = RATE_1X1 | CURVED;
    else if (edge < gVrs.params.z)
    {
        if (eh < t && ev < t)
            rate = gVrs.info.z != 0u && (gVrs.info.y & (1u << RATE_4X4)) != 0u && eh < t * 0.25 && ev < t * 0.25 ? RATE_4X4 : RATE_2X2;
        else if (eh < t)
            rate = RATE_2X1;
        else if (ev < t)
            rate = RATE_1X2;
        else
            rate = RATE_1X1 | FROM_CONTRAST;
    }
    Write2D(gPre, int2(gid.xy), rate);
    RETURN();
}
