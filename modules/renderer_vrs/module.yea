module renderer_vrs

# Called by renderer (the core) each frame with the address of its RenderFrame (frame.h).
export bool vrs_prepare(u64 frame)
export void vrs_run(u64 frame)

category Variable Rate Shading
# Smooth areas of the screen are lit once per 2 x 2 (or 2 x 1, 1 x 2) pixels instead of every pixel;
# edges, highlights and fine detail stay at full rate. Only on GPUs with variable-rate shading, with
# Anti-aliasing (TAA) on.
setting bool enabled true
# Higher: more of the screen at coarser rates (from last frame's contrast).
setting float aggressiveness 1 0 4
# How much faster movement lets shading coarsen.
setting float motion 1 0 4
# Very smooth areas once per 4 x 4 pixels, where the GPU has it.
setting bool allow_4x4 false
# Tints the screen by rate: green 2 x 1 or 1 x 2, blue 2 x 2, magenta coarser; full rate untinted.
setting bool show_rates false
