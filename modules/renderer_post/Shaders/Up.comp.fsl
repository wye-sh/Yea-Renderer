// Bloom's upsample (Jimenez 2014): this level of the downsample chain (gSrc2, at the output's size) plus the level
// below it, already summed (gSrc), read through a 3 x 3 tent of `radius` source texels. Each level adds its own blur,
// so the sum is a wide, smooth, energy-ordered kernel; renderer_post.cpp divides it by the level count.
#include "Common.h.fsl"

ROOT_SIGNATURE(ComputeRootSignature)
NUM_THREADS(8, 8, 1)
void CS_MAIN(SV_DispatchThreadID(uint3) id)
{
    INIT_MAIN;
    int2 p = int2(id.xy);
    if (p.x >= int(gPost.size.x) || p.y >= int(gPost.size.y))
        RETURN();
    float2 uv = (float2(p) + 0.5) / float2(gPost.size.xy);
    float2 t = gPost.bloom.y / float2(gPost.size.zw);
    float3 s = SampleLvlTex2D(gSrc, gSamplerBilinearClamp, uv, 0.0).rgb * 4.0;
    s += (SampleLvlTex2D(gSrc, gSamplerBilinearClamp, uv + float2(-t.x, 0.0), 0.0).rgb +
          SampleLvlTex2D(gSrc, gSamplerBilinearClamp, uv + float2(t.x, 0.0), 0.0).rgb +
          SampleLvlTex2D(gSrc, gSamplerBilinearClamp, uv + float2(0.0, -t.y), 0.0).rgb +
          SampleLvlTex2D(gSrc, gSamplerBilinearClamp, uv + float2(0.0, t.y), 0.0).rgb) * 2.0;
    s += SampleLvlTex2D(gSrc, gSamplerBilinearClamp, uv - t, 0.0).rgb + SampleLvlTex2D(gSrc, gSamplerBilinearClamp, uv + t, 0.0).rgb +
         SampleLvlTex2D(gSrc, gSamplerBilinearClamp, uv + float2(-t.x, t.y), 0.0).rgb +
         SampleLvlTex2D(gSrc, gSamplerBilinearClamp, uv + float2(t.x, -t.y), 0.0).rgb;
    float3 here = LoadTex2D(gSrc2, NO_SAMPLER, p, 0).rgb;
    Write2D(gOut, p, float4(here + s * (1.0 / 16.0), 1.0));
    RETURN();
}
