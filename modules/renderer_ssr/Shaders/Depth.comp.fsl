// The camera depth (reversed-Z) copied for the forward pass to trace reflections against while the
// depth target itself is bound: at full size, or at half size keeping the nearest of each 2 x 2.
STRUCT(SsrDepthData)
{
    DATA(uint4, size, None); // xy out size, zw depth size
    DATA(uint4, info, None); // x 1: half size
};

#include "Depth.srt.h"

ROOT_SIGNATURE(ComputeRootSignature)
NUM_THREADS(8, 8, 1)
void CS_MAIN(SV_DispatchThreadID(uint3) id)
{
    INIT_MAIN;
    int2 p = int2(id.xy);
    if (p.x >= int(gSsr.size.x) || p.y >= int(gSsr.size.y))
        RETURN();
    float d;
    if (gSsr.info.x != 0u)
    {
        int2 q = p * 2;
        int2 last = int2(gSsr.size.zw) - int2(1, 1);
        float a = LoadTex2D(gDepth, NO_SAMPLER, min(q, last), 0).r;
        float b = LoadTex2D(gDepth, NO_SAMPLER, min(q + int2(1, 0), last), 0).r;
        float c = LoadTex2D(gDepth, NO_SAMPLER, min(q + int2(0, 1), last), 0).r;
        float e = LoadTex2D(gDepth, NO_SAMPLER, min(q + int2(1, 1), last), 0).r;
        d = max(max(a, b), max(c, e)); // reversed-Z: the nearest
    }
    else
        d = LoadTex2D(gDepth, NO_SAMPLER, p, 0).r;
    Write2D(gOut, p, d);
    RETURN();
}
