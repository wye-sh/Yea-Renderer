// The particles' compute passes, one per define:
// INIT: every pool slot free (after a load, a resize or Reset).
// EMIT: this frame's new particles, each taking a free slot (none left: it isn't made); empties the draw list.
// SIMULATE: every slot. A live particle ages, dies into the free list at the end of its life, or moves (gravity, drag,
//   divergence-free turbulence); one in view is lit where it is (the sun through its cascade, the sky, the local lights
//   in the core's depth bin with one shadow-map compare each, a Henyey-Greenstein phase) and listed to draw.
// PAD: the draw list past its end, up to the sort's size, with depth 0 (they sort last).
// SORT_LOCAL, SORT_GLOBAL: a bitonic sort of the draw list by depth, farthest first (back to front), 1024 entries a
//   group in shared memory, the strides past it a pass each.
#include "ParticleData.h.fsl"
#include "Particles.srt.h"

uint hashU(uint x)
{
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

// The k-th random number in 0..1 from seed s.
float rand01(uint s, uint k) { return float(hashU(s + k * 0x9E3779B9u) >> 8) * (1.0 / 16777216.0); }

#if defined(INIT)
ROOT_SIGNATURE(ComputeRootSignature)
NUM_THREADS(256, 1, 1)
void CS_MAIN(SV_DispatchThreadID(uint3) id)
{
    INIT_MAIN;
    uint n = gFrame.counts.w;
    if (id.x < n)
    {
        Particle p;
        p.pos = float4(0.0, 0.0, 0.0, 0.0);
        p.vel = float4(0.0, 0.0, 0.0, 0.0);
        p.info = uint4(0u, 0u, 0u, 0u);
        gParticles[id.x] = p;
        gDead[id.x] = n - 1u - id.x; // slot 0 first
    }
    if (id.x == 0u)
    {
        gCounters[0] = n;
        gCounters[1] = 0u;
    }
    RETURN();
}
#endif

#if defined(EMIT)
ROOT_SIGNATURE(ComputeRootSignature)
NUM_THREADS(256, 1, 1)
void CS_MAIN(SV_DispatchThreadID(uint3) id)
{
    INIT_MAIN;
    uint t = id.x;
    if (t == 0u)
        gCounters[1] = 0u; // this frame's draw list starts empty (simulate fills it, after this pass)
    if (t >= gFrame.spawn.x)
        RETURN();
    uint row = 0xFFFFFFFFu;
    for (uint k = 0u; k < gFrame.spawn.y; ++k)
    {
        uint4 s = gSpawn[k].info;
        if (t >= s.y && t < s.y + s.z)
            row = s.x;
    }
    if (row == 0xFFFFFFFFu)
        RETURN();
    // A free slot, or none.
    uint free;
    AtomicAdd(gCounters[0], 0xFFFFFFFFu, free);
    if (free == 0u || free > gFrame.counts.w)
    {
        uint back;
        AtomicAdd(gCounters[0], 1u, back);
        RETURN();
    }
    uint    slot = gDead[free - 1u];
    Emitter e = gEmitters[row];
    uint    seed = hashU(t * 7919u + gFrame.spawn.w);
    float3  P = e.pos.xyz;
    if (e.pos.w > 1.5)
    {
        // In a sphere, evenly through its volume.
        float  z = rand01(seed, 0u) * 2.0 - 1.0, phi = rand01(seed, 1u) * 2.0 * PART_PI;
        float  r = e.extent.x * pow(rand01(seed, 2u), 1.0 / 3.0);
        float  s = sqrt(max(1.0 - z * z, 0.0));
        P += float3(s * cos(phi), z, s * sin(phi)) * r;
    }
    else if (e.pos.w > 0.5)
        P += (float3(rand01(seed, 0u), rand01(seed, 1u), rand01(seed, 2u)) * 2.0 - 1.0) * e.extent.xyz;
    // Off along the emitter's direction, spread evenly over a cone of cosine extent.w.
    float3 axis = dot(e.dir.xyz, e.dir.xyz) > 1e-8 ? normalize(e.dir.xyz) : float3(0.0, 1.0, 0.0);
    float3 tx = normalize(cross(abs(axis.y) < 0.9 ? float3(0.0, 1.0, 0.0) : float3(1.0, 0.0, 0.0), axis));
    float3 ty = cross(axis, tx);
    float  cz = 1.0 - rand01(seed, 3u) * (1.0 - e.extent.w), cphi = rand01(seed, 4u) * 2.0 * PART_PI;
    float  cs = sqrt(max(1.0 - cz * cz, 0.0));
    float3 d = (tx * cos(cphi) + ty * sin(cphi)) * cs + axis * cz;
    float  speed = e.dir.w * (1.0 - e.motion.w * rand01(seed, 5u));
    Particle p;
    p.pos = float4(P, 0.0);
    p.vel = float4(d * speed, max(lerp(e.life.x, e.life.y, rand01(seed, 6u)), 1e-3));
    p.info = uint4(row, seed, 0u, 0u);
    gParticles[slot] = p;
    RETURN();
}
#endif

#if defined(SIMULATE)
float phase4(float c, float g)
{
    // 4 x Henyey-Greenstein: a sprite that scatters as a cloud of droplets; isotropic (g 0) it is 1 / pi, a white
    // diffuse surface's radiance per unit of illuminance.
    float g2 = g * g;
    float d = max(1.0 + g2 - 2.0 * g * c, 1e-4);
    return (1.0 - g2) / (PART_PI * d * sqrt(d));
}

float3 toAtlas(PartShadowView v, float3 P)
{
    float4 q = float4(P, 1.0);
    float4 c = float4(dot(v.row0, q), dot(v.row1, q), dot(v.row2, q), dot(v.row3, q));
    float3 ndc = c.xyz / c.w;
    return float3(v.rect.xy + (ndc.xy * float2(0.5, -0.5) + float2(0.5, 0.5)) * v.rect.zw, ndc.z);
}

float sunVisibility(float3 P, float viewZ)
{
    uint count = uint(gFrame.sunColor.w);
    uint c = 0u;
    while (c < count && viewZ > gFrame.cascadeEnd[c])
        c += 1u;
    if (c >= count)
        return 1.0;
    PartShadowView v = gViews[c];
    float3 a = toAtlas(v, P);
    if (a.z >= 1.0)
        return 1.0;
    float  t = gFrame.texel.x;
    float2 uv = clamp(a.xy, v.rect.xy + t, v.rect.xy + v.rect.zw - t);
    return CompareTex2D(gSunAtlas, gShadowCmp, float3(uv, a.z));
}

float localVisibility(PartLight l, float3 P)
{
    uint view = uint(l.params.y);
    if (l.color.w < 1.5)
    {
        // A cube: the face from where it was drawn (the core's localShadow). Faces go +x -x +y -y +z -z.
        float3 d = P - gViews[view].info.yzw;
        float3 ad = abs(d);
        view += ad.x >= ad.y && ad.x >= ad.z ? (d.x > 0.0 ? 0u : 1u) : (ad.y >= ad.z ? (d.y > 0.0 ? 2u : 3u) : (d.z > 0.0 ? 4u : 5u));
    }
    PartShadowView v = gViews[view];
    float3 a = toAtlas(v, P);
    float  t = gFrame.texel.y;
    float2 uv = clamp(a.xy, v.rect.xy + t, v.rect.xy + v.rect.zw - t);
    return CompareTex2D(gLocalAtlas, gShadowCmp, float3(uv, a.z));
}

// A local light's illuminance at P times the phase (renderer_fog's localLight).
float3 localLight(uint i, float3 P, float3 V, float g, bool maps)
{
    PartLight l = gLights[i];
    float3 toLight = l.pos.xyz - P;
    float  d2 = dot(toLight, toLight);
    if (d2 >= l.pos.w * l.pos.w)
        return float3(0.0, 0.0, 0.0);
    float3 L = toLight * rsqrt(max(d2, 1e-8));
    float  f = d2 * l.params.z;
    float  window = saturate(1.0 - f * f);
    PartLightShape sh = gShapes[i];
    float  near = sh.ex.w > 2.5 ? 1.0 / (PART_PI * max(sh.ey.w, 1e-6)) : 1e-4;
    float  atten = window * window / max(d2, near);
    if (l.color.w > 1.5)
    {
        float cone = saturate(dot(-L, l.dir.xyz) * l.dir.w + l.params.x);
        atten *= cone * cone;
    }
    if (sh.ex.w > 2.5 && sh.ex.w < 4.5)
        atten *= max(dot(-L, l.dir.xyz), 0.0);
    if (atten <= 0.0)
        return float3(0.0, 0.0, 0.0);
    if (maps && l.params.y >= 0.0)
        atten *= localVisibility(l, P);
    return l.color.rgb * (atten * phase4(dot(V, L), g));
}

// A divergence-free swirl (the curl of a field of sines): it stirs without bunching particles up or thinning them out.
float3 swirl(float3 p, float t)
{
    float3 a = float3(cos(p.y * 0.9 + t * 0.7), cos(p.z * 0.8 + t * 0.5), cos(p.x * 1.1 + t * 0.6));
    float3 q = float3(p.y + p.z, p.z - p.x, p.x + p.y) * 1.7;
    float3 b = float3(cos(q.z + t * 1.3), cos(q.x + t * 1.1), cos(q.y + t * 0.9)) * 0.5;
    return a + b;
}

ROOT_SIGNATURE(ComputeRootSignature)
NUM_THREADS(256, 1, 1)
void CS_MAIN(SV_DispatchThreadID(uint3) id)
{
    INIT_MAIN;
    uint i = id.x;
    if (i >= gFrame.counts.w)
        RETURN();
    Particle p = gParticles[i];
    if (p.vel.w <= 0.0)
        RETURN();
    float dt = gFrame.soft.w;
    p.pos.w += dt;
    if (p.pos.w >= p.vel.w)
    {
        p.vel.w = 0.0;
        gParticles[i] = p;
        uint at;
        AtomicAdd(gCounters[0], 1u, at);
        gDead[at] = i;
        RETURN();
    }
    Emitter e = gEmitters[p.info.x];
    float3  v = p.vel.xyz;
    v.y -= e.motion.x * dt;
    v *= exp(-e.motion.y * dt);
    if (e.motion.z > 0.0)
        v += swirl(p.pos.xyz + float(p.info.y & 255u) * 0.01, gFrame.soft.z) * (e.motion.z * dt);
    p.pos.xyz += v * dt;
    p.vel.xyz = v;
    gParticles[i] = p;

    // In view (its sphere inside the frustum's sides and past the near plane): lit and listed to draw.
    float  t = p.pos.w / p.vel.w;
    float  r = max(lerp(e.size.x, e.size.y, t), 1e-4) * 1.4143;
    float4 q = float4(p.pos.xyz, 1.0);
    float3 c = float3(dot(gFrame.view[0], q), dot(gFrame.view[1], q), dot(gFrame.view[2], q));
    float  sx = sqrt(1.0 + gFrame.proj.x * gFrame.proj.x), sy = sqrt(1.0 + gFrame.proj.y * gFrame.proj.y);
    if (c.z + r < gFrame.camPos.w || abs(c.x) * gFrame.proj.x > c.z + r * sx || abs(c.y) * gFrame.proj.y > c.z + r * sy)
        RETURN();
    float3 P = p.pos.xyz;
    float3 V = normalize(P - gFrame.camPos.xyz);
    float  g = e.size.z;
    float3 L = gFrame.ambient.w > 0.0 ? max(gSkySh[0].rgb, float3(0.0, 0.0, 0.0)) * (0.282095 * gFrame.ambient.w) : gFrame.ambient.rgb;
    if (gFrame.sunDir.w > 0.0)
        L += gFrame.sunColor.rgb * (sunVisibility(P, c.z) * phase4(dot(V, gFrame.sunDir.xyz), g));
    bool maps = (gFrame.counts.z & 1u) != 0u;
    if ((gFrame.counts.z & 2u) != 0u)
    {
        // The core's depth bins: every light whose sphere reaches this depth (exact at any depth, unlike the screen
        // tiles, which end at the nearest opaque surface).
        uint bin = gZBins[min(uint(max(c.z, 0.0) * gFrame.texel.z), gFrame.counts.y - 1u)];
        uint last = min(bin >> 16, gFrame.counts.x - 1u);
        for (uint k = bin & 0xFFFFu; k <= last && gFrame.counts.x > 0u; ++k)
            L += localLight(k, P, V, g, maps);
    }
    else
    {
        for (uint k = 0u; k < gFrame.counts.x; ++k)
            L += localLight(k, P, V, g, maps);
    }
    gLit[i] = float4(L, 0.0);
    uint at;
    AtomicAdd(gCounters[1], 1u, at);
    gList[at] = uint2(asuint(max(c.z, 0.0)), i);
    RETURN();
}
#endif

#if defined(PAD)
ROOT_SIGNATURE(ComputeRootSignature)
NUM_THREADS(256, 1, 1)
void CS_MAIN(SV_DispatchThreadID(uint3) id)
{
    INIT_MAIN;
    if (id.x >= gCounters[1] && id.x < gFrame.spawn.z)
        gList[id.x] = uint2(0u, 0u);
    RETURN();
}
#endif

#if defined(SORT_LOCAL)
GroupShared(uint2, gsList[1024]);

// One compare-exchange of the network's stage k, step j, by thread t of the group (local indices; base the group's
// first entry): descending where the global index's bit k is clear, so the list ends farthest first.
void exchange(uint t, uint k, uint j, uint base)
{
    uint i = 2u * j * (t / j) + (t % j);
    uint l = i + j;
    uint2 a = gsList[i];
    uint2 b = gsList[l];
    bool  down = ((base + i) & k) == 0u;
    if (down ? a.x < b.x : a.x > b.x)
    {
        gsList[i] = b;
        gsList[l] = a;
    }
}

ROOT_SIGNATURE(ComputeRootSignature)
NUM_THREADS(512, 1, 1)
void CS_MAIN(SV_GroupID(uint3) gid, SV_GroupIndex(uint) t)
{
    INIT_MAIN;
    uint base = gid.x * 1024u;
    uint K = gStep.kj.x;
    // The first sort of all: a group wholly past the list's end holds only padding, sorted already.
    if (K == 0u && base >= gCounters[1])
        RETURN();
    gsList[t] = gList[base + t];
    gsList[t + 512u] = gList[base + t + 512u];
    GroupMemoryBarrier();
    if (K == 0u)
    {
        for (uint k = 2u; k <= 1024u; k <<= 1u)
            for (uint j = k >> 1u; j > 0u; j >>= 1u)
            {
                exchange(t, k, j, base);
                GroupMemoryBarrier();
            }
    }
    else
    {
        for (uint j = 512u; j > 0u; j >>= 1u)
        {
            exchange(t, K, j, base);
            GroupMemoryBarrier();
        }
    }
    gList[base + t] = gsList[t];
    gList[base + t + 512u] = gsList[t + 512u];
    RETURN();
}
#endif

#if defined(SORT_GLOBAL)
ROOT_SIGNATURE(ComputeRootSignature)
NUM_THREADS(256, 1, 1)
void CS_MAIN(SV_DispatchThreadID(uint3) id)
{
    INIT_MAIN;
    uint k = gStep.kj.x, j = gStep.kj.y;
    if (id.x >= gFrame.spawn.z / 2u)
        RETURN();
    uint i = 2u * j * (id.x / j) + (id.x % j);
    uint l = i + j;
    uint2 a = gList[i];
    uint2 b = gList[l];
    bool  down = (i & k) == 0u;
    if (down ? a.x < b.x : a.x > b.x)
    {
        gList[i] = b;
        gList[l] = a;
    }
    RETURN();
}
#endif
