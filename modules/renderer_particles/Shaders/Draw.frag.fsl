// A particle's soft round sprite, premultiplied: fading where it nears the scene behind it (soft particles) and the
// camera, behind the volumetric fog in front of it. The second target is the reactive mask: how much of the pixel is
// particle, for TAA and the upscalers.
#include "ParticleData.h.fsl"
#include "Draw.srt.h"

STRUCT(VSOutput)
{
    DATA(float4, Position, SV_Position);
    DATA(float2, Corner, TEXCOORD0);
    DATA(float4, Color, TEXCOORD1);
    DATA(float2, Depth, TEXCOORD2);
};

STRUCT(PSOutput)
{
    DATA(float4, Color, SV_Target0);
    DATA(float, Reactive, SV_Target1);
};

ROOT_SIGNATURE(DefaultRootSignature)
PSOutput PS_MAIN(VSOutput In)
{
    INIT_MAIN;
    PSOutput Out;
    float r2 = dot(In.Corner, In.Corner);
    float shape = saturate(1.0 - r2);
    shape *= shape;
    float d = LoadTex2D(gDepth, NO_SAMPLER, int2(In.Position.xy), 0).r;
    float sceneZ = d > 0.0 ? gFrame.camPos.w / d : 1e9;
    float z = In.Depth.x;
    float fade = saturate((sceneZ - z) / max(gFrame.soft.x, 1e-4)) * saturate((z - gFrame.camPos.w) / max(gFrame.soft.y, 1e-4));
    float a = In.Color.a * shape * fade;
    if (a <= 1.0 / 1024.0)
        discard;
    float3 rgb = In.Color.rgb;
    if (gFrame.fog.x > 0.0)
    {
        float  p = log2(max(z, 0.0) * gFrame.fog.x + 1.0) * gFrame.fog.y;
        float2 uv = In.Position.xy * gFrame.screen.zw;
        float4 f = SampleLvlTex3D(gFogVolume, gSamplerBilinearClamp, float3(uv * gFrame.fog2.xy, (max(p - 1.0, 0.0) + 0.5) * gFrame.fog.z), 0.0);
        float  k = saturate(p);
        rgb = rgb * lerp(1.0, f.a, k) + f.rgb * k;
    }
    Out.Color = float4(rgb * a, In.Depth.y > 0.5 ? 0.0 : a);
    Out.Reactive = a;
    RETURN(Out);
}
