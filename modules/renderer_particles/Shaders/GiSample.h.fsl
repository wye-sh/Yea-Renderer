// Dynamic diffuse GI (renderer_gi; Majercik et al., "Dynamic Diffuse Global Illumination with Ray-Traced Irradiance
// Fields", JCGT 2019, as in RTXGI): the shared definitions every module reading or tracing the probes includes. The
// same file sits in renderer_gi, renderer (the core), renderer_rt, renderer_fog and renderer_particles; keep the copies
// identical (with frame.h's giGrid, giRotation, giIrradiance, giDistance and giProbeData).
//
// It reads only what the includer passes: the grid as four float4 (frame.h giGrid), and, for sampling, the textures
// and buffer the includer binds under the names it defines before including:
//   GI_IRRADIANCE (Tex2D float4), GI_DISTANCE (Tex2D float4), GI_PROBES (Buffer float4), GI_SAMPLER (bilinear clamp).
// Leave GI_IRRADIANCE undefined to get only the grid and ray helpers (ray tracing, blending).
//
// The grid (frame.h giGrid):
//   g0: xyz probe (0, 0, 0)'s place before relocation, w the frame number's low bits (which inactive probes trace)
//   g1: xyz spacing (m), w probes in all
//   g2: xyz probes along x, y, z (as floats), w rays a probe
//   g3: x 1 / irradiance atlas width, y 1 / its height, z 1 / distance atlas width, w 1 / its height
// Probe i = x + z * nx + y * nx * nz; its tile in each atlas is at column i % (nx * nz), row i / (nx * nz).
// Irradiance tiles are GI_IRR_TEXELS square with a one-texel border (GI_IRR_INNER inside), distance tiles
// GI_DIST_TEXELS (GI_DIST_INNER inside), both octahedral over the sphere (y up). Irradiance holds the cosine-weighted
// mean radiance about a direction (irradiance / pi: what the core's skyIrradiance returns); distance holds the mean
// distance to the nearest surface and its square, for Chebyshev visibility.
// A probe's data (GI_PROBES): xyz its relocation offset from its grid place, w its state: 0 inactive (traced only
// every 8th frame, to wake), 1 active, 2 active but not lit yet (traced, its tiles empty: nothing reads it until its
// first blend). Readers take only state 1 (giProbeLit).
// Rays (frame.h giRayOut): float4 per ray, probe-major: rgb radiance, a distance (negative: a backface, GI_MISS: none).
#ifndef RENDER_GI_SAMPLE_H
#define RENDER_GI_SAMPLE_H

#define GI_IRR_INNER   6u
#define GI_IRR_TEXELS  8u
#define GI_DIST_INNER  14u
#define GI_DIST_TEXELS 16u
#define GI_MISS        1e27
#define GI_PI          3.14159265

uint3 giCounts(float4 g2) { return uint3(g2.xyz + 0.5); }

uint3 giCoords(uint i, float4 g2)
{
    uint3 n = giCounts(g2);
    return uint3(i % n.x, i / (n.x * n.z), (i / n.x) % n.z);
}

uint giIndex(uint3 c, float4 g2)
{
    uint3 n = giCounts(g2);
    return c.x + c.z * n.x + c.y * n.x * n.z;
}

// Whether a probe in `state` holds light to read.
bool giProbeLit(float state) { return state > 0.5 && state < 1.5; }

// Whether probe i (in `state`) is traced this frame: active ones always, inactive ones every 8th frame to see whether
// the scene came to them.
bool giProbeTraced(uint i, float state, float4 g0)
{
    return state > 0.5 || ((i + uint(g0.w)) & 7u) == 0u;
}

// Probe i's place: its grid place and its relocation offset.
float3 giProbePosition(uint i, float3 offset, float4 g0, float4 g1, float4 g2)
{
    return g0.xyz + float3(giCoords(i, g2)) * g1.xyz + offset;
}

// Ray k of n: spherical Fibonacci directions, turned by this frame's rotation (frame.h giRotation, three rows).
float3 giRayDirection(uint k, uint n, float4 r0, float4 r1, float4 r2)
{
    const float golden = 0.61803398875;
    float  fk = float(k);
    float  phi = 2.0 * GI_PI * frac(fk * golden);
    float  cosTheta = 1.0 - (2.0 * fk + 1.0) / float(n);
    float  sinTheta = sqrt(saturate(1.0 - cosTheta * cosTheta));
    float3 d = float3(cos(phi) * sinTheta, sin(phi) * sinTheta, cosTheta);
    return normalize(float3(dot(r0.xyz, d), dot(r1.xyz, d), dot(r2.xyz, d)));
}

float2 giOctEncode(float3 d)
{
    float2 p = d.xz / (abs(d.x) + abs(d.y) + abs(d.z));
    if (d.y < 0.0)
        p = (float2(1.0, 1.0) - abs(p.yx)) * float2(p.x >= 0.0 ? 1.0 : -1.0, p.y >= 0.0 ? 1.0 : -1.0);
    return p; // -1..1
}

float3 giOctDecode(float2 p)
{
    float3 d = float3(p.x, 1.0 - abs(p.x) - abs(p.y), p.y);
    if (d.y < 0.0)
        d.xz = (float2(1.0, 1.0) - abs(d.zx)) * float2(d.x >= 0.0 ? 1.0 : -1.0, d.z >= 0.0 ? 1.0 : -1.0);
    return normalize(d);
}

// Where direction d falls in probe i's tile of an atlas with `inner` texels inside a one-texel border, in uv.
float2 giTileUv(uint i, float3 d, uint inner, float2 invSize, float4 g2)
{
    uint3  n = giCounts(g2);
    uint   row = n.x * n.z;
    float2 tile = float2(float(i % row), float(i / row)) * float(inner + 2u);
    float2 texel = tile + 1.0 + (giOctEncode(d) * 0.5 + 0.5) * float(inner);
    return texel * invSize;
}

#ifdef GI_IRRADIANCE
// The cosine-weighted mean radiance arriving at P about N from the probes round it (the 8 corners of its cell, each
// weighted by where P is, by facing it, and by Chebyshev visibility from its distance tile so light doesn't leak
// through walls), as the core's skyIrradiance. V: from the camera to P (unit). `inside` comes back 1 well inside the
// volume, falling to 0 a cell outside it (the caller blends towards its own ambient there).
float3 giIrradiance(float3 P, float3 N, float3 V, float4 g0, float4 g1, float4 g2, float4 g3, out(float) inside)
{
    float3 spacing = g1.xyz;
    float  minSpacing = min(spacing.x, min(spacing.y, spacing.z));
    // Off the surface, towards its normal and back towards the viewer (RTXGI's surface bias).
    float3 biased = P + (N * 0.2 - V * 0.8) * (0.3 * 0.75 * minSpacing);
    uint3  n = giCounts(g2);
    float3 rel = (biased - g0.xyz) / spacing;
    float3 hi = float3(n) - 1.0;
    float3 outside = max(-rel, float3(0.0, 0.0, 0.0)) + max(rel - hi, float3(0.0, 0.0, 0.0));
    inside = saturate(1.0 - max(outside.x, max(outside.y, outside.z)));
    if (inside <= 0.0)
        return float3(0.0, 0.0, 0.0);
    int3   base = clamp(int3(floor(rel)), int3(0, 0, 0), max(int3(n) - 2, int3(0, 0, 0)));
    float3 alpha = saturate(rel - float3(base));
    float3 sum = float3(0.0, 0.0, 0.0);
    float  total = 0.0;
    for (uint k = 0u; k < 8u; ++k)
    {
        uint3 off = uint3(k & 1u, (k >> 1u) & 1u, (k >> 2u) & 1u);
        uint3 c = min(uint3(base) + off, n - 1u);
        uint  i = giIndex(c, g2);
        float4 data = GI_PROBES[i];
        if (!giProbeLit(data.w))
            continue; // inactive (inside a wall, or nothing near), or not lit yet
        float3 probe = g0.xyz + float3(c) * spacing + data.xyz;
        float3 tri = lerp(float3(1.0, 1.0, 1.0) - alpha, alpha, float3(off));
        float  w = tri.x * tri.y * tri.z;
        // Facing: smooth, never quite zero (probes behind still help where nothing else does).
        float3 toProbe = normalize(probe - P);
        float  facing = (dot(toProbe, N) + 1.0) * 0.5;
        float  wv = facing * facing + 0.2;
        // Chebyshev visibility: is the biased point within what the probe sees that way?
        float3 fromProbe = biased - probe;
        float  dist = length(fromProbe);
        float2 m = SampleLvlTex2D(GI_DISTANCE, GI_SAMPLER, giTileUv(i, fromProbe / max(dist, 1e-6), GI_DIST_INNER, g3.zw, g2), 0.0).xy;
        if (dist > m.x)
        {
            float variance = abs(m.x * m.x - m.y);
            float d = dist - m.x;
            float cheb = variance / (variance + d * d);
            wv *= max(cheb * cheb * cheb, 0.0);
        }
        wv = max(wv, 1e-6);
        if (wv < 0.2)
            wv *= wv * wv * (1.0 / 0.04); // crush tiny weights (RTXGI)
        w *= wv;
        sum += SampleLvlTex2D(GI_IRRADIANCE, GI_SAMPLER, giTileUv(i, N, GI_IRR_INNER, g3.xy, g2), 0.0).rgb * w;
        total += w;
    }
    if (total <= 0.0)
        inside = 0.0; // no probe round P holds light (all off, or not lit yet): the caller's own ambient
    return total > 0.0 ? sum / total : float3(0.0, 0.0, 0.0);
}

// The mean radiance round P from every way (fog, particles): the probes' irradiance up and down, averaged, without
// visibility (no surface to bias off).
float3 giAmbient(float3 P, float4 g0, float4 g1, float4 g2, float4 g3, out(float) inside)
{
    uint3  n = giCounts(g2);
    float3 rel = (P - g0.xyz) / g1.xyz;
    float3 hi = float3(n) - 1.0;
    float3 outside = max(-rel, float3(0.0, 0.0, 0.0)) + max(rel - hi, float3(0.0, 0.0, 0.0));
    inside = saturate(1.0 - max(outside.x, max(outside.y, outside.z)));
    if (inside <= 0.0)
        return float3(0.0, 0.0, 0.0);
    int3   base = clamp(int3(floor(rel)), int3(0, 0, 0), max(int3(n) - 2, int3(0, 0, 0)));
    float3 alpha = saturate(rel - float3(base));
    float3 sum = float3(0.0, 0.0, 0.0);
    float  total = 0.0;
    for (uint k = 0u; k < 8u; ++k)
    {
        uint3 off = uint3(k & 1u, (k >> 1u) & 1u, (k >> 2u) & 1u);
        uint3 c = min(uint3(base) + off, n - 1u);
        uint  i = giIndex(c, g2);
        if (!giProbeLit(GI_PROBES[i].w))
            continue;
        float3 tri = lerp(float3(1.0, 1.0, 1.0) - alpha, alpha, float3(off));
        float  w = tri.x * tri.y * tri.z;
        float3 up = SampleLvlTex2D(GI_IRRADIANCE, GI_SAMPLER, giTileUv(i, float3(0.0, 1.0, 0.0), GI_IRR_INNER, g3.xy, g2), 0.0).rgb;
        float3 down = SampleLvlTex2D(GI_IRRADIANCE, GI_SAMPLER, giTileUv(i, float3(0.0, -1.0, 0.0), GI_IRR_INNER, g3.xy, g2), 0.0).rgb;
        sum += (up + down) * (0.5 * w);
        total += w;
    }
    if (total <= 0.0)
        inside = 0.0; // no probe round P holds light (all off, or not lit yet): the caller's own ambient
    return total > 0.0 ? sum / total : float3(0.0, 0.0, 0.0);
}
#endif

#endif
