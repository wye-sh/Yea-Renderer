module renderer

# The scene games build through the exports below. Rows are never moved: removed ones are marked
# dead and reused, so handles (row | generation << 20) stay valid.
table Mesh none 1024
  u32 firstVertex
  u32 vertexCount
  u32 firstIndex
  u32 indexCount
  float3 center
  float radius
end
# Each mesh row's next simpler version (built-in shapes make a chain of them, the finest first, which is the
# row they return), and how far this row's outline is off the true shape (object units): the renderer draws the
# simplest whose error stays under lod_error on screen. Rows match Mesh's; a mesh with none has next 4294967295.
table MeshLod none 1024
  u32 next
  float error
end
table Vertex none 262144
  float3 pos
  float3 normal
end
table Index none 1048576
  u32 v
end
table Material none 4096
  float3 albedo
  float roughness
  float metallic
  float reflectance
  float3 emissive
  u32 reflections
  u32 doubleSided
  u32 gen
  u32 alive
end
table Instance none 65536
  u32 mesh
  u32 material
  float3 pos
  float4 rot
  float3 scale
  u32 shadow
  u64 moved
  u32 gen
  u32 alive
end
# Each instance's detail kept with distance (instance_lod_quality): rows match Instance's; 0 or none reads as 1.
table InstanceLod none 65536
  float quality
end
table Light none 4096
  u32 type
  float3 pos
  float3 dir
  float3 color
  float intensity
  float range
  float inner
  float outer
  float3 tangent
  float2 size
  u32 shadow
  u32 gen
  u32 alive
end
# Images for rect lights (light_image): up to 16, each 65536 rows (256 x 256, sRGB rgba8, row 0 at the top) one after
# another; LightLook's rows match Light's (image + 1, 0 none).
table LightTexel none 1048576
  u32 rgba
end
table LightLook none 4096
  u32 image
end

# Meshes: built-in shapes, or your own, vertex by vertex. Each returns a mesh id (4294967295 when full).
export u32 mesh_box()
export u32 mesh_sphere(u32 segments)
export u32 mesh_plane()
export u32 mesh_cylinder(u32 segments)
export u32 mesh_cone(u32 segments)
export u32 mesh_torus(float thickness, u32 segments)
export bool mesh_begin()
export u32 mesh_vertex(float3 pos, float3 normal)
# A triangle faces where cross(b - a, c - a) points: counter-clockwise around its outward normal.
# Only that side is drawn unless its material is double-sided.
export void mesh_triangle(u32 a, u32 b, u32 c)
export u32 mesh_end()

export handle material_add(float3 albedo, float roughness, float metallic)
export void material_set(handle m, float3 albedo, float roughness, float metallic)
export void material_emissive(handle m, float3 color, float luminance)
# Whether the material shows reflections of its surroundings (on by default), apart from how shiny
# or metallic it is. Off: no reflected image (probes or sky), only the sky's soft light on it.
export void material_reflections(handle m, bool on)
# Whether the material's surfaces are seen from both sides (off by default). Off: only from the side
# its triangles face (see mesh_triangle), which is cheaper; for closed shapes. On: open or thin
# surfaces such as leaves, cloth or a single plane seen from below.
export void material_double_sided(handle m, bool on)

export handle instance_add(u32 mesh, handle material)
export void instance_place(handle i, float3 pos, float4 rotation, float3 scale)
export void instance_material(handle i, handle material)
export void instance_shadow(handle i, bool cast)
# Detail kept with distance for this instance: its lod_error divided by quality (2: finer versions twice as far; 1 as
# every other instance).
export void instance_lod_quality(handle i, float quality)
export void instance_remove(handle i)
export u32 instance_count()

# type: 0 directional (the sun), 1 point, 2 spot; area lights 3 rect, 4 disc, 5 sphere, 6 tube. Intensity: lux for
# the sun, candela otherwise (an area light's seen face-on; its surface's luminance is that over its area).
export handle light_add(u32 type)
# A light's size (metres) and its roll. Rect: width along `across` by height; disc: its two diameters, the same way;
# sphere: its radius in width; tube: its length (along light_place's dir) in width, its radius in height; point and
# spot: their source radius in width, for soft shadows (0: the shadows' light_size). Rects and discs light the side
# light_place's dir points to. Area lights default to 1 x 1 m (spheres and tubes 0.1 m radius).
export void light_size(handle l, float width, float height, float3 across)
# An image across a rect light (a window, a stained-glass panel, a screen): light_image_begin(width, height), then
# light_image_pixel(linear rgb, 0 to 1) for every pixel, row by row from the top left, then light_image_end, which
# returns the image (4294967295 when 16 are made, or on a short count). Kept at 256 x 256. light_image(l, image) puts it
# on a rect light (4294967295: none), its top along the light's height: it tints the light, so the light's candela
# holds where the image is white and its average sets the light's output.
export bool light_image_begin(u32 width, u32 height)
export void light_image_pixel(float3 rgb)
export u32 light_image_end()
export void light_image(handle l, u32 image)
export void light_place(handle l, float3 pos, float3 dir)
export void light_color(handle l, float3 color, float intensity)
export void light_range(handle l, float range)
export void light_cone(handle l, float inner_deg, float outer_deg)
export void light_shadow(handle l, bool cast)
export void light_remove(handle l)
export u32 light_count()

export void camera(float3 eye, float3 target, float fov_deg)
# Removes every mesh, material, instance and light.
export void clear()
# Changes whenever the scene a module built is gone (clear(), Reset State, a material layout change), never on a
# reload that keeps it: a module that adds meshes, materials or instances builds them again when it changes. Never 0.
export u32 scene_epoch()
# The Model Viewer's preview (renderer_models' preview.h, a RenderPreview*): one model alone under a studio rig, into
# the caller's own targets, from its draw(YEA_PASS_RENDER). False: nothing drawn (the renderer isn't ready).
export bool preview_draw(u64 preview)

import renderer_culling bool cull_prepare(u64 frame) = false
import renderer_culling void cull_run(u64 frame)
import renderer_shadows bool shadows_prepare(u64 frame) = false
import renderer_shadows void shadows_render(u64 frame)
import renderer_shadows bool light_shadows_on() = false
import renderer_taa bool taa_prepare(u64 frame) = false
import renderer_taa void taa_resolve(u64 frame)
import renderer_ao bool ao_prepare(u64 frame) = false
import renderer_ao void ao_run(u64 frame)
import renderer_contact bool contact_prepare(u64 frame) = false
import renderer_contact void contact_run(u64 frame)
import renderer_probes bool probes_prepare(u64 frame) = false
import renderer_probes void probes_render(u64 frame)
import renderer_ssr bool ssr_prepare(u64 frame) = false
import renderer_ssr void ssr_run(u64 frame)
import renderer_vrs bool vrs_prepare(u64 frame) = false
import renderer_vrs void vrs_run(u64 frame)
import renderer_rt bool rt_pick(u64 frame) = false
import renderer_rt bool rt_prepare(u64 frame) = false
import renderer_rt void rt_run(u64 frame)
import renderer_upscale bool upscale_prepare(u64 frame) = false
import renderer_upscale void upscale_run(u64 frame)
import renderer_post u64 post_prepare(u64 frame) = 0
import renderer_post void post_run(u64 frame)

category Exposure
setting float exposure_ev 0
player exposure_ev
setting bool auto_exposure true
setting float manual_ev100 9
setting float adapt_speed 1.5 0 inf
# How the bright HDR image is fitted to the screen. Khronos PBR Neutral keeps material colours true; AgX rolls
# bright, saturated light (coloured lamps, the sun) towards white as film does; Hable Filmic is the Uncharted 2
# curve; Reinhard compresses brightness alone; None clips; ACES Fitted is Stephen Hill's fit of the film
# industry's ACES look (contrasty, warm highlights); Tony McMapface is Tomasz Stachowiak's neutral 3D table.
setting choice tonemapper Khronos_PBR_Neutral Khronos_PBR_Neutral AgX Hable_Filmic Reinhard None ACES_Fitted Tony_McMapface
category Anti-aliasing
setting int msaa 4 1 8
setting float specular_aa 1 0 2
category Sky
setting color sky_color 0.22 0.38 0.85
setting color horizon_color 0.75 0.8 0.9
setting color ground_color 0.3 0.27 0.24
setting float sky_luminance 40 0 inf
setting float ambient 1 0 inf
setting float sun_disk 0.6 0 5
category Camera
setting float near_plane 0.05 0.01 inf
category Performance
setting bool gpu_timings true
# How far a mesh's outline may be off on screen (display pixels) before a simpler version of it is drawn; 0 always
# draws the finest. Built-in shapes only: meshes made vertex by vertex have one version.
setting float lod_error 0.5 0 inf
player lod_error
