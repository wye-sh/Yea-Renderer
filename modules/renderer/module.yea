module renderer

# The scene games build through the exports below. Rows are never moved: removed ones are marked
# dead and reused, so handles (row | generation << 20) stay valid.
table Mesh none 1024
  u32 firstVertex
  u32 vertexCount
  u32 firstIndex
  u32 indexCount
  float3 center
  float radius
end
# Each mesh row's next simpler version (built-in shapes make a chain of them, the finest first, which is the
# row they return), and how far this row's outline is off the true shape (object units): the renderer draws the
# simplest whose error stays under lod_error on screen. Rows match Mesh's; a mesh with none has next 4294967295.
table MeshLod none 1024
  u32 next
  float error
end
# A vertex as the GPU streams have it: its position, then its attributes packed as frame.h's RENDER_ATTRIBUTE_STRIDE says
# (octahedral normal and tangent, uv0, colour).
table Vertex none 1048576
  float3 pos
  u32 normal
  u32 tangent
  float2 uv
  u32 color
end
table Index none 4194304
  u32 v
end
# Skinned meshes (skin.cpp): a Mesh row's first SkinVertex row + 1 (0: not skinned; rows match Mesh's, and may be fewer),
# and each vertex's 4 bones (u16 pairs, the first low) and weights (unorm16 pairs, summing to 65535).
table MeshSkin none 1024
  u32 firstSkin
end
table SkinVertex none 1048576
  u32 bones01
  u32 bones23
  u32 weights01
  u32 weights23
end
table Material none 4096
  float3 albedo
  float roughness
  float metallic
  float reflectance
  float3 emissive
  u32 reflections
  u32 doubleSided
  u32 gen
  u32 alive
end
table Instance none 65536
  u32 mesh
  u32 material
  float3 pos
  float4 rot
  float3 scale
  u32 shadow
  u64 moved
  u32 gen
  u32 alive
end
# Each instance's detail kept with distance (instance_lod_quality): rows match Instance's; 0 or none reads as 1.
table InstanceLod none 65536
  float quality
end
table Light none 4096
  u32 type
  float3 pos
  float3 dir
  float3 color
  float intensity
  float range
  float inner
  float outer
  float3 tangent
  float2 size
  u32 shadow
  u32 gen
  u32 alive
end
# Texture maps (textures.cpp): each a mip chain at `offset` in a file (its path in TexturePath), which the renderer reads
# and uploads in its own frames, a few at a time, and again after it restarts. Rows as Mesh's (handles row | gen << 20);
# a row is a slot in the shaders' texture array.
table TextureMap none 1024
  u32 pathFirst
  u32 pathLength
  u64 offset
  u64 bytes
  u32 format
  u32 width
  u32 height
  u32 mips
  u32 gen
  u32 alive
end
table TexturePath none 262144
  u8 c
end
# Blended (see-through) materials (material_blend), at their Material row: opacity 0 opaque.
table MaterialBlend none 4096
  float opacity
end
# How see-through materials bend and tint what is behind them (material_refraction), at their Material row: set 1 given.
table MaterialRefraction none 4096
  float ior
  float thickness
  u32 shape
  float3 tint
  u32 set
end
# A material's texture maps (material_maps), at its Material row: each map's texture handle (4294967295 none), the
# factors the maps are multiplied by, and its alpha cutoff (0: opaque). set: 1 maps given, 2 factors given.
table MaterialMap none 4096
  u32 baseColor
  u32 orm
  u32 normal
  u32 emissive
  float4 baseFactor
  float roughness
  float metallic
  float normalScale
  float occlusion
  float cutoff
  u32 set
end
# Decals (decal_add): boxes that paint what lies inside them, applied in the forward pass through the light culling's
# tiles (renderer_culling), in order of priority then age. Rows as Light's (handles row | gen << 20).
table Decal none 4096
  float3 pos
  float4 rot
  float3 half
  float4 albedo
  float roughness
  float metallic
  float3 emissive
  float4 weights
  u32 shape
  float edge
  float noise
  float angle
  u32 baseColor
  u32 normal
  u32 orm
  float normalScale
  i32 priority
  u32 order
  u32 gen
  u32 alive
end
# Images for rect lights (light_image): up to 16, each 65536 rows (256 x 256, sRGB rgba8, row 0 at the top) one after
# another; LightLook's rows match Light's (image + 1, 0 none).
table LightTexel none 1048576
  u32 rgba
end
table LightLook none 4096
  u32 image
end

# Meshes: built-in shapes, or your own, vertex by vertex. Each returns a mesh id (4294967295 when full).
export u32 mesh_box()
export u32 mesh_sphere(u32 segments)
export u32 mesh_plane()
export u32 mesh_cylinder(u32 segments)
export u32 mesh_cone(u32 segments)
export u32 mesh_torus(float thickness, u32 segments)
export bool mesh_begin()
export u32 mesh_vertex(float3 pos, float3 normal)
# A triangle faces where cross(b - a, c - a) points: counter-clockwise around its outward normal.
# Only that side is drawn unless its material is double-sided.
export void mesh_triangle(u32 a, u32 b, u32 c)
export u32 mesh_end()
# A cooked mesh in one call (renderer_models' loader): vertex_count positions (float3 each) and attributes (5 u32 each, as
# frame.h's RENDER_ATTRIBUTE_STRIDE), index_count u32 indices from 0, its triangles counter-clockwise around their outward
# normal. Its mesh, or 4294967295 when the tables are full or a mesh is being built.
export u32 mesh_packed(u64 positions, u64 attributes, u32 vertex_count, u64 indices, u32 index_count)
# Makes `simpler` the next version of `mesh` (its LOD chain, the finest first) and sets how far `mesh` strays from the
# true shape (object units); `simpler` 4294967295 ends the chain there.
export void mesh_lod(u32 mesh, float error, u32 simpler)
# A skinned mesh, right after it is made: its vertices' bones and weights (renderer_models' rmodel.h
# RmodelSkinVertex[its vertex count]) and the bounds its animation reaches (object units).
export void mesh_skin(u32 mesh, u64 skin, float3 lo, float3 hi)

export handle material_add(float3 albedo, float roughness, float metallic)
export void material_set(handle m, float3 albedo, float roughness, float metallic)
export void material_emissive(handle m, float3 color, float luminance)
# Whether the material shows reflections of its surroundings (on by default), apart from how shiny
# or metallic it is. Off: no reflected image (probes or sky), only the sky's soft light on it.
export void material_reflections(handle m, bool on)
# Whether the material's surfaces are seen from both sides (off by default). Off: only from the side
# its triangles face (see mesh_triangle), which is cheaper; for closed shapes. On: open or thin
# surfaces such as leaves, cloth or a single plane seen from below.
export void material_double_sided(handle m, bool on)
# A texture map from a cooked model's file (renderer_models' rmodel.h RmodelTexture): `path` a C string, the full path of
# the file; its mips (`mips` of them, the largest `width` x `height` first) `bytes` long at `offset`. format: 1 BC7 sRGB,
# 2 BC7 linear, 3 BC5. The renderer reads it in its own frames (never during this call), leaving out top mips for
# texture_detail or GPU memory. Its texture, 4294967295 when full.
export handle texture_add(u64 path, u64 offset, u64 bytes, u32 format, u32 width, u32 height, u32 mips)
# 0 no such texture, 1 loading, 2 drawn with, 3 failed (its file unreadable or the GPU refused it).
export u32 texture_state(handle t)
export void texture_remove(handle t)
# A material's texture maps (4294967295: none): base colour (rgb, alpha), ORM (occlusion, roughness, metallic), normal
# (tangent space x, y) and emissive. With a map, the material draws factor times map (factors from material_factors);
# until it has loaded, and without one, as material_set and material_emissive say.
export void material_maps(handle m, handle base_color, handle orm, handle normal, handle emissive)
# The factors the maps multiply (glTF's): base colour and alpha, roughness, metallic, the normal map's x and y scale, and
# how strongly the occlusion map darkens (0 not at all, 1 fully).
export void material_factors(handle m, float4 base_color, float roughness, float metallic, float normal_scale, float occlusion)
# Alpha-tested (cut out) where base colour alpha is below cutoff, for leaves, fences and cloth; 0 opaque (the default).
export void material_alpha(handle m, float cutoff)
# See-through, blended over what is behind (glass, lenses, visors, water): opacity times the base colour's own alpha
# (material_factors' base_color alpha, its map's and the vertex colour's) is how much of the surface is there; its
# reflections stay whole (clear glass still reflects). Drawn sorted back to front after the opaque scene, lit as every
# surface is, through fog. 0 opaque (the default). Blended surfaces cast no shadows and write no depth.
export void material_blend(handle m, float opacity)
# How a see-through material bends, blurs and tints what is seen through it: ior its index of refraction (glass 1.5,
# water 1.33, 1 none), thickness (m) and shape: 0 thin (a pane or a sheet that thick: what is behind shifts a little), 1
# solid (a ball or a block about that thick: what is behind is bent and flipped as through a lens). tint: the colour
# that gets through (1, 1, 1 clear; coloured glass). Rough materials blur what is behind them by their roughness and how
# far behind it lies (frosted glass). Without it: thin, no shift, clear. Refraction sees the opaque scene; a see-through
# surface behind another shows through unbent.
export void material_refraction(handle m, float ior, float thickness, u32 shape, float3 tint)

export handle instance_add(u32 mesh, handle material)
export void instance_place(handle i, float3 pos, float4 rotation, float3 scale)
export void instance_material(handle i, handle material)
export void instance_shadow(handle i, bool cast)
# Detail kept with distance for this instance: its lod_error divided by quality (2: finer versions twice as far; 1 as
# every other instance).
export void instance_lod_quality(handle i, float quality)
# An instance of a skinned mesh, posed this frame: its palette (3x4 rows a bone, model space; the mesh's bones index it),
# called every frame it moves (renderer_models does). Without one this frame it stands in its bind pose.
export void instance_pose(handle i, u64 palette, u32 bones)
export void instance_remove(handle i)
export u32 instance_count()

# type: 0 directional (the sun), 1 point, 2 spot; area lights 3 rect, 4 disc, 5 sphere, 6 tube. Intensity: lux for
# the sun, candela otherwise (an area light's seen face-on; its surface's luminance is that over its area).
export handle light_add(u32 type)
# A light's size (metres) and its roll. Rect: width along `across` by height; disc: its two diameters, the same way;
# sphere: its radius in width; tube: its length (along light_place's dir) in width, its radius in height; point and
# spot: their source radius in width, for soft shadows (0: the shadows' light_size). Rects and discs light the side
# light_place's dir points to. Area lights default to 1 x 1 m (spheres and tubes 0.1 m radius).
export void light_size(handle l, float width, float height, float3 across)
# An image across a rect light (a window, a stained-glass panel, a screen): light_image_begin(width, height), then
# light_image_pixel(linear rgb, 0 to 1) for every pixel, row by row from the top left, then light_image_end, which
# returns the image (4294967295 when 16 are made, or on a short count). Kept at 256 x 256. light_image(l, image) puts it
# on a rect light (4294967295: none), its top along the light's height: it tints the light, so the light's candela
# holds where the image is white and its average sets the light's output.
export bool light_image_begin(u32 width, u32 height)
export void light_image_pixel(float3 rgb)
export u32 light_image_end()
export void light_image(handle l, u32 image)
export void light_place(handle l, float3 pos, float3 dir)
export void light_color(handle l, float3 color, float intensity)
export void light_range(handle l, float range)
export void light_cone(handle l, float inner_deg, float outer_deg)
export void light_shadow(handle l, bool cast)
export void light_remove(handle l)
export u32 light_count()

# Decals: paint on whatever lies inside a box (a scorch, a puddle, a sign, dirt, a painted line), projected along the
# box's own -z (its local z: rotation applied to (0, 0, 1) points back out of the surface). pos its centre, half its half
# size (m): x and y across the paint, z how deep it reaches. Its handle, 4294967295 when 4096 are made.
export handle decal_add(float3 pos, float4 rotation, float3 half)
export void decal_place(handle d, float3 pos, float4 rotation, float3 half)
# What it paints: albedo with opacity (how much of the surface's own colour it covers), roughness, metallic and an
# emissive glow (colour times luminance, nits). weights: how much of each it applies, x colour (and glow), y roughness, z
# metallic, w the normal (towards its normal map's, or flat without one); 0 leaves that part as the surface had it. A wet
# puddle: dark albedo at colour 0.3, roughness 0.05 at 1, normal 1 (flat water over the bumps).
export void decal_look(handle d, float4 albedo, float roughness, float metallic, float3 emissive, float luminance, float4 weights)
# Its outline: shape 0 a soft ellipse, 1 a rectangle; edge (0 to 1) how much of it fades out towards the rim; noise (0
# to 1) how ragged and patchy it is (splats, dirt, rust). angle (degrees): surfaces turned further than this from facing
# along its z are left unpainted, fading over the last 15.
export void decal_shape(handle d, u32 shape, float edge, float noise, float angle_deg)
# Texture maps (texture_add's handles; 4294967295 none) across the box, its top along y: base colour (rgb times albedo,
# alpha times opacity), a tangent-space normal map (BC5 x, y) times normal_scale, and ORM (roughness and metallic times
# decal_look's). With a base colour map, its alpha replaces the shape's outline.
export void decal_maps(handle d, handle base_color, handle normal, handle orm, float normal_scale)
# Higher priorities paint over lower ones; equal ones in the order they were added.
export void decal_priority(handle d, i32 priority)
export void decal_remove(handle d)
export void decal_clear()

export void camera(float3 eye, float3 target, float fov_deg)
# Removes every mesh, material, instance, light and decal.
export void clear()
# Changes whenever the scene a module built is gone (clear(), Reset State, a material layout change), never on a
# reload that keeps it: a module that adds meshes, materials or instances builds them again when it changes. Never 0.
export u32 scene_epoch()
# The Model Viewer's preview (renderer_models' preview.h, a RenderPreview*): one model alone under a studio rig, into
# the caller's own targets, from its draw(YEA_PASS_RENDER). False: nothing drawn (the renderer isn't ready).
export bool preview_draw(u64 preview)

import renderer_culling bool cull_prepare(u64 frame) = false
import renderer_culling void cull_run(u64 frame)
import renderer_shadows bool shadows_prepare(u64 frame) = false
import renderer_shadows void shadows_render(u64 frame)
import renderer_shadows bool light_shadows_on() = false
import renderer_taa bool taa_prepare(u64 frame) = false
import renderer_taa void taa_resolve(u64 frame)
import renderer_ao bool ao_prepare(u64 frame) = false
import renderer_ao void ao_run(u64 frame)
import renderer_contact bool contact_prepare(u64 frame) = false
import renderer_contact void contact_run(u64 frame)
import renderer_probes bool probes_prepare(u64 frame) = false
import renderer_probes void probes_render(u64 frame)
import renderer_ssr bool ssr_prepare(u64 frame) = false
import renderer_ssr void ssr_run(u64 frame)
import renderer_vrs bool vrs_prepare(u64 frame) = false
import renderer_vrs void vrs_run(u64 frame)
import renderer_rt bool rt_pick(u64 frame) = false
import renderer_rt bool rt_prepare(u64 frame) = false
import renderer_rt void rt_run(u64 frame)
import renderer_upscale bool upscale_prepare(u64 frame) = false
import renderer_upscale void upscale_run(u64 frame)
import renderer_post u64 post_prepare(u64 frame) = 0
import renderer_sky bool sky_prepare(u64 frame) = false
import renderer_sky void sky_run(u64 frame)
import renderer_fog bool fog_prepare(u64 frame) = false
import renderer_fog void fog_run(u64 frame)
import renderer_fog bool fog_on() = false
import renderer_particles bool particles_on() = false
import renderer_particles bool particles_prepare(u64 frame) = false
import renderer_particles void particles_run(u64 frame)
import renderer_particles bool particles_draw_begin(u64 frame) = false
import renderer_particles void particles_draw(u64 frame, u32 run)
import renderer_particles void particles_draw_end(u64 frame)
import renderer_post void post_run(u64 frame)
import renderer_gi bool gi_prepare(u64 frame) = false
import renderer_gi void gi_run(u64 frame)

category Exposure
setting float exposure_ev 0
player exposure_ev
setting bool auto_exposure true
setting float manual_ev100 9
setting float adapt_speed 1.5 0 inf
# How much auto exposure brightens scenes darker than a sunset (dusk, night, dim interiors): 1 all the way, as bright as
# day; lower keeps them looking dark.
setting float dark_adaptation 0.6 0 1
# How the bright HDR image is fitted to the screen. Khronos PBR Neutral keeps material colours true; AgX rolls
# bright, saturated light (coloured lamps, the sun) towards white as film does; Hable Filmic is the Uncharted 2
# curve; Reinhard compresses brightness alone; None clips; ACES Fitted is Stephen Hill's fit of the film
# industry's ACES look (contrasty, warm highlights); Tony McMapface is Tomasz Stachowiak's neutral 3D table.
setting choice tonemapper Khronos_PBR_Neutral Khronos_PBR_Neutral AgX Hable_Filmic Reinhard None ACES_Fitted Tony_McMapface
category Anti-aliasing
setting int msaa 4 1 8
setting float specular_aa 1 0 2
category Sky
setting color sky_color 0.22 0.38 0.85
setting color horizon_color 0.75 0.8 0.9
setting color ground_color 0.3 0.27 0.24
setting float sky_luminance 40 0 inf
setting float ambient 1 0 inf
setting float sun_disk 0.6 0 5
category Camera
setting float near_plane 0.05 0.01 inf
category Performance
setting bool gpu_timings true
# Decals (decal_add) painted on the scene; off saves their cost.
setting bool decals true
# Glass bends and blurs what is behind it (material_refraction, rough see-through surfaces); off: seen straight through,
# unblurred (saves a copy of the scene and its blurred levels while glass is in view).
setting bool refraction true
# How far a mesh's outline may be off on screen (display pixels) before a simpler version of it is drawn; 0 always
# draws the finest. Built-in shapes only: meshes made vertex by vertex have one version.
setting float lod_error 0.5 0 inf
player lod_error
# Texture maps' finest detail: Half and Quarter leave out their largest mips, for GPUs short of memory (the renderer also
# leaves out more by itself when the GPU's free memory can't hold a texture).
setting choice texture_detail Full Full Half Quarter
player texture_detail
