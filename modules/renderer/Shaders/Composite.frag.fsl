// Exposure and tonemapping per MSAA sample, then the average: edges against bright lights stay
// smooth. Tonemappers (renderer's tonemapper choice, in its order): Khronos PBR Neutral (from its
// specification), AgX (our own: below), Hable's filmic curve, Reinhard on luminance, none, ACES (Hill's fit)
// or Tony McMapface (its table). After TAA, an optional contrast-limited sharpen of the tonemapped
// image (never fed back into TAA's history).
STRUCT(CompositeData)
{
    DATA(uint4, mode, None);    // x tonemapper, y encode sRGB, z samples, w width | height << 16
    DATA(float4, params, None); // x sharpen 0..1, y light shadow atlas inset in pixels (0 off), z its size in texels,
                                // w a fixed exposure without dither (F1's view modes), 0 off
    DATA(uint4, rates, None);   // x Show Rates (renderer_vrs), y its tile in pixels
};

#include "Composite.srt.h"

STRUCT(VSOutput)
{
    DATA(float4, Position, SV_Position);
    DATA(float2, UV, TEXCOORD0);
};

float3 pbrNeutral(float3 color)
{
    float startCompression = 0.8 - 0.04;
    float desaturation = 0.15;
    float x = min(color.r, min(color.g, color.b));
    float offset = x < 0.08 ? x - 6.25 * x * x : 0.04;
    color -= float3(offset, offset, offset);
    float peak = max(color.r, max(color.g, color.b));
    if (peak < startCompression)
        return color;
    float d = 1.0 - startCompression;
    float newPeak = 1.0 - d * d / (peak + d - startCompression);
    color *= newPeak / peak;
    float g = 1.0 - 1.0 / (desaturation * (peak - newPeak) + 1.0);
    return lerp(color, float3(newPeak, newPeak, newPeak), g);
}

float3 hableCurve(float3 x)
{
    float A = 0.15;
    float B = 0.50;
    float C = 0.10;
    float D = 0.20;
    float E = 0.02;
    float F = 0.30;
    return ((x * (A * x + C * B) + D * E) / (x * (A * x + B) + D * F)) - E / F;
}

// AgX (Sobotka's method, our own constants): the colour is read as weights of primaries pulled in towards white
// (Rec.709's, 15/10/15 % closer to D65 and turned 2/-1/-3 degrees about it, then the RGB-to-RGB matrix
// from them), so bright saturated light desaturates as it brightens instead of clipping to a
// pure hue; then log2 exposure from 10 stops under to 6.5 over middle grey into 0..1, an S-curve through middle
// grey (slope 2.4, soft shoulder and toe), the inverse matrix back to Rec.709, and the curve's display gamma (2.2)
// undone, since sRGB encoding follows.
#define AGX_MIN_EV -12.47
#define AGX_MAX_EV 4.03
float agxCurve(float x)
{
    const float x0 = (-2.4739312 - AGX_MIN_EV) / (AGX_MAX_EV - AGX_MIN_EV); // log2(0.18)
    const float y0 = 0.45865;                                                  // 0.18 ^ (1 / 2.2)
    const float slope = 2.4;
    float d = (x - x0) * slope;
    float limit = d > 0.0 ? 1.0 - y0 : y0;
    float r = abs(d) / limit;
    return y0 + d / pow(1.0 + r * r * r, 1.0 / 3.0);
}

float3 agx(float3 c)
{
    float3 v = float3(dot(c, float3(0.949810, 0.053343, -0.003153)), dot(c, float3(0.047125, 0.859473, 0.093402)),
                      dot(c, float3(0.026100, 0.031170, 0.942730)));
    v = (log2(max(v, float3(1e-10, 1e-10, 1e-10))) - AGX_MIN_EV) / (AGX_MAX_EV - AGX_MIN_EV);
    v = saturate(v);
    v = float3(agxCurve(v.x), agxCurve(v.y), agxCurve(v.z));
    v = float3(dot(v, float3(1.055835, -0.065894, 0.010060)), dot(v, float3(-0.054913, 1.171127, -0.116214)),
               dot(v, float3(-0.027416, -0.036897, 1.064313)));
    return pow(saturate(v), float3(2.2, 2.2, 2.2));
}

// ACES Fitted, compiled only while TONEMAPPER_ACES_FITTED is 1 (a build that bakes in another tonemapper sets it
// to 0, and its licence entry then ships nothing; mode 5 is then Khronos PBR Neutral).
#ifndef TONEMAPPER_ACES_FITTED
#define TONEMAPPER_ACES_FITTED 1
#endif
#if TONEMAPPER_ACES_FITTED
// ACES Fitted: Stephen Hill's fit of ACES's reference rendering and sRGB output transforms, from MJP's BakingLab
// (MIT, licenses.json): into ACES's working space with its saturation, the fitted curve, back out to Rec.709.
float3 acesFitted(float3 c)
{
    c = float3(dot(c, float3(0.59719, 0.35458, 0.04823)), dot(c, float3(0.07600, 0.90834, 0.01566)),
               dot(c, float3(0.02840, 0.13383, 0.83777)));
    float3 a = c * (c + 0.0245786) - 0.000090537;
    float3 b = c * (0.983729 * c + 0.4329510) + 0.238081;
    c = a / b;
    return float3(dot(c, float3(1.60475, -0.53108, -0.07367)), dot(c, float3(-0.10208, 1.10813, -0.00605)),
                  dot(c, float3(-0.00327, -0.07276, 1.07602)));
}
#endif

// Tony McMapface (Tomasz Stachowiak): its 48^3 table (Assets/tony_mc_mapface.dds, MIT or Apache-2.0, licenses.json),
// indexed by c / (c + 1) at texel centres.
float3 tonyMcMapface(float3 c)
{
    float3 uv = c / (c + 1.0) * (47.0 / 48.0) + 0.5 / 48.0;
    return SampleLvlTex3D(gTony, gSamplerBilinearClamp, uv, 0.0).rgb;
}

float3 tonemap(float3 c, uint mode)
{
    c = max(c, float3(0.0, 0.0, 0.0));
    if (mode == 0u)
        return pbrNeutral(c);
    if (mode == 1u)
        return agx(c);
    if (mode == 2u)
        return hableCurve(c * 2.0) / hableCurve(float3(11.2, 11.2, 11.2));
    if (mode == 3u)
    {
        float l = dot(c, float3(0.2126, 0.7152, 0.0722));
        float w2 = 16.0;
        float t = (1.0 + l / w2) / (1.0 + l);
        return c * t;
    }
#if TONEMAPPER_ACES_FITTED
    if (mode == 5u)
        return acesFitted(c);
#else
    if (mode == 5u)
        return pbrNeutral(c);
#endif
    if (mode == 6u)
        return tonyMcMapface(c);
    return c;
}

float3 encodeSrgb(float3 c)
{
    c = saturate(c);
    float3 lo = c * 12.92;
    float3 hi = 1.055 * pow(c, float3(1.0 / 2.4, 1.0 / 2.4, 1.0 / 2.4)) - 0.055;
    return float3(c.r <= 0.0031308 ? lo.r : hi.r, c.g <= 0.0031308 ? lo.g : hi.g, c.b <= 0.0031308 ? lo.b : hi.b);
}

ROOT_SIGNATURE(DefaultRootSignature)
float4 PS_MAIN(VSOutput In)
{
    INIT_MAIN;
    int2  p = int2(In.Position.xy);
    float exposure = gComposite.params.w > 0.0 ? gComposite.params.w : gExposure[1];
    uint  mode = gComposite.mode.x;
    float3 c = float3(0.0, 0.0, 0.0);
#if SAMPLE_COUNT > 1
    for (int s = 0; s < SAMPLE_COUNT; ++s)
        c += saturate(tonemap(LoadTex2DMS(gHdr, NO_SAMPLER, p, s).rgb * exposure, mode));
    c *= 1.0 / float(SAMPLE_COUNT);
#else
    c = saturate(tonemap(LoadTex2D(gHdr, NO_SAMPLER, p, 0).rgb * exposure, mode));
    float sharpen = gComposite.params.x;
    if (sharpen > 0.0)
    {
        int2   last = int2(gComposite.mode.w & 0xFFFFu, gComposite.mode.w >> 16) - int2(1, 1);
        float3 l = saturate(tonemap(LoadTex2D(gHdr, NO_SAMPLER, int2(max(p.x - 1, 0), p.y), 0).rgb * exposure, mode));
        float3 r = saturate(tonemap(LoadTex2D(gHdr, NO_SAMPLER, int2(min(p.x + 1, last.x), p.y), 0).rgb * exposure, mode));
        float3 u = saturate(tonemap(LoadTex2D(gHdr, NO_SAMPLER, int2(p.x, max(p.y - 1, 0)), 0).rgb * exposure, mode));
        float3 d = saturate(tonemap(LoadTex2D(gHdr, NO_SAMPLER, int2(p.x, min(p.y + 1, last.y)), 0).rgb * exposure, mode));
        float3 lo = min(c, min(min(l, r), min(u, d)));
        float3 hi = max(c, max(max(l, r), max(u, d)));
        c = clamp(c + (c - (l + r + u + d) * 0.25) * (sharpen * 2.0), lo, hi);
    }
#endif
    // Debug: the light shadow atlas, near casters bright, empty space black.
    float inset = gComposite.params.y;
    if (inset > 0.0)
    {
        float2 q = (In.Position.xy - float2(float(gComposite.mode.w & 0xFFFFu) - inset - 8.0, 8.0)) / inset;
        if (q.x >= 0.0 && q.y >= 0.0 && q.x < 1.0 && q.y < 1.0)
        {
            float d = LoadTex2D(gShadowAtlas, NO_SAMPLER, int2(q * gComposite.params.z), 0).r;
            float v = pow(saturate(1.0 - d), 0.25);
            c = float3(v, v, v);
        }
    }
    // Debug: renderer_vrs's shading rates. Full rate untinted, half rate (1x2, 2x1) green, quarter (2x2)
    // blue, coarser magenta; tile edges darkened.
    if (gComposite.rates.x != 0u)
    {
        uint   tile = max(gComposite.rates.y, 1u);
        uint   r = LoadTex2D(gRates, NO_SAMPLER, int2(uint2(p) / tile), 0).r;
        uint   shift = (r >> 2) + (r & 3u);
        float3 tint = shift == 1u ? float3(0.1, 0.9, 0.2) : (shift == 2u ? float3(0.15, 0.35, 1.0) : float3(1.0, 0.1, 0.9));
        if (shift != 0u)
            c = lerp(c, tint, 0.5);
        uint2 e = uint2(p) % tile;
        if (e.x == 0u || e.y == 0u)
            c *= 0.6;
    }
    // Dither by half a step of 8 bits, so smooth gradients don't band.
    float n = frac(52.9829189 * frac(dot(In.Position.xy, float2(0.06711056, 0.00583715))));
    if (gComposite.params.w > 0.0)
        n = 0.5;
    if (gComposite.mode.y != 0u)
        c = encodeSrgb(c) + (n - 0.5) / 255.0;
    else
        c = c + (n - 0.5) / 255.0 * (c * 2.0 + 0.02);
    RETURN(float4(c, 1.0));
}
