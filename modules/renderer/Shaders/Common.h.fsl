// Layouts shared by the core's shaders; the C++ mirrors are in renderer.cpp and frame.h.
#ifndef RENDER_COMMON_H
#define RENDER_COMMON_H

#define PI 3.14159265

#if defined(VULKAN)
#define FirstBitLow(x) uint(findLSB(x))
#else
#define FirstBitLow(x) firstbitlow(x)
#endif

STRUCT(FrameData)
{
    DATA(float4, viewProj[4], None);  // rows
    DATA(float4, view[4], None);      // rows, world -> view (+z forward)
    DATA(float4, camPos, None);       // xyz, w near
    DATA(float4, screen, None);       // width, height, 1/width, 1/height
    DATA(float4, proj, None);         // x P00, y P11 (projection scale)
    DATA(float4, sunDir[4], None);    // towards the light; w 1 when on
    DATA(float4, sunColor[4], None);  // rgb lux
    DATA(float4, skyZenith, None);    // rgb luminance
    DATA(float4, skyHorizon, None);
    DATA(float4, skyGround, None);    // w ambient multiplier
    DATA(uint4, counts, None);        // x local lights, y directional lights, z flags, w taps
    DATA(uint4, tiles, None);         // x tile size, y tiles x, z words per tile, w bins
    DATA(float4, misc, None);         // x bin scale, y specular AA, z sun disk size (cos), w heatmap scale
    DATA(float4, cascadeEnd, None);   // view depth where each cascade ends
    DATA(float4, shadow, None);       // x cascades, y softness (texels), z sun size (PCSS, 0 off), w normal bias (texels)
    DATA(float4, shadow2, None);      // x 1/sun atlas, y 1/local atlas, z frame (0..63) with TAA else -1,
                                      // w local lights' radius (m) for contact-hardening, 0 off
    DATA(float4, viewProjNoJitter[4], None); // rows, this frame without the TAA jitter
    DATA(float4, prevViewProj[4], None);     // rows, last frame without jitter
    DATA(float4, aoParams, None);            // x specular occlusion, y multi-bounce on, z gAo's scale (2: half size)
    DATA(uint4, probeInfo, None);            // x probes, y mips, z parallax on
    DATA(float4, probeParams, None);         // x intensity, y blend (m)
    DATA(float4, ssr, None);                 // x max roughness, y thickness (m), z max distance (m), w edge fade
    DATA(float4, ssr2, None);                // x intensity, y depth copy scale, z steps, w noise offset this frame
    DATA(float4, rt, None);                  // x max roughness of ray-traced reflections (renderer_rt)
    DATA(float4, atmosphere, None);          // physical sky (FLAG_SKY): km, x ground radius, y top, z the camera from the centre; w aerial strength
    DATA(float4, atmosphere2, None);         // x aerial perspective volume depth (km), y gSkyEnv's mips
    DATA(float4, fog, None);                 // volumetric fog (FLAG_FOG): frame.h fogParams
    DATA(float4, fog2, None);                // xy frame.h fogUv
    DATA(float4, fogMedium, None);           // frame.h's: height fog for reflected rays (x 0: none)
    DATA(float4, fogAlbedo, None);
    DATA(float4, textures, None);            // x texture mip bias (log2 of render over display width; 0 at native)
    DATA(float4, gi[4], None);               // dynamic diffuse GI (FLAG_GI): frame.h giGrid
    DATA(uint4, decals, None);               // x decals in gDecals (FLAG_DECALS)
    DATA(float4, refraction, None);          // x gSceneColor's levels (FLAG_REFRACTION)
    DATA(float4, taps[32], None);            // xy: the shadow filters' Vogel disk of counts.w taps, unturned
};

// A reflection probe (renderer_probes), smallest box first.
STRUCT(ProbeData)
{
    DATA(float4, pos, None);          // xyz capture point, w slice in gProbes
    DATA(float4, boxMin, None);
    DATA(float4, boxMax, None);
};

// flags in counts.z
#define FLAG_CULLED   1u
#define FLAG_HEATMAP  2u
#define FLAG_CASCADES 4u
#define FLAG_SHADOWS  8u
#define FLAG_AO       16u
#define FLAG_AO_DEBUG 32u
#define FLAG_CONTACT  64u
#define FLAG_CONTACT_DEBUG 128u
#define FLAG_UNLIT    256u // F1's Wireframe: each line in its material's own colour
#define FLAG_SSR      512u
#define FLAG_SSR_DEBUG 1024u
#define FLAG_RECEIVER_PLANE 2048u
#define FLAG_RT       4096u
#define FLAG_RT_DEBUG 8192u
#define FLAG_RT_SHADOWS 16384u // renderer_rt traces shadows into gRtShadows: lights with params.w >= 2, and the sun with FLAG_RT_SUN
#define FLAG_RT_SUN   32768u
#define FLAG_SKY      131072u // renderer_sky: the sky, its reflections and ambient from gSkyView, gSkyEnv and gSkySh; gSkyAerial
#define FLAG_FOG      262144u // renderer_fog: gFogVolume
#define FLAG_GI       524288u // renderer_gi: diffuse ambient from its probes (gGiIrradiance, gGiDistance, gGiProbes)
#define FLAG_GI_DEBUG 1048576u
#define FLAG_DECALS   2097152u // decals: gDecals, binned (with FLAG_CULLED) in gDecalMasks and gDecalBins
#define FLAG_REFRACTION 4194304u // the see-through pass: gSceneColor holds the scene behind glass, for gRefraction's materials
#define FLAG_AREA     65536u // gLightShapes is filled: some light has a shape or its own size (area lights take LTC terms)
#define RT_MISS       60000.0

STRUCT(InstanceData)
{
    DATA(float4, row0, None);
    DATA(float4, row1, None);
    DATA(float4, row2, None);
    DATA(uint4, misc, None);          // x material
};

// Last frame's world rows of each instance (for motion vectors), at the same index as gInstances.
STRUCT(PrevInstanceData)
{
    DATA(float4, row0, None);
    DATA(float4, row1, None);
    DATA(float4, row2, None);
};

STRUCT(MaterialData)
{
    DATA(float4, albedoRough, None);  // rgb albedo, a roughness
    DATA(float4, params, None);       // x metallic, y f0 (dielectric), z reflections on
    DATA(float4, emissive, None);     // rgb luminance
};

// A material's texture maps (gMaterialMaps, at its material's index): maps x base colour, y ORM (occlusion, roughness,
// metallic), z normal (BC5 x, y), w emissive, each its slot in gTextures + 1, 0 when it has none or it hasn't loaded yet
// (the material then takes MaterialData's look for that part). The emissive map multiplies MaterialData's emissive.
STRUCT(MaterialMapData)
{
    DATA(uint4, maps, None);
    DATA(float4, baseFactor, None);   // rgb times the base colour map, a times its alpha
    DATA(float4, factors, None);      // x roughness, y metallic (times ORM's g, b), z normal scale, w occlusion strength
    DATA(float4, misc, None);         // x alpha cutoff (0: opaque), y 1 when the maps were given (vertex colours count),
                                      // z blended opacity (material_blend; 0: opaque)
};
#define MAX_TEXTURES 1024

// A decal (renderer.cpp GpuDecal): the box it paints, mapped to -1..1 by its rows.
STRUCT(DecalData)
{
    DATA(float4, row0, None);
    DATA(float4, row1, None);
    DATA(float4, row2, None);
    DATA(float4, axisZ, None);    // world, out of the surface; w the cosine where its angle fade ends
    DATA(float4, axisX, None);    // w 1 / the angle fade's width in cosine
    DATA(float4, axisY, None);    // w normal map scale
    DATA(float4, albedo, None);   // a opacity
    DATA(float4, material, None); // x roughness, y metallic, z edge, w noise
    DATA(float4, emissive, None); // rgb nits, w shape (0 ellipse, 1 rectangle)
    DATA(float4, weights, None);  // colour, roughness, metallic, normal
    DATA(uint4, maps, None);      // base colour, normal, ORM: slot in gTextures + 1, 0 none; w its noise seed
};
#define DECAL_WORDS 8u // RENDER_MAX_DECALS / 32: gDecalMasks' words a tile

STRUCT(LightData)
{
    DATA(float4, pos, None);          // xyz, w range
    DATA(float4, color, None);        // rgb candela, w type
    DATA(float4, dir, None);          // xyz spot direction, w spot scale
    DATA(float4, params, None);       // x spot offset, y first shadow view or -1, z 1/range^2, w 1 casts shadows in the scene
    DATA(float4, sphere, None);       // culling sphere
};

// A light's shape, beside its LightData (frame.h's RenderGpuLightShape): ex.w kind (0 point or spot, 3 rect, 4 disc,
// 5 sphere, 6 tube); rect and disc half-extent vectors ex, ey; tube half-length ex, radius ey.x; ey.w 1 / area for
// area kinds (luminance = color * ey.w), a point or spot light's source radius for shadows otherwise.
STRUCT(LightShape)
{
    DATA(float4, ex, None);
    DATA(float4, ey, None);
};

STRUCT(ShadowView)
{
    DATA(float4, row0, None);
    DATA(float4, row1, None);
    DATA(float4, row2, None);
    DATA(float4, row3, None);
    DATA(float4, rect, None);         // tile: u, v, width, height
    DATA(float4, info, None);         // x texel world size (at distance 1 if perspective), y depth range, z perspective, w near
    DATA(float4, inv0, None);         // columns 0-2 of the inverse of rows 0-3 (receiver-plane bias)
    DATA(float4, inv1, None);
    DATA(float4, inv2, None);
};

// A vertex's octahedral normal or tangent (frame.h's RENDER_ATTRIBUTE_STRIDE), as a unit vector.
float3 octDecode(float2 f)
{
    float3 n = float3(f.x, f.y, 1.0 - abs(f.x) - abs(f.y));
    float  t = saturate(-n.z);
    n.x += n.x >= 0.0 ? -t : t;
    n.y += n.y >= 0.0 ? -t : t;
    return normalize(n);
}

#endif
