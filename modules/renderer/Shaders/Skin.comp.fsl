// One thread a vertex: its morph targets' offsets added by their weights (position and normal), then its position, normal
// and tangent blended by up to 4 bones (linear blend skinning), its uv and
// colour copied, written to its instance's region (this frame's copy; both copies when the region is new, so last
// frame's positions read the same and nothing smears).
#include "Common.h.fsl"
#include "Skin.srt.h"

float2 octEncode(float3 n)
{
    n /= max(abs(n.x) + abs(n.y) + abs(n.z), 1e-20);
    float2 r = n.xy;
    if (n.z < 0.0)
        r = (float2(1.0, 1.0) - abs(n.yx)) * float2(n.x >= 0.0 ? 1.0 : -1.0, n.y >= 0.0 ? 1.0 : -1.0);
    return r;
}
uint packSnorm2(float2 v)
{
    int2 i = int2(round(clamp(v, float2(-1.0, -1.0), float2(1.0, 1.0)) * 32767.0));
    return (uint(i.x) & 0xFFFFu) | ((uint(i.y) & 0xFFFFu) << 16);
}
float2 unpackSnorm2(uint u)
{
    int2 i = int2(int(u << 16) >> 16, int(u) >> 16);
    return max(float2(i) * (1.0 / 32767.0), float2(-1.0, -1.0));
}

ROOT_SIGNATURE(ComputeRootSignature)
NUM_THREADS(64, 1, 1)
void CS_MAIN(SV_GroupID(uint3) group, SV_GroupThreadID(uint3) thread)
{
    INIT_MAIN;
    uint jobs = gJobs[0].x;
    uint j = 0u;
    // Job k's three uint4s are at 3 + 3k (the first three hold the count): the last whose first group is at or before ours.
    for (uint k = 1u; k < jobs; ++k)
        if (gJobs[3u + k * 3u].w <= group.x)
            j = k;
    uint4 a = gJobs[3u + j * 3u]; // source vertex, count, destination, first group
    uint4 b = gJobs[4u + j * 3u]; // second destination (or 0xFFFFFFFF), first skin vertex, palette (float4s)
    uint4 c = gJobs[5u + j * 3u]; // first morph vertex (0xFFFFFFFF none), first delta, weights (float4s), targets
    uint  v = (group.x - a.w) * 64u + thread.x;
    if (v >= a.y)
    {
        RETURN();
    }
    uint   src = a.x + v;
    float4 p = float4(asfloat(gPositions[src * 3u]), asfloat(gPositions[src * 3u + 1u]), asfloat(gPositions[src * 3u + 2u]), 1.0);
    uint   na = gAttributes[src * 5u];
    uint   ta = gAttributes[src * 5u + 1u];
    float3 n = octDecode(unpackSnorm2(na));
    // Morph targets, before the bones (glTF's order): every delta of this vertex, weighted.
    if (c.x != 0xFFFFFFFFu)
    {
        uint ref = gMorphVertices[c.x + v];
        uint first = c.y + (ref & 0xFFFFFFu);
        uint count = ref >> 24;
        for (uint i = 0u; i < count; ++i)
        {
            uint4 d = gMorphDeltas[first + i];
            uint  tg = d.w & 0xFFu;
            if (tg >= c.w)
                continue;
            float4 w4 = gPalette[c.z + (tg >> 2u)];
            uint   lane = tg & 3u;
            float  w = lane == 0u ? w4.x : (lane == 1u ? w4.y : (lane == 2u ? w4.z : w4.w));
            p.xyz += w * asfloat(d.xyz);
            int3 q = int3(int(d.w << 16) >> 24, int(d.w << 8) >> 24, int(d.w) >> 24);
            n += w * (float3(q) * (2.0 / 127.0));
        }
        n = normalize(n + float3(1e-20, 0.0, 0.0));
    }
    uint4  s = gSkin[b.y + v];
    uint   bones[4] = { s.x & 0xFFFFu, s.x >> 16, s.y & 0xFFFFu, s.y >> 16 };
    float  weights[4] = { float(s.z & 0xFFFFu), float(s.z >> 16), float(s.w & 0xFFFFu), float(s.w >> 16) };
    float4 r0 = float4(0.0, 0.0, 0.0, 0.0);
    float4 r1 = r0;
    float4 r2 = r0;
    for (uint k = 0u; k < 4u; ++k)
    {
        float w = weights[k] * (1.0 / 65535.0);
        uint  at = b.z + bones[k] * 3u;
        r0 += w * gPalette[at];
        r1 += w * gPalette[at + 1u];
        r2 += w * gPalette[at + 2u];
    }
    float3 pos = float3(dot(r0, p), dot(r1, p), dot(r2, p));
    // Normals through the cofactor matrix (right under non-uniform scale), tangents through the matrix itself.
    float3 c0 = cross(r1.xyz, r2.xyz);
    float3 c1 = cross(r2.xyz, r0.xyz);
    float3 c2 = cross(r0.xyz, r1.xyz);
    n = normalize(float3(dot(c0, n), dot(c1, n), dot(c2, n)));
    float3 t = octDecode(unpackSnorm2(ta));
    t = float3(dot(r0.xyz, t), dot(r1.xyz, t), dot(r2.xyz, t));
    t = normalize(t - n * dot(n, t) + float3(1e-20, 0.0, 0.0));
    uint tangent = packSnorm2(octEncode(t));
    tangent = (tangent & 0xFFFEFFFFu) | (ta & 0x00010000u); // the bitangent's sign: y's lowest bit, as it was
    uint attr[5] = { packSnorm2(octEncode(n)), tangent, gAttributes[src * 5u + 2u], gAttributes[src * 5u + 3u], gAttributes[src * 5u + 4u] };
    uint dsts[2] = { a.z + v, b.x == 0xFFFFFFFFu ? 0xFFFFFFFFu : b.x + v };
    for (uint d = 0u; d < 2u; ++d)
    {
        if (dsts[d] == 0xFFFFFFFFu)
            continue;
        gPositions[dsts[d] * 3u] = asuint(pos.x);
        gPositions[dsts[d] * 3u + 1u] = asuint(pos.y);
        gPositions[dsts[d] * 3u + 2u] = asuint(pos.z);
        for (uint k = 0u; k < 5u; ++k)
            gAttributes[dsts[d] * 5u + k] = attr[k];
    }
    RETURN();
}
