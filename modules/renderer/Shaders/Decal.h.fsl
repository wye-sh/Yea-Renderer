// Decals (decal_add): their layout, and how one paints a surface. The core's own file; renderer_probes, renderer_gi and
// renderer_rt keep identical copies for what they see of the scene (frame.h worldDecals). Included once for DecalData;
// with DECAL_DATA(k) (decal k's DecalData) and DECAL_SAMPLE(slot, uv, dx, dy) (a map's texel, slot + 1 as DecalData.maps
// hold it) defined, included again for decalPaint; with DECAL_CELLS and DECAL_ITEMS too (frame.h decalCells, decalItems),
// for decalsAt, every decal at a world position through the frame's grid.
#ifndef DECAL_DATA_H
#define DECAL_DATA_H
// A decal (renderer.cpp GpuDecal): the box it paints, mapped to -1..1 by its rows.
STRUCT(DecalData)
{
    DATA(float4, row0, None);
    DATA(float4, row1, None);
    DATA(float4, row2, None);
    DATA(float4, axisZ, None);    // world, out of the surface; w the cosine where its angle fade ends
    DATA(float4, axisX, None);    // w 1 / the angle fade's width in cosine
    DATA(float4, axisY, None);    // w normal map scale
    DATA(float4, albedo, None);   // a opacity
    DATA(float4, material, None); // x roughness, y metallic, z edge, w noise
    DATA(float4, emissive, None); // rgb nits, w shape (0 ellipse, 1 rectangle)
    DATA(float4, weights, None);  // colour, roughness, metallic, normal
    DATA(uint4, maps, None);      // base colour, normal, ORM: slot in the textures + 1, 0 none; w its noise seed
};
#endif

#if defined(DECAL_SAMPLE) && defined(DECAL_DATA) && !defined(DECAL_PAINT_H)
#define DECAL_PAINT_H
// Value noise in 0..1 (a decal's ragged edge and patches), smooth between lattice points.
float decalHash(float2 p, uint seed)
{
    uint2 q = uint2(int2(floor(p)) + int2(4096, 4096));
    uint  h = q.x * 0x8da6b343u ^ q.y * 0xd8163841u ^ seed;
    h ^= h >> 15;
    h *= 0x2c1b3c6du;
    h ^= h >> 12;
    return float(h & 0xFFFFu) * (1.0 / 65535.0);
}

float decalNoise(float2 p, uint seed)
{
    float2 i = floor(p);
    float2 f = p - i;
    float2 u = f * f * (3.0 - 2.0 * f);
    float  a = decalHash(i, seed), b = decalHash(i + float2(1.0, 0.0), seed);
    float  c = decalHash(i + float2(0.0, 1.0), seed), d = decalHash(i + float2(1.0, 1.0), seed);
    return lerp(lerp(a, b, u.x), lerp(c, d, u.x), u.y);
}

// Decal k painted over the surface at P (geometric normal Ng; dPdx, dPdy the footprint's extent across a pixel or a ray
// cone, for the maps' mips): its colour, roughness, metallic, glow and normal blended in by its coverage there times its
// weights.
void decalPaint(uint k, float3 P, float3 Ng, float3 dPdx, float3 dPdy, inout(float3) albedo, inout(float) rough,
                inout(float) metal, inout(float3) emissive, inout(float3) N)
{
    DecalData d = DECAL_DATA(k);
    float4 w = float4(P, 1.0);
    float3 l = float3(dot(d.row0, w), dot(d.row1, w), dot(d.row2, w));
    if (max(abs(l.x), max(abs(l.y), abs(l.z))) >= 1.0)
        return;
    float a = saturate((dot(Ng, d.axisZ.xyz) - d.axisZ.w) * d.axisX.w) * saturate((1.0 - abs(l.z)) * 4.0);
    if (a <= 0.0)
        return;
    float2 uv = float2(l.x * 0.5 + 0.5, 0.5 - l.y * 0.5);
    float2 dx = float2(dot(d.row0.xyz, dPdx), -dot(d.row1.xyz, dPdx)) * 0.5;
    float2 dy = float2(dot(d.row0.xyz, dPdy), -dot(d.row1.xyz, dPdy)) * 0.5;
    float4 base = d.albedo;
    if (d.maps.x != 0u)
    {
        float4 c = DECAL_SAMPLE(d.maps.x, uv, dx, dy);
        base *= c;
    }
    else
    {
        // Its outline: an ellipse or a rectangle, faded over `edge` towards the rim, made ragged and patchy by `noise`.
        float r = d.emissive.w < 0.5 ? length(l.xy) : max(abs(l.x), abs(l.y));
        float n = d.material.w > 0.0 ? decalNoise(l.xy * 3.0, d.maps.w) * 0.6 + decalNoise(l.xy * 9.0, d.maps.w + 1u) * 0.4 : 0.5;
        r += (n - 0.5) * d.material.w * 0.6;
        float edge = max(d.material.z, 1e-3);
        base.a *= saturate((1.0 - r) / edge);
        base.a *= lerp(1.0, smoothstep(0.2, 0.7, decalNoise(l.xy * 4.0 + 17.0, d.maps.w + 2u)), d.material.w * 0.6);
    }
    a *= saturate(base.a);
    if (a <= 0.0)
        return;
    float dr = d.material.x, dm = d.material.y;
    if (d.maps.z != 0u)
    {
        float3 orm = DECAL_SAMPLE(d.maps.z, uv, dx, dy).rgb;
        dr *= orm.g;
        dm *= orm.b;
    }
    albedo = lerp(albedo, base.rgb, a * d.weights.x);
    emissive = lerp(emissive, d.emissive.rgb, a * d.weights.x);
    rough = lerp(rough, dr, a * d.weights.y);
    metal = lerp(metal, dm, a * d.weights.z);
    if (d.weights.w > 0.0)
    {
        // Towards its normal map's normal across the surface (its x and y laid on it), or flat without one.
        float3 Nd = Ng;
        if (d.maps.y != 0u)
        {
            float2 xy = DECAL_SAMPLE(d.maps.y, uv, dx, dy).xy * 2.0 - 1.0;
            float  z = sqrt(saturate(1.0 - dot(xy, xy)));
            xy *= d.axisY.w;
            float3 T = d.axisX.xyz - Ng * dot(Ng, d.axisX.xyz);
            float3 B = d.axisY.xyz - Ng * dot(Ng, d.axisY.xyz);
            Nd = normalize(T * xy.x + B * xy.y + Ng * z);
        }
        N = normalize(lerp(N, Nd, a * d.weights.w));
    }
}

#if defined(DECAL_CELLS) && defined(DECAL_ITEMS)
// Every decal at P through the frame's grid (frame.h decalGrid: grid0 its corner and cells a metre, grid1 its cells), in
// paint order; count 0 or P outside the grid: none.
void decalsAt(uint count, float4 grid0, float4 grid1, float3 P, float3 Ng, float3 dPdx, float3 dPdy, inout(float3) albedo,
              inout(float) rough, inout(float) metal, inout(float3) emissive, inout(float3) N)
{
    if (count == 0u)
        return;
    float3 c = (P - grid0.xyz) * grid0.w;
    if (min(c.x, min(c.y, c.z)) < 0.0 || c.x >= grid1.x || c.y >= grid1.y || c.z >= grid1.z)
        return;
    uint3 q = uint3(c);
    uint3 n = uint3(grid1.xyz);
    uint2 cell = DECAL_CELLS[(q.z * n.y + q.y) * n.x + q.x];
    for (uint i = 0u; i < cell.y; ++i)
        decalPaint(DECAL_ITEMS[cell.x + i], P, Ng, dPdx, dPdy, albedo, rough, metal, emissive, N);
}
#endif
#endif
