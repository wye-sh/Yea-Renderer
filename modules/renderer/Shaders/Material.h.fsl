// A material's look at a pixel from its texture maps (MaterialMapData in gMaterialMaps, the maps in gTextures): include
// after the SRT that declares both. Maps follow glTF: base colour times its factor (and the vertex colour), ORM's
// occlusion, roughness and metallic in r, g, b, a tangent-space normal map in BC5's x and y.
#ifndef RENDER_MATERIAL_H
#define RENDER_MATERIAL_H

STRUCT(MaterialLook)
{
    DATA(float3, albedo, None);
    DATA(float, alpha, None);
    DATA(float, rough, None);
    DATA(float, metallic, None);
    DATA(float, occlusion, None); // 1: open
    DATA(float3, emissive, None);
};

// A map at uv, with gradients already scaled for the render scale's mip bias; slot is gTextures' index + 1.
float4 sampleMap(uint slot, float2 uv, float2 dx, float2 dy)
{
    float4 c = float4(1.0, 1.0, 1.0, 1.0);
    uint   texSlot = slot - 1u;
    BeginNonUniformResourceIndex(texSlot, MAX_TEXTURES);
        c = SampleGradTex2D(gTextures[texSlot], gSamplerAnisotropic, uv, dx, dy);
    EndNonUniformResourceIndex();
    return c;
}

// The base colour's alpha alone (alpha-tested passes).
float materialAlpha(MaterialMapData mm, float2 uv, float2 dx, float2 dy, float vertexAlpha)
{
    float a = mm.baseFactor.a * vertexAlpha;
    if (mm.maps.x != 0u)
        a *= sampleMap(mm.maps.x, uv, dx, dy).a;
    return a;
}

// m's look with mm's maps; a map not loaded yet leaves m's own value for that part.
MaterialLook materialLook(MaterialData m, MaterialMapData mm, float2 uv, float2 dx, float2 dy, float4 vertexColor)
{
    MaterialLook k;
    k.albedo = m.albedoRough.rgb;
    k.alpha = mm.baseFactor.a;
    if (mm.maps.x != 0u)
    {
        float4 c = sampleMap(mm.maps.x, uv, dx, dy);
        k.albedo = mm.baseFactor.rgb * c.rgb;
        k.alpha *= c.a;
    }
    k.albedo *= vertexColor.rgb;
    k.alpha *= vertexColor.a;
    k.rough = m.albedoRough.a;
    k.metallic = m.params.x;
    k.occlusion = 1.0;
    if (mm.maps.y != 0u)
    {
        float3 orm = sampleMap(mm.maps.y, uv, dx, dy).rgb;
        k.rough = mm.factors.x * orm.g;
        k.metallic = mm.factors.y * orm.b;
        k.occlusion = 1.0 + mm.factors.w * (orm.r - 1.0);
    }
    k.emissive = m.emissive.rgb;
    if (mm.maps.w != 0u)
        k.emissive *= sampleMap(mm.maps.w, uv, dx, dy).rgb;
    return k;
}

// The normal map's normal (MikkTSpace: the interpolated normal and tangent as they come, unnormalised, the bitangent
// from them and the tangent's sign), in world space. N, T: the vertex shader's world normal and tangent (w the sign).
float3 mappedNormal(MaterialMapData mm, float3 N, float4 T, float2 uv, float2 dx, float2 dy)
{
    float2 xy = sampleMap(mm.maps.z, uv, dx, dy).xy * 2.0 - 1.0;
    float  z = sqrt(saturate(1.0 - dot(xy, xy)));
    xy *= mm.factors.z;
    float3 B = cross(N, T.xyz) * (T.w < 0.0 ? -1.0 : 1.0);
    float3 n = T.xyz * xy.x + B * xy.y + N * z;
    float  l = dot(n, n);
    return l > 1e-12 ? n * rsqrt(l) : normalize(N);
}

#endif
