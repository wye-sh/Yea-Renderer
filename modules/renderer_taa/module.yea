module renderer_taa

# Called by renderer (the core) each frame with the address of its RenderFrame (frame.h).
export bool taa_prepare(u64 frame)
export void taa_resolve(u64 frame)

category Anti-aliasing
setting bool enabled true
# How much of last frame's image each pixel keeps: higher is smoother and steadier, lower reacts faster.
setting float history_weight 0.9 0.5 0.98
# How far last frame's colour may stray from the pixel's neighbours: lower ghosts less, higher flickers less.
setting float clamp_width 1.25 0.5 3
setting float sharpen 0.25 0 1
player sharpen
setting float jitter 1 0 1
setting int jitter_phases 8 2 16

# Frame versions (6.1.0): the core calls this module only while frame_version() is its own; it refuses a core of
# another version (frame_version 0 from an older core's stub).
export u32 frame_version()
import renderer u32 frame_version() = 0
