// Temporal antialiasing: this frame's jittered image blended into last frame's, which is reprojected
// with the nearest motion vector of the 3x3 neighbourhood, read with a Catmull-Rom filter, and clipped
// to the neighbourhood's colour spread (mean +- width * deviation) in YCoCg. Everything is done on the
// exposed colour compressed by c / (1 + max(c)), so bright pixels don't dominate the blend.
STRUCT(TaaData)
{
    DATA(float4, params, None); // x current frame's weight (1: no history), y clamp width
    DATA(float4, texel, None);  // xy 1 / size
    DATA(uint4, size, None);    // xy size
};

#include "Taa.srt.h"

STRUCT(VSOutput)
{
    DATA(float4, Position, SV_Position);
    DATA(float2, UV, TEXCOORD0);
};

float3 compressColor(float3 c) { return c / (1.0 + max(c.r, max(c.g, c.b))); }
float3 expandColor(float3 c) { return c / max(1.0 - max(c.r, max(c.g, c.b)), 1e-4); }
float3 toYCoCg(float3 c) { return float3(dot(c, float3(0.25, 0.5, 0.25)), dot(c, float3(0.5, 0.0, -0.5)), dot(c, float3(-0.25, 0.5, -0.25))); }
float3 fromYCoCg(float3 c) { return float3(c.x + c.y - c.z, c.x + c.z, c.x - c.y - c.z); }

float3 historyTap(float x, float y) { return SampleLvlTex2D(gHistory, gSamplerBilinearClamp, float2(x, y), 0.0).rgb; }

// Catmull-Rom from 9 bilinear taps: the two middle weights of each axis share one tap.
float3 sampleHistory(float2 uv)
{
    float2 pos = uv * float2(gTaa.size.xy);
    float2 base = floor(pos - 0.5) + 0.5;
    float2 t = pos - base;
    float2 w0 = t * (-0.5 + t * (1.0 - 0.5 * t));
    float2 w1 = 1.0 + t * t * (-2.5 + 1.5 * t);
    float2 w2 = t * (0.5 + t * (2.0 - 1.5 * t));
    float2 w3 = t * t * (-0.5 + 0.5 * t);
    float2 w12 = w1 + w2;
    float2 t0 = (base - 1.0) * gTaa.texel.xy;
    float2 t12 = (base + w2 / w12) * gTaa.texel.xy;
    float2 t3 = (base + 2.0) * gTaa.texel.xy;
    float3 c = historyTap(t0.x, t0.y) * (w0.x * w0.y) + historyTap(t12.x, t0.y) * (w12.x * w0.y) + historyTap(t3.x, t0.y) * (w3.x * w0.y);
    c += historyTap(t0.x, t12.y) * (w0.x * w12.y) + historyTap(t12.x, t12.y) * (w12.x * w12.y) + historyTap(t3.x, t12.y) * (w3.x * w12.y);
    c += historyTap(t0.x, t3.y) * (w0.x * w3.y) + historyTap(t12.x, t3.y) * (w12.x * w3.y) + historyTap(t3.x, t3.y) * (w3.x * w3.y);
    return max(c, float3(0.0, 0.0, 0.0));
}

// Moves h along the line to the box's centre until it is inside the box.
float3 clipToBox(float3 h, float3 lo, float3 hi)
{
    float3 centre = 0.5 * (lo + hi);
    float3 extent = 0.5 * (hi - lo) + float3(1e-5, 1e-5, 1e-5);
    float3 v = h - centre;
    float3 a = abs(v / extent);
    float  m = max(a.x, max(a.y, a.z));
    return m > 1.0 ? centre + v / m : h;
}

ROOT_SIGNATURE(DefaultRootSignature)
float4 PS_MAIN(VSOutput In)
{
    INIT_MAIN;
    int2  p = int2(In.Position.xy);
    int2  last = int2(gTaa.size.xy) - int2(1, 1);
    float exposure = max(gExposure[1], 1e-8);

    float3 m1 = float3(0.0, 0.0, 0.0);
    float3 m2 = float3(0.0, 0.0, 0.0);
    float3 centre = float3(0.0, 0.0, 0.0);
    float  nearest = -1.0;
    int2   nearestP = p;
    for (int dy = -1; dy <= 1; ++dy)
    {
        for (int dx = -1; dx <= 1; ++dx)
        {
            int2   q = clamp(p + int2(dx, dy), int2(0, 0), last);
            float3 c = toYCoCg(compressColor(max(LoadTex2D(gHdr, NO_SAMPLER, q, 0).rgb, float3(0.0, 0.0, 0.0)) * exposure));
            if (dx == 0 && dy == 0)
                centre = c;
            m1 += c;
            m2 += c * c;
            float d = LoadTex2D(gDepth, NO_SAMPLER, q, 0).r; // reversed-Z: larger is nearer
            if (d > nearest)
            {
                nearest = d;
                nearestP = q;
            }
        }
    }

    float2 uv = (float2(p) + 0.5) * gTaa.texel.xy;
    float2 prevUV = uv - LoadTex2D(gMotion, NO_SAMPLER, nearestP, 0).xy;
    float  alpha = gTaa.params.x;
    if (prevUV.x < 0.0 || prevUV.y < 0.0 || prevUV.x > 1.0 || prevUV.y > 1.0)
        alpha = 1.0;
    float3 result = centre;
    if (alpha < 1.0)
    {
        float3 mean = m1 * (1.0 / 9.0);
        float3 sigma = sqrt(max(m2 * (1.0 / 9.0) - mean * mean, float3(0.0, 0.0, 0.0)));
        float3 width = sigma * gTaa.params.y;
        float3 history = toYCoCg(compressColor(sampleHistory(prevUV) * exposure));
        history = clipToBox(history, mean - width, mean + width);
        result = lerp(history, centre, alpha);
    }
    RETURN(float4(max(expandColor(fromYCoCg(result)), float3(0.0, 0.0, 0.0)) / exposure, 1.0));
}
