// renderer_fog's constants (renderer_fog.cpp's FogData) and the core's layouts it reads.
// Froxels: size.x by size.y columns of size.w render pixels, size.z slices; slice s spans view depth edge(s) to
// edge(s + 1), edge(s) = depth.x * (2^(s * depth.y / slices) - 1): from the camera (edge 0 is 0), finer near it.
STRUCT(FogData)
{
    DATA(uint4, size, None);       // x, y, z the froxel grid; w render pixels per froxel column
    DATA(float4, depth, None);     // x the spacing's scale (m), y log2(range / x + 1), z this frame's slice jitter (0..1), w 1 / slices
    DATA(float4, view[3], None);   // rows, world -> view (+z forward)
    DATA(float4, proj, None);      // x p00, y p11, zw this frame's jitter in a column (0..1)
    DATA(float4, camPos, None);    // w the render width (px)
    DATA(float4, prevView[3], None); // last frame's rows
    DATA(float4, prevProj, None);  // last frame's p00, p11, depth.x, 1 / depth.y
    DATA(float4, height, None);    // height fog: x density (1/m) at and below z base height (m), y falloff (1/m); w phase anisotropy g
    DATA(float4, albedo, None);    // rgb scattering albedo, w the render height (px)
    DATA(float4, sunDir, None);    // towards the sun, w 1 when on
    DATA(float4, sunColor, None);  // rgb lux as it arrives, w cascades with maps (0: no sun shadows)
    DATA(float4, ambient, None);   // rgb the sky's mean radiance (gradient sky), w: > 0 the strength of gSkySh's instead
    DATA(float4, cascadeEnd, None);
    DATA(float4, misc, None);      // x the core's light bins per metre of view depth, y history weight (0: none), z sun atlas texel, w local atlas texel
    DATA(uint4, counts, None);     // x lights, y volumes, z flags (1 local lights' shadow maps, 2 gZBins), w bins
};

STRUCT(FogLight)
{
    DATA(float4, pos, None);    // xyz, w range
    DATA(float4, color, None);  // rgb candela, w type (2 spot; area lights 1)
    DATA(float4, dir, None);    // xyz spot direction, w spot scale
    DATA(float4, params, None); // x spot offset, y first shadow view or -1, z 1/range^2
    DATA(float4, sphere, None); // culling sphere
};

STRUCT(FogLightShape)
{
    DATA(float4, ex, None); // w kind: 0 point or spot, 3 rect, 4 disc (one-sided, along dir), 5 sphere, 6 tube
    DATA(float4, ey, None); // w kinds 3 to 6: 1 / area
};

STRUCT(FogShadowView)
{
    DATA(float4, row0, None);
    DATA(float4, row1, None);
    DATA(float4, row2, None);
    DATA(float4, row3, None);
    DATA(float4, rect, None);
    DATA(float4, info, None); // lights: yzw drawn from
    DATA(float4, inv0, None);
    DATA(float4, inv1, None);
    DATA(float4, inv2, None);
};

// A local fog volume: an axis-aligned box or the ellipsoid inside it.
STRUCT(FogVolume)
{
    DATA(float4, center, None); // xyz, w shape (0 box, 1 ellipsoid)
    DATA(float4, extent, None); // xyz half size, w 1 / edge softness (a share of the half size)
    DATA(float4, medium, None); // rgb albedo, w density (1/m)
};
