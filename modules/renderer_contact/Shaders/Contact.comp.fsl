// Screen-space contact shadows for the sun: Bend Studio's screen space shadows (BendSss.h.fsl, Apache-2.0,
// licenses.json). Each 64-thread group is one stretch of a ray from the sun's point on screen; every thread
// reads two depths, shares them in groupshared memory, and each pixel then tests the 60 pixels towards the
// sun from there. Catches the small, thin and distant shadows the cascades are too coarse for.
STRUCT(ContactData)
{
    DATA(float4, light, None);       // the sun's point on screen: xy pixels, z depth, w 1 in front of the camera, -1 behind
    DATA(float4, params, None);      // x surface thickness, y edge threshold, z contrast, w intensity
    DATA(float4, fade, None);        // x near, y max distance (m), z 1 / fade range, w 1 when edge pixels cast nothing
    DATA(float4, size, None);        // xy screen size, z dispatch count, w depth at max distance
    DATA(float4, dispatch[8], None); // xy wave offset (pixels), z wave count y, w groups before this dispatch
};

#include "Contact.srt.h"

#if SAMPLE_COUNT > 1
#define DEPTH_AT(q) LoadTex2DMS(gDepth, NO_SAMPLER, q, 0).r
#else
#define DEPTH_AT(q) LoadTex2D(gDepth, NO_SAMPLER, q, 0).r
#endif

#define WAVE_SIZE 64
#define HARD_SHADOW_SAMPLES 4
#define FADE_OUT_SAMPLES 8
#define BEND_SAMPLE_COUNT 60 // shadow samples per pixel: the shadow's length in pixels
#include "BendSss.h.fsl"

ROOT_SIGNATURE(ComputeRootSignature)
NUM_THREADS(64, 1, 1)
void CS_MAIN(SV_GroupID(uint3) gid, SV_GroupThreadID(uint3) tid)
{
    INIT_MAIN;
    WriteScreenSpaceShadow(int3(gid), int(tid.x));
    RETURN();
}
