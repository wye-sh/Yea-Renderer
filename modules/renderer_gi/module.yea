module renderer_gi

# Where the probes go: a box the game sets (gi_volume), else one fitted round the scene each frame.
state Volume
  float3 center
  float3 size
  u32 set
end

# The box the probes fill (world space, metres); size 0 0 0: fitted round the scene's shadow casters again.
export void gi_volume(float3 center, float3 size)

# Called by renderer (the core) each frame with the address of its RenderFrame (frame.h): gi_prepare before
# rt_prepare (the probes and this frame's rays, or false: no GI), gi_run after rt_run (blending what it traced).
export bool gi_prepare(u64 frame)
export void gi_run(u64 frame)

category Global Illumination
# Light bouncing off everything onto everything else: a sunlit red wall tints the floor beside it, a lamp lights the
# room round its pool, shade under a table is darker than the open sky alone makes it. Ray-traced where the GPU can;
# elsewhere a few probes are captured each frame instead, following changes more slowly.
setting bool gi true
player gi
# Rays each probe casts a frame (Low 64, Medium 128, High 256): smoother, quicker to follow changing light. Without
# ray tracing, probes captured a frame (Low 4, Medium 8, High 16).
setting choice quality Medium Low Medium High
player quality
# How much of last frame each probe keeps (higher: steadier, slower to follow; it follows faster where light changes a lot).
setting float hysteresis 0.97 0 0.995
# Show only the bounced light (diffuse, white surfaces).
setting bool show_gi false
