// The sky and height fog as renderer_gi's raster fallback sees them (gGi, gSkySh), the way renderer_rt lights its
// probe rays' misses: the sky's radiance times the ambient strength, through the height fog over the fog's range.
#ifndef RENDER_GI_LIGHT_H
#define RENDER_GI_LIGHT_H

// The sky's radiance along d: renderer_sky's SH with the cosine convolution taken back out (bands 0..2 over 1, 2/3,
// 1/4), else the gradient sky.
float3 giSkyRadiance(float3 d)
{
    if ((gGi.raster.w & 4u) != 0u)
    {
        float3 c = gSkySh[0].rgb * 0.282095 + (gSkySh[1].rgb * d.y + gSkySh[2].rgb * d.z + gSkySh[3].rgb * d.x) * (0.488603 * 1.5) +
                   ((gSkySh[4].rgb * (d.x * d.y) + gSkySh[5].rgb * (d.y * d.z) + gSkySh[7].rgb * (d.x * d.z)) * 1.092548 +
                    gSkySh[6].rgb * (0.315392 * (3.0 * d.z * d.z - 1.0)) + gSkySh[8].rgb * (0.546274 * (d.x * d.x - d.y * d.y))) * 4.0;
        return max(c, float3(0.0, 0.0, 0.0));
    }
    if (d.y >= 0.0)
        return lerp(gGi.skyHorizon.rgb, gGi.skyZenith.rgb, sqrt(saturate(d.y)));
    return lerp(gGi.skyHorizon.rgb, gGi.skyGround.rgb, saturate(-d.y * 3.0));
}

// Cosine-weighted mean of the sky about N (irradiance / pi), as the core's skyIrradiance.
float3 giSkyIrradiance(float3 N)
{
    if ((gGi.raster.w & 4u) != 0u)
    {
        float3 c = gSkySh[0].rgb * 0.282095 + (gSkySh[1].rgb * N.y + gSkySh[2].rgb * N.z + gSkySh[3].rgb * N.x) * 0.488603 +
                   (gSkySh[4].rgb * (N.x * N.y) + gSkySh[5].rgb * (N.y * N.z) + gSkySh[7].rgb * (N.x * N.z)) * 1.092548 +
                   gSkySh[6].rgb * (0.315392 * (3.0 * N.z * N.z - 1.0)) + gSkySh[8].rgb * (0.546274 * (N.x * N.x - N.y * N.y));
        return max(c, float3(0.0, 0.0, 0.0));
    }
    float3 up = lerp(gGi.skyHorizon.rgb, gGi.skyZenith.rgb, 0.6);
    float3 down = lerp(gGi.skyHorizon.rgb, gGi.skyGround.rgb, 0.85);
    return lerp(down, up, N.y * 0.5 + 0.5);
}

// The core's applyHeightFog (exact optical depth, the sun unshadowed, the sky's mean light scattered in) over length t
// from O along unit d.
float giFogIntegral(float h, float rho, float k)
{
    if (h <= 0.0 || k < 1e-5)
        return rho * h;
    return rho * (1.0 - exp(-k * h)) / k;
}

float3 giHeightFog(float3 color, float3 O, float3 d, float t)
{
    float4 m = gGi.fogMedium;
    if (m.x <= 0.0)
        return color;
    float h0 = O.y - m.z;
    float depth;
    if (abs(d.y) < 1e-4)
        depth = m.x * exp(-m.y * max(h0, 0.0)) * t;
    else
        depth = (giFogIntegral(h0 + d.y * t, m.x, m.y) - giFogIntegral(h0, m.x, m.y)) / d.y;
    float  T = exp(-max(depth, 0.0));
    float3 sky = (gGi.raster.w & 4u) != 0u ? max(gSkySh[0].rgb, float3(0.0, 0.0, 0.0)) * 0.282095
                                           : (gGi.skyHorizon.rgb * 0.5 + gGi.skyZenith.rgb * (2.0 / 3.0) + gGi.skyGround.rgb * (5.0 / 6.0)) * 0.5;
    float3 L = sky * gGi.sunColor.w;
    if (gGi.sunDir.w > 0.0)
    {
        float g = m.w, c = dot(d, gGi.sunDir.xyz);
        float q = max(1.0 + g * g - 2.0 * g * c, 1e-4);
        L += gGi.sunColor.rgb * ((1.0 - g * g) / (4.0 * GI_PI * q * sqrt(q)));
    }
    return color * T + gGi.fogAlbedo.rgb * L * (1.0 - T);
}

#endif
