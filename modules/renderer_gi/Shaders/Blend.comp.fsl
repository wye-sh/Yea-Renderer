// renderer_gi's passes, one per define (after renderer_rt traced this frame's probe rays, frame.h giRayOut):
// INIT: every probe on but not lit yet (state 2) at its grid place, its tiles empty (after a load, a new grid or Reset).
// BLEND_IRRADIANCE, BLEND_DISTANCE: a group per probe, a thread per texel of its tile: the rays' radiance (cosine
//   weighted) or distance (a sharp lobe), blended into what the tile held (hysteresis, less where the light changed a
//   lot), then the border copied from the inside (octahedral wrap) so bilinear reads never leave the tile.
// RASTER_RAYS (no ray tracing): a group per probe captured this frame (Capture.frag.fsl's faces), its rays read from
//   them as renderer_rt would trace them, misses lit by the sky through the height fog. The blends and CLASSIFY then
//   take only those probes (counts.w), every one as traced, and blend inactive ones too (fresh), so a probe woken by
//   classification is ready at once rather than a whole round of captures later.
// CLASSIFY: a thread per probe: moved off nearby surfaces and out of walls (relocation, at most 45% of a cell from its
//   grid place), and switched off when inside geometry or with nothing within its cell (RTXGI's classification).
#include "GiData.h.fsl"
#include "Gi.srt.h"
#include "GiSample.h.fsl"

// Group or thread g's probe: all of them in turn, or, rasterized, the raster.y captured from raster.x on.
uint giProbeOf(uint g) { return gGi.counts.w != 0u ? (gGi.raster.x + g) % gGi.counts.x : g; }

#if defined(INIT)
ROOT_SIGNATURE(ComputeRootSignature)
NUM_THREADS(16, 16, 1)
void CS_MAIN(SV_GroupID(uint3) gid, SV_GroupThreadID(uint3) tid)
{
    INIT_MAIN;
    uint  i = gid.x;
    uint3 n = giCounts(gGi.grid[2]);
    uint  row = n.x * n.z;
    int2  tile = int2(int(i % row), int(i / row));
    float far = gGi.params.y;
    Write2D(gDistOut, tile * int(GI_DIST_TEXELS) + int2(tid.xy), float4(far, far * far, 0.0, 0.0));
    if (tid.x < GI_IRR_TEXELS && tid.y < GI_IRR_TEXELS)
        Write2D(gIrrOut, tile * int(GI_IRR_TEXELS) + int2(tid.xy), float4(0.0, 0.0, 0.0, 0.0));
    if (tid.x == 0u && tid.y == 0u)
        gProbesRW[i] = float4(0.0, 0.0, 0.0, 2.0); // on, not lit yet
    RETURN();
}
#endif

#if defined(BLEND_IRRADIANCE) || defined(BLEND_DISTANCE)
#if defined(BLEND_IRRADIANCE)
#define TEXELS GI_IRR_TEXELS
#define INNER  GI_IRR_INNER
#else
#define TEXELS GI_DIST_TEXELS
#define INNER  GI_DIST_INNER
#endif
GroupShared(float4, gsRay[256]);
GroupShared(float4, gsDir[256]);
GroupShared(float4, gsTile[TEXELS * TEXELS]);

// The inside texel a border texel copies (octahedral wrap: edges mirrored, corners from the opposite corner).
int2 borderSource(int2 t)
{
    const int last = int(INNER) + 1;
    bool xb = t.x == 0 || t.x == last, yb = t.y == 0 || t.y == last;
    if (xb && yb)
        return int2(t.x == 0 ? int(INNER) : 1, t.y == 0 ? int(INNER) : 1);
    if (yb)
        return int2(last - t.x, t.y == 0 ? 1 : int(INNER));
    if (xb)
        return int2(t.x == 0 ? 1 : int(INNER), last - t.y);
    return t;
}

ROOT_SIGNATURE(ComputeRootSignature)
#if defined(BLEND_IRRADIANCE)
NUM_THREADS(8, 8, 1)
#else
NUM_THREADS(16, 16, 1)
#endif
void CS_MAIN(SV_GroupID(uint3) gid, SV_GroupThreadID(uint3) tid, SV_GroupIndex(uint) gi)
{
    INIT_MAIN;
    uint   i = giProbeOf(gid.x);
    float4 data = gProbesRW[i];
    // Only probes traced this frame and active (an inactive one woken this frame starts next frame, as new); rasterized,
    // every one captured.
    if (gGi.counts.z == 0u || (data.w < 0.5 && gGi.counts.w == 0u))
        RETURN();
    uint rays = min(gGi.counts.y, 256u);
    for (uint k = gi; k < rays; k += TEXELS * TEXELS)
    {
        gsRay[k] = gRaysRW[i * gGi.counts.y + k];
        gsDir[k] = float4(giRayDirection(k, gGi.counts.y, gGi.rotation[0], gGi.rotation[1], gGi.rotation[2]), 0.0);
    }
    GroupMemoryBarrier();

    int2 t = int2(tid.xy);
    bool inner = t.x >= 1 && t.y >= 1 && t.x <= int(INNER) && t.y <= int(INNER);
    uint3 n = giCounts(gGi.grid[2]);
    uint  row = n.x * n.z;
    int2  pixel = int2(int(i % row), int(i / row)) * int(TEXELS) + t;
    if (inner)
    {
        float3 dir = giOctDecode((float2(t - 1) + 0.5) / float(INNER) * 2.0 - 1.0);
        float4 sum = float4(0.0, 0.0, 0.0, 0.0);
        float  far = gGi.params.y;
        for (uint k = 0u; k < rays; ++k)
        {
            float4 r = gsRay[k];
            float  c = dot(dir, gsDir[k].xyz);
#if defined(BLEND_IRRADIANCE)
            if (r.w < 0.0 || c <= 0.0)
                continue; // backfaces: the probe sees the inside of something (classification deals with it)
            sum += float4(r.rgb * c, c);
#else
            float w = pow(saturate(c), 50.0);
            if (w <= 0.0)
                continue;
            float d = r.w < 0.0 ? -r.w * 0.2 : min(r.w, far); // a backface counts as near: it walls the probe in
            d = min(d, far);
            sum += float4(d * w, d * d * w, 0.0, w);
#endif
        }
        float  h = giProbeLit(data.w) ? gGi.params.x : 0.0; // nothing worth keeping: this frame alone
#if defined(BLEND_IRRADIANCE)
        float4 old = LoadRWTex2D(gIrrOut, pixel);
        float3 now = sum.w > 0.0 ? sum.rgb / sum.w : float3(0.0, 0.0, 0.0);
        // Where the light changed a lot (a lamp switched, a door opened), less history, so it follows within frames.
        float  big = max(now.r, max(now.g, now.b)), was = max(old.r, max(old.g, old.b));
        float  change = abs(big - was) / max(max(big, was), 1e-4);
        h = change > 0.5 ? h * 0.5 : (change > gGi.params.z ? h * 0.85 : h);
        gsTile[t.y * int(TEXELS) + t.x] = float4(lerp(now, old.rgb, h), 1.0);
#else
        float4 old = LoadRWTex2D(gDistOut, pixel);
        float2 now = sum.w > 0.0 ? sum.xy / sum.w : old.xy;
        gsTile[t.y * int(TEXELS) + t.x] = float4(lerp(now, old.xy, h), 0.0, 0.0);
#endif
    }
    GroupMemoryBarrier();
    int2   src = borderSource(t);
    float4 v = gsTile[src.y * int(TEXELS) + src.x];
#if defined(BLEND_IRRADIANCE)
    Write2D(gIrrOut, pixel, v);
#else
    Write2D(gDistOut, pixel, v);
#endif
    RETURN();
}
#endif

#if defined(CLASSIFY)
ROOT_SIGNATURE(ComputeRootSignature)
NUM_THREADS(64, 1, 1)
void CS_MAIN(SV_DispatchThreadID(uint3) id)
{
    INIT_MAIN;
    if (id.x >= (gGi.counts.w != 0u ? gGi.raster.y : gGi.counts.x) || gGi.counts.z == 0u)
        RETURN();
    uint   i = giProbeOf(id.x);
    float4 data = gProbesRW[i];
    if (gGi.counts.w == 0u && !giProbeTraced(i, data.w, gGi.grid[0]))
        RETURN();
    float3 spacing = gGi.grid[1].xyz;
    uint   rays = gGi.counts.y;
    uint   backfaces = 0u;
    float  closeBack = GI_MISS, closeFront = GI_MISS, farFront = 0.0;
    float3 closeBackDir = float3(0.0, 0.0, 0.0), closeFrontDir = float3(0.0, 0.0, 0.0), farFrontDir = float3(0.0, 0.0, 0.0);
    bool   near = false;
    for (uint k = 0u; k < rays; ++k)
    {
        float  d = gRaysRW[i * rays + k].w;
        float3 dir = giRayDirection(k, rays, gGi.rotation[0], gGi.rotation[1], gGi.rotation[2]);
        if (d < 0.0)
        {
            backfaces += 1u;
            if (-d < closeBack)
                closeBack = -d, closeBackDir = dir;
            continue;
        }
        if (d >= GI_MISS * 0.5)
            continue;
        if (d < closeFront)
            closeFront = d, closeFrontDir = dir;
        if (d > farFront)
            farFront = d, farFrontDir = dir;
        float3 h = abs(dir * d);
        near = near || (h.x <= spacing.x && h.y <= spacing.y && h.z <= spacing.z);
    }
    // Relocation (Majercik 2021, RTXGI): out through the nearest backface when buried, else away from a surface too
    // close (towards the most open way), else drift back home; never past 45% of a cell.
    float  minFront = gGi.params.w;
    float3 off = data.xyz, moved = off;
    bool   buried = float(backfaces) > 0.25 * float(rays);
    if (buried)
        moved = off + closeBackDir * (closeBack + minFront * 0.5);
    else if (closeFront < minFront)
    {
        if (dot(closeFrontDir, farFrontDir) <= 0.0)
            moved = off + farFrontDir * min(farFront * 0.5, minFront - closeFront);
    }
    else if (dot(off, off) > 1e-8)
    {
        float l = length(off);
        moved = off - off / l * min(l, closeFront - minFront);
    }
    float3 limit = spacing * 0.45;
    if (abs(moved.x) <= limit.x && abs(moved.y) <= limit.y && abs(moved.z) <= limit.z)
        off = moved;
    // Classification: off inside geometry or with no surface within its cell (its light reaches no one). One woken while
    // traced was skipped by this frame's blends: not lit until next frame's. Rasterized, it was blended (fresh): lit.
    bool  awake = !buried && near;
    float state = awake ? (data.w < 0.5 && gGi.counts.w == 0u ? 2.0 : 1.0) : 0.0;
    gProbesRW[i] = float4(off, state);
    RETURN();
}
#endif

#if defined(RASTER_RAYS)
#include "GiLight.h.fsl"
ROOT_SIGNATURE(ComputeRootSignature)
NUM_THREADS(64, 1, 1)
void CS_MAIN(SV_GroupID(uint3) gid, SV_GroupThreadID(uint3) tid)
{
    INIT_MAIN;
    uint   slot = gid.x;
    uint   i = giProbeOf(slot);
    uint   rays = gGi.counts.y;
    float3 eye = giProbePosition(i, gProbesRW[i].xyz, gGi.grid[0], gGi.grid[1], gGi.grid[2]);
    for (uint k = tid.x; k < rays; k += 64u)
    {
        float3 d = giRayDirection(k, rays, gGi.rotation[0], gGi.rotation[1], gGi.rotation[2]);
        float3 ad = abs(d);
        uint   face = ad.x >= ad.y && ad.x >= ad.z ? (d.x > 0.0 ? 0u : 1u) : (ad.y >= ad.z ? (d.y > 0.0 ? 2u : 3u) : (d.z > 0.0 ? 4u : 5u));
        float  fw = max(dot(giFaceAxis(face, 0u), d), 1e-4);
        float2 ndc = float2(dot(giFaceAxis(face, 1u), d), dot(giFaceAxis(face, 2u), d)) / fw;
        float2 t = min((float2(ndc.x, -ndc.y) * 0.5 + 0.5) * float(GI_FACE_TEXELS), float(GI_FACE_TEXELS) - 0.01);
        int2   texel = int2(max(t, float2(0.0, 0.0))) + int2(int((slot * 6u + face) * GI_FACE_TEXELS), 0);
        float4 c = LoadTex2D(gFaces, NO_SAMPLER, texel, 0);
        if (c.a == 0.0) // nothing drawn there: the sky
            c = float4(giHeightFog(giSkyRadiance(d) * gGi.sunColor.w, eye, d, gGi.fogAlbedo.w), GI_MISS);
        gRaysRW[i * rays + k] = c;
    }
    RETURN();
}
#endif
