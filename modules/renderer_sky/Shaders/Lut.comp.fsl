// The sky's look-up tables (Hillaire 2020), one pass each:
// TRANSMITTANCE (256 x 64): exp(-optical depth) from a height along a direction to the top of the atmosphere, in
//   Bruneton's parametrisation. Rebuilt only when the atmosphere changes.
// MULTISCATTER (32 x 32): Hillaire's section 5.5: for a sun zenith cosine (x) and altitude (y), the second-order
//   luminance L2 and transfer f_ms gathered over 64 directions with an isotropic phase, summed as the series
//   L2 / (1 - f_ms): every order of scattering past the first. Rebuilt with the transmittance.
// SKYVIEW (192 x 108): the sky's radiance around the camera, azimuth from the sun's (x, finer near it) and zenith
//   angle (y, finer near the horizon), single scattering plus the multiple scattering LUT, and the lit ground where a
//   ray meets it. Every frame.
// AERIAL (32 x 32 x 32): per froxel column, the light scattered in and the transmittance from the camera to each slice
//   (depth^2 spacing over camPos.w km), for the scene's surfaces. Every frame.
// SH: the sky's radiance projected on 9 spherical harmonics, convolved with the cosine lobe and divided by pi: the
//   radiance-like ambient the shading reads (as the gradient's skyIrradiance did). Every frame, one group.
#include "SkyData.h.fsl"
#include "Sky.srt.h"
#include "Atmosphere.h.fsl"

#if defined(SH)
GroupShared(float4, gsSh[64 * 9]);
#endif

float3 transmittanceTo(float r, float mu)
{
    return SampleLvlTex2D(gTransmittance, gSamplerBilinearClamp, transmittanceUv(r, mu), 0.0).rgb;
}

float3 multiScatter(float r, float muSun)
{
    float2 uv = float2(muSun * 0.5 + 0.5, (r - gSky.radii.x) / (gSky.radii.y - gSky.radii.x));
    uv = uv * (31.0 / 32.0) + 0.5 / 32.0;
    return SampleLvlTex2D(gMultiScatter, gSamplerBilinearClamp, uv, 0.0).rgb;
}

// Single and multiple scattering along a ray from height r0 (on the y axis) in direction d, `steps` steps over at most
// tMax km; the sun along s with illuminance 1. Returns the luminance (rgb) and writes the ray's transmittance.
float3 integrate(float r0, float3 d, float3 s, float tMax, uint steps, bool ground, out float3 throughput)
{
    float Rb = gSky.radii.x, Rt = gSky.radii.y;
    float mu = d.y;
    float tTop = raySphere(r0, mu, Rt);
    float tGround = hitsGround(r0, mu) ? raySphere(r0, mu, Rb) : -1.0;
    // The near ground hit: -r mu - sqrt(...).
    if (tGround >= 0.0)
        tGround = -r0 * mu - sqrt(max(r0 * r0 * (mu * mu - 1.0) + Rb * Rb, 0.0));
    float  tEnd = min(tGround >= 0.0 ? tGround : tTop, tMax);
    float  c = dot(d, s);
    float  pr = rayleighPhase(c), pm = miePhase(c);
    float3 L = float3(0.0, 0.0, 0.0);
    throughput = float3(1.0, 1.0, 1.0);
    float  dt = max(tEnd, 0.0) / float(steps);
    float3 o = float3(0.0, r0, 0.0);
    for (uint i = 0u; i < steps; ++i)
    {
        float3 p = o + d * ((float(i) + 0.3) * dt);
        float  h = length(p);
        float3 up = p / h;
        float  muS = dot(up, s);
        Medium m = mediumAt(h - Rb);
        // The sun's light here: its transmittance, none in the planet's shadow.
        float3 sun = hitsGround(h, muS) ? float3(0.0, 0.0, 0.0) : transmittanceTo(h, muS);
        float3 S = sun * (m.rayleigh * pr + float3(m.mie, m.mie, m.mie) * pm) + m.scattering * multiScatter(h, muS);
        // Energy-conserving integration over the step (Hillaire 2015).
        float3 stepT = exp(-m.extinction * dt);
        L += throughput * (S - S * stepT) / max(m.extinction, float3(1e-9, 1e-9, 1e-9));
        throughput *= stepT;
    }
    if (ground && tGround >= 0.0 && tGround <= tMax)
    {
        float3 p = o + d * tGround;
        float3 n = normalize(p);
        float  muS = dot(n, s);
        L += throughput * transmittanceTo(Rb, muS) * (saturate(muS) * gSky.ozone.w / SKY_PI);
    }
    return L;
}

// The sky-view LUT's mapping (Hillaire 2020, appendix): x = sqrt((1 - cos azimuth) / 2), azimuth from the sun's;
// y below 0.5 the sky (quadratic towards the horizon), above it the ground.
float3 skyViewDir(float2 uv, float r, float3 s, out float3 sunLocal)
{
    float Rb = gSky.radii.x;
    float beta = acos(clamp(sqrt(max(r * r - Rb * Rb, 0.0)) / r, -1.0, 1.0));
    float zh = SKY_PI - beta;
    float zenith;
    if (uv.y < 0.5)
    {
        float k = 1.0 - uv.y * 2.0;
        zenith = zh * (1.0 - k * k);
    }
    else
    {
        float k = uv.y * 2.0 - 1.0;
        zenith = zh + beta * k * k;
    }
    float cosAz = 1.0 - 2.0 * uv.x * uv.x;
    float sinAz = sqrt(max(1.0 - cosAz * cosAz, 0.0));
    // The sun in the x-y plane.
    float sy = s.y, sx = sqrt(max(1.0 - sy * sy, 0.0));
    sunLocal = float3(sx, sy, 0.0);
    return float3(sin(zenith) * cosAz, cos(zenith), sin(zenith) * sinAz);
}

ROOT_SIGNATURE(ComputeRootSignature)
NUM_THREADS(8, 8, 1)
void CS_MAIN(SV_DispatchThreadID(uint3) id, SV_GroupIndex(uint) gi)
{
    INIT_MAIN;
#if defined(SH)
    // 64 threads, 32 directions each: a 64 x 32 grid even in z and azimuth, 4 pi / 2048 steradians each.
    float4 acc[9];
    for (uint k = 0u; k < 9u; ++k)
        acc[k] = float4(0.0, 0.0, 0.0, 0.0);
    for (uint j = 0u; j < 32u; ++j)
    {
        uint   n = gi * 32u + j;
        float  z = 1.0 - 2.0 * ((float(n / 64u) + 0.5) / 32.0);
        float  ph = 2.0 * SKY_PI * (float(n % 64u) + 0.5) / 64.0;
        float  sr = sqrt(max(1.0 - z * z, 0.0));
        float3 d = float3(sr * cos(ph), z, sr * sin(ph)); // y up
        float3 c = SampleLvlTex2D(gEnvSource, gSamplerBilinearClamp, octEncode(d), 0.0).rgb;
        float  b[9];
        b[0] = 0.282095;
        b[1] = 0.488603 * d.y;
        b[2] = 0.488603 * d.z;
        b[3] = 0.488603 * d.x;
        b[4] = 1.092548 * d.x * d.y;
        b[5] = 1.092548 * d.y * d.z;
        b[6] = 0.315392 * (3.0 * d.z * d.z - 1.0);
        b[7] = 1.092548 * d.x * d.z;
        b[8] = 0.546274 * (d.x * d.x - d.y * d.y);
        for (uint k = 0u; k < 9u; ++k)
            acc[k].rgb += c * b[k];
    }
    for (uint k = 0u; k < 9u; ++k)
        gsSh[gi * 9u + k] = acc[k];
    GroupMemoryBarrier();
    for (uint stride = 32u; stride > 0u; stride >>= 1u)
    {
        if (gi < stride)
            for (uint k = 0u; k < 9u; ++k)
                gsSh[gi * 9u + k] += gsSh[(gi + stride) * 9u + k];
        GroupMemoryBarrier();
    }
    if (gi < 9u)
    {
        // Cosine convolution (Ramamoorthi and Hanrahan 2001) over pi: band 0 x 1, band 1 x 2/3, band 2 x 1/4.
        float band = gi == 0u ? 1.0 : (gi < 4u ? 2.0 / 3.0 : 0.25);
        gShOut[gi] = gsSh[gi] * (4.0 * SKY_PI / 2048.0) * band;
    }
#else
    uint2 p = id.xy;
    if (p.x >= gSky.size.x || p.y >= gSky.size.y)
        RETURN();
    float2 uv = (float2(p) + 0.5) / float2(gSky.size.xy);
    float  Rb = gSky.radii.x, Rt = gSky.radii.y;
#if defined(TRANSMITTANCE)
    float r, mu;
    transmittanceRMu(uv, r, mu);
    float  t = raySphere(r, mu, Rt);
    float3 od = float3(0.0, 0.0, 0.0);
    float  dt = max(t, 0.0) / 40.0;
    for (uint i = 0u; i < 40u; ++i)
    {
        float s = (float(i) + 0.5) * dt;
        float h = sqrt(r * r + s * s + 2.0 * r * mu * s);
        od += mediumAt(h - Rb).extinction * dt;
    }
    Write2D(gOut, p, float4(exp(-od), 1.0));
#elif defined(MULTISCATTER)
    float  muS = uv.x * 2.0 - 1.0;
    float  r = Rb + clamp(uv.y, 1e-3, 0.999) * (Rt - Rb);
    float3 s = float3(sqrt(max(1.0 - muS * muS, 0.0)), muS, 0.0);
    float3 L2 = float3(0.0, 0.0, 0.0), fms = float3(0.0, 0.0, 0.0);
    for (uint i = 0u; i < 64u; ++i)
    {
        // An even spread of 64 directions (a spherical Fibonacci set).
        float  z = 1.0 - (float(i) + 0.5) / 32.0;
        float  ph = float(i) * 2.39996323;
        float  sr = sqrt(max(1.0 - z * z, 0.0));
        float3 d = float3(sr * cos(ph), z, sr * sin(ph));
        // Second order with an isotropic phase: the same integral with both phases 1 / (4 pi), so use the medium's
        // scattering directly (the multiple-scattering term is 0 while building this table).
        float  tTop = raySphere(r, d.y, Rt);
        float  tGround = hitsGround(r, d.y) ? -r * d.y - sqrt(max(r * r * (d.y * d.y - 1.0) + Rb * Rb, 0.0)) : -1.0;
        float  tEnd = tGround >= 0.0 ? tGround : tTop;
        float3 thr = float3(1.0, 1.0, 1.0);
        float  dt = max(tEnd, 0.0) / 20.0;
        float3 o = float3(0.0, r, 0.0);
        float3 Li = float3(0.0, 0.0, 0.0), f = float3(0.0, 0.0, 0.0);
        for (uint k = 0u; k < 20u; ++k)
        {
            float3 q = o + d * ((float(k) + 0.3) * dt);
            float  h = length(q);
            float  mq = dot(q / h, s);
            Medium m = mediumAt(h - Rb);
            float3 sun = hitsGround(h, mq) ? float3(0.0, 0.0, 0.0) : transmittanceTo(h, mq);
            float3 st = exp(-m.extinction * dt);
            float3 integ = (float3(1.0, 1.0, 1.0) - st) / max(m.extinction, float3(1e-9, 1e-9, 1e-9));
            Li += thr * sun * m.scattering * (1.0 / (4.0 * SKY_PI)) * integ;
            f += thr * m.scattering * integ;
            thr *= st;
        }
        if (tGround >= 0.0)
        {
            float3 q = o + d * tGround;
            float  mq = dot(normalize(q), s);
            Li += thr * transmittanceTo(Rb, mq) * (saturate(mq) * gSky.ozone.w / SKY_PI);
        }
        L2 += Li * (1.0 / 64.0) * 4.0 * SKY_PI * (1.0 / (4.0 * SKY_PI)); // integral over the sphere of Li x isotropic phase
        fms += f * (1.0 / 64.0);
    }
    Write2D(gOut, p, float4(L2 / max(float3(1.0, 1.0, 1.0) - fms, float3(1e-3, 1e-3, 1e-3)), 1.0));
#elif defined(SKYVIEW)
    float  r = gSky.radii.z;
    float3 sunLocal;
    float3 d = skyViewDir(uv, r, gSky.sunDir.xyz, sunLocal);
    float3 thr;
    float3 L = integrate(r, d, sunLocal, 1e9, 30u, true, thr);
    Write2D(gOut, p, float4(L * gSky.sunColor.rgb * gSky.sunDir.w, 1.0));
#elif defined(AERIAL)
    // One thread per froxel column, marching out slice by slice.
    float2 ndc = float2(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0);
    float3 d = normalize(gSky.camRight.xyz * ndc.x + gSky.camUp.xyz * ndc.y + gSky.camForward.xyz);
    float  r = gSky.radii.z;
    float3 o = float3(0.0, r, 0.0);
    float3 s = gSky.sunDir.xyz;
    float  c = dot(d, s);
    float  pr = rayleighPhase(c), pm = miePhase(c);
    float3 L = float3(0.0, 0.0, 0.0), thr = float3(1.0, 1.0, 1.0);
    float  tPrev = 0.0;
    float3 scale = gSky.sunColor.rgb * gSky.sunDir.w;
    for (uint k = 0u; k < 32u; ++k)
    {
        float f = (float(k) + 1.0) / 32.0;
        float t = gSky.camPos.w * f * f;
        // Two steps per slice.
        for (uint j = 0u; j < 2u; ++j)
        {
            float  dt = (t - tPrev) * 0.5;
            float3 q = o + d * (tPrev + dt * (float(j) + 0.5));
            float  h = max(length(q), Rb + 1e-4);
            float  muS = dot(q / h, s);
            Medium m = mediumAt(h - Rb);
            float3 sun = hitsGround(h, muS) ? float3(0.0, 0.0, 0.0) : transmittanceTo(h, muS);
            float3 S = sun * (m.rayleigh * pr + float3(m.mie, m.mie, m.mie) * pm) + m.scattering * multiScatter(h, muS);
            float3 st = exp(-m.extinction * dt);
            L += thr * (S - S * st) / max(m.extinction, float3(1e-9, 1e-9, 1e-9));
            thr *= st;
        }
        tPrev = t;
        Write3D(gOutVolume, int3(p, int(k)), float4(L * scale, dot(thr, float3(1.0, 1.0, 1.0)) / 3.0));
    }
#endif
#endif
    RETURN();
}
