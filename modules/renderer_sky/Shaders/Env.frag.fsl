// The sky's reflection image: an octahedral map (as the probes', y up) of the sky-view LUT, with no sun disk (the sun's
// highlight is its own light's). Mip 0 copies it; each smaller mip is the GGX lobe of its roughness (misc.x, N = V = R),
// importance-sampled straight from the LUT, so no mip blurs a blur.
#include "SkyData.h.fsl"
#include "Env.srt.h"
#include "Atmosphere.h.fsl"

STRUCT(VSOutput)
{
    DATA(float4, Position, SV_Position);
    DATA(float2, UV, TEXCOORD0);
};

float3 skyAt(float3 d)
{
    return SampleLvlTex2D(gSkyView, gSamplerBilinearClamp, skyViewUv(d, gSky.radii.z, gSky.sunDir.xyz), 0.0).rgb;
}

float radicalInverse(uint i)
{
    float r = 0.0;
    float f = 0.5;
    for (uint b = 0u; b < 10u; ++b)
    {
        if ((i & (1u << b)) != 0u)
            r += f;
        f *= 0.5;
    }
    return r;
}

ROOT_SIGNATURE(DefaultRootSignature)
float4 PS_MAIN(VSOutput In)
{
    INIT_MAIN;
    float3 N = octDecode(In.UV);
    float  rough = gSky.misc.x;
    if (rough <= 0.0)
        RETURN(float4(skyAt(N), 1.0));
    float  a = rough * rough;
    uint   n = 48u;
    float3 helper = abs(N.y) < 0.99 ? float3(0.0, 1.0, 0.0) : float3(1.0, 0.0, 0.0);
    float3 T = normalize(cross(helper, N));
    float3 B = cross(N, T);
    float3 sum = float3(0.0, 0.0, 0.0);
    float  total = 0.0;
    for (uint i = 0u; i < n; ++i)
    {
        float  u = (float(i) + 0.5) / float(n);
        float  v = radicalInverse(i);
        float  phi = 2.0 * SKY_PI * u;
        float  cosT = sqrt((1.0 - v) / (1.0 + (a * a - 1.0) * v));
        float  sinT = sqrt(max(1.0 - cosT * cosT, 0.0));
        float3 H = T * (sinT * cos(phi)) + B * (sinT * sin(phi)) + N * cosT;
        float3 L = H * (2.0 * dot(N, H)) - N;
        float  NoL = dot(N, L);
        if (NoL > 0.0)
        {
            sum += skyAt(L) * NoL;
            total += NoL;
        }
    }
    RETURN(float4(sum / max(total, 1e-4), 1.0));
}
