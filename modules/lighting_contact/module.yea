module lighting_contact

# Called by lighting (the core) each frame with the address of its LightingFrame (frame.h).
export bool contact_prepare(u64 frame)
export void contact_run(u64 frame)

category Contact Shadows
setting bool enabled true
# How far (metres) towards the sun each pixel looks for something in the way.
setting float length 0.6 0.05 3
# How thick (metres) things in front are taken to be: lower lets light under thin objects.
setting float thickness 0.25 0.01 2
setting int steps 16 4 64
setting float intensity 1 0 1
# Beyond this distance (metres) there are none; they fade out over the last fifth.
setting float max_distance 60 5 500
setting bool show_contact false
